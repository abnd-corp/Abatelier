# Copier en .env. Les mots de passe ne sont pas ici mais dans secrets/
# (créés par « make secrets »).

# Premier compte admin, créé au démarrage si la base est vide
ADMIN_IDENTIFIANT=admin
ADMIN_NOM=Administrateur

# --- Développement (docker compose up) ---
# Front Vite : http://localhost:5173
WEB_PORT=5173
DB_PORT=5432

# --- Production / staging (compose.prod.yaml) ---
# Domaine qui pointe vers le serveur : Caddy obtient le certificat HTTPS tout seul
DOMAIN=atelier.exemple.fr
HTTP_PORT=80
HTTPS_PORT=443

# --- Avis Google du site ---
# Identifiant de la fiche Google de l'entreprise (la clé d'API va dans secrets/google_places_api_key.txt)
GOOGLE_PLACE_ID=

# --- Pages légales (réglées une fois à l'installation) ---
# Hébergeur du site, affiché dans les mentions légales (nom, adresse, téléphone)
LEGAL_HEBERGEUR=
# Médiateur de la consommation, affiché dans les conditions générales de vente
LEGAL_MEDIATEUR=

# --- E-mails ---
# Sans SMTP_HOST ni MAIL_FROM, rien n'est envoyé. En développement, Mailpit (http://localhost:8025) attrape tout.
# Le mot de passe SMTP va dans secrets/smtp_password.txt, jamais ici.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# true seulement pour le port 465 ; sinon l'envoi est chiffré par STARTTLS
SMTP_SECURE=false
# Expéditeur, par exemple : Alu Pliage Service <contact@exemple.fr>
MAIL_FROM=
# Qui reçoit les alertes (demandes de contact), séparés par des virgules ; par défaut l'e-mail de l'entreprise
MAIL_ALERT_TO=

# --- Sessions ---
SESSION_TTL_DAYS=30
IDLE_TIMEOUT_HOURS=12

# --- API lancée hors Docker (cd api && npm run dev) ---
DB_HOST=localhost
DB_PASSWORD_FILE=../secrets/db_password.txt
