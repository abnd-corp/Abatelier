<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P28_site_vitrine_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P28_site_vitrine_collab">
    <bpmn:participant id="P28_site_vitrine_pool" name="Faire vivre le site vitrine et la boutique" processRef="P28_site_vitrine" />
  </bpmn:collaboration>
  <bpmn:process id="P28_site_vitrine" name="Faire vivre le site vitrine et la boutique" isExecutable="false">
    <bpmn:documentation>Produits de la boutique, photos, textes du site et alertes de la messagerie. Les pages légales ne se modifient pas : elles suivent les versions de l’application.</bpmn:documentation>
    <bpmn:laneSet id="P28_site_vitrine_voies">
      <bpmn:lane id="P28_site_vitrine_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P28_site_vitrine_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P28_site_vitrine_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P28_site_vitrine_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P28_site_vitrine_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P28_site_vitrine_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P28_site_vitrine_f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P28_site_vitrine_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P28_site_vitrine_t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P28_site_vitrine_voie_maintenance" name="Maintenance (nous)">
        <bpmn:flowNodeRef>P28_site_vitrine_t6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P28_site_vitrine_d" name="Un produit, une photo ou un texte change"><bpmn:outgoing>P28_site_vitrine_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P28_site_vitrine_t1" name="Créer le produit, ses déclinaisons, ses prix TTC et sa photo"><bpmn:documentation>Dans l’application : Produits (import de catalogue, copie, prix en lot)</bpmn:documentation><bpmn:incoming>P28_site_vitrine_flux1</bpmn:incoming><bpmn:outgoing>P28_site_vitrine_flux2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P28_site_vitrine_t2" name="Modifier les textes principaux et ranger les photos du site"><bpmn:documentation>Dans l’application : Site vitrine › Textes et Photos (rétablissement du texte d’origine possible)</bpmn:documentation><bpmn:incoming>P28_site_vitrine_flux2</bpmn:incoming><bpmn:outgoing>P28_site_vitrine_flux3</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P28_site_vitrine_t3" name="Publier tout de suite sur le site"><bpmn:documentation>Dans l’application : Sans redéploiement</bpmn:documentation><bpmn:incoming>P28_site_vitrine_flux3</bpmn:incoming><bpmn:outgoing>P28_site_vitrine_flux4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P28_site_vitrine_t4" name="Lire et traiter les demandes de contact reçues"><bpmn:documentation>Dans l’application : Site vitrine › Demandes reçues</bpmn:documentation><bpmn:incoming>P28_site_vitrine_flux4</bpmn:incoming><bpmn:outgoing>P28_site_vitrine_flux5</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P28_site_vitrine_t5" name="Voir les messages envoyés et leur aperçu, s’envoyer un exemple"><bpmn:documentation>Dans l’application : Site vitrine › E-mails</bpmn:documentation><bpmn:incoming>P28_site_vitrine_flux5</bpmn:incoming><bpmn:outgoing>P28_site_vitrine_flux6</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P28_site_vitrine_t6" name="Mettre à jour les pages légales avec les versions de l’application"><bpmn:documentation>Hors application : Mentions légales, confidentialité, cookies, conditions de vente ; hébergeur et médiateur réglés à l’installation</bpmn:documentation><bpmn:incoming>P28_site_vitrine_flux6</bpmn:incoming><bpmn:outgoing>P28_site_vitrine_flux7</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P28_site_vitrine_f" name="Site à jour"><bpmn:incoming>P28_site_vitrine_flux7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P28_site_vitrine_flux1" sourceRef="P28_site_vitrine_d" targetRef="P28_site_vitrine_t1" />
    <bpmn:sequenceFlow id="P28_site_vitrine_flux2" sourceRef="P28_site_vitrine_t1" targetRef="P28_site_vitrine_t2" />
    <bpmn:sequenceFlow id="P28_site_vitrine_flux3" sourceRef="P28_site_vitrine_t2" targetRef="P28_site_vitrine_t3" />
    <bpmn:sequenceFlow id="P28_site_vitrine_flux4" sourceRef="P28_site_vitrine_t3" targetRef="P28_site_vitrine_t4" />
    <bpmn:sequenceFlow id="P28_site_vitrine_flux5" sourceRef="P28_site_vitrine_t4" targetRef="P28_site_vitrine_t5" />
    <bpmn:sequenceFlow id="P28_site_vitrine_flux6" sourceRef="P28_site_vitrine_t5" targetRef="P28_site_vitrine_t6" />
    <bpmn:sequenceFlow id="P28_site_vitrine_flux7" sourceRef="P28_site_vitrine_t6" targetRef="P28_site_vitrine_f" />
    <bpmn:textAnnotation id="P28_site_vitrine_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
