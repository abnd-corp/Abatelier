<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P14_statistiques_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P14_statistiques_collab">
    <bpmn:participant id="P14_statistiques_pool" name="Pilotage et statistiques" processRef="P14_statistiques" />
  </bpmn:collaboration>
  <bpmn:process id="P14_statistiques" name="Pilotage et statistiques" isExecutable="false">
    <bpmn:documentation>Lire l’activité dans la durée : ventes par groupe, visites du site, entrées et sorties d’argent, délais tenus, comparaison de périodes, règles d’alerte. Nécessite de la donnée collectée.</bpmn:documentation>
    <bpmn:laneSet id="P14_statistiques_voies">
      <bpmn:lane id="P14_statistiques_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P14_statistiques_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_statistiques_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_statistiques_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_statistiques_f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P14_statistiques_voie_atelier" name="Atelier">
        <bpmn:flowNodeRef>P14_statistiques_t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P14_statistiques_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P14_statistiques_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_statistiques_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_statistiques_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_statistiques_t7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P14_statistiques_d" name="La direction veut comprendre son activité"><bpmn:outgoing>P14_statistiques_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P14_statistiques_t1" name="Collecter les visites du site (anonymes, sans cookie)"><bpmn:documentation>Pas encore : Rien n’est mesuré aujourd’hui (ticket Statistiques)</bpmn:documentation><bpmn:incoming>P14_statistiques_flux1</bpmn:incoming><bpmn:outgoing>P14_statistiques_flux2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P14_statistiques_t2" name="Saisir le prix d’achat à la réception et les autres dépenses"><bpmn:documentation>Pas encore : Aucun prix d’achat ni dépense dans l’application</bpmn:documentation><bpmn:incoming>P14_statistiques_flux2</bpmn:incoming><bpmn:outgoing>P14_statistiques_flux3</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P14_statistiques_t3" name="Choisir une période et un intervalle (jour, semaine, mois)"><bpmn:documentation>Pas encore : Une seule vue commune à tous les écrans</bpmn:documentation><bpmn:incoming>P14_statistiques_flux3</bpmn:incoming><bpmn:outgoing>P14_statistiques_flux4</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P14_statistiques_t4" name="Calculer les ventes par matière, coloris, modèle ; le chiffre d’affaires, le panier moyen"><bpmn:documentation>Pas encore : Les données de commandes existent déjà</bpmn:documentation><bpmn:incoming>P14_statistiques_flux4</bpmn:incoming><bpmn:outgoing>P14_statistiques_flux5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P14_statistiques_t5" name="Comparer la date estimée et la date réelle de fin : délais tenus"><bpmn:documentation>Pas encore : Les deux dates sont déjà enregistrées</bpmn:documentation><bpmn:incoming>P14_statistiques_flux5</bpmn:incoming><bpmn:outgoing>P14_statistiques_flux6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P14_statistiques_t6" name="Comparer deux périodes (mois, années)"><bpmn:documentation>Pas encore : Superposition de courbes</bpmn:documentation><bpmn:incoming>P14_statistiques_flux6</bpmn:incoming><bpmn:outgoing>P14_statistiques_flux7</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P14_statistiques_t7" name="Signaler un coloris ou une matière sans vente depuis longtemps"><bpmn:documentation>Pas encore : Règles d’alerte réglables ; suggestion de désactiver ou solder</bpmn:documentation><bpmn:incoming>P14_statistiques_flux7</bpmn:incoming><bpmn:outgoing>P14_statistiques_flux8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P14_statistiques_f" name="Décision prise : réapprovisionner, solder, désactiver"><bpmn:incoming>P14_statistiques_flux8</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P14_statistiques_flux1" sourceRef="P14_statistiques_d" targetRef="P14_statistiques_t1" />
    <bpmn:sequenceFlow id="P14_statistiques_flux2" sourceRef="P14_statistiques_t1" targetRef="P14_statistiques_t2" />
    <bpmn:sequenceFlow id="P14_statistiques_flux3" sourceRef="P14_statistiques_t2" targetRef="P14_statistiques_t3" />
    <bpmn:sequenceFlow id="P14_statistiques_flux4" sourceRef="P14_statistiques_t3" targetRef="P14_statistiques_t4" />
    <bpmn:sequenceFlow id="P14_statistiques_flux5" sourceRef="P14_statistiques_t4" targetRef="P14_statistiques_t5" />
    <bpmn:sequenceFlow id="P14_statistiques_flux6" sourceRef="P14_statistiques_t5" targetRef="P14_statistiques_t6" />
    <bpmn:sequenceFlow id="P14_statistiques_flux7" sourceRef="P14_statistiques_t6" targetRef="P14_statistiques_t7" />
    <bpmn:sequenceFlow id="P14_statistiques_flux8" sourceRef="P14_statistiques_t7" targetRef="P14_statistiques_f" />
    <bpmn:textAnnotation id="P14_statistiques_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
