<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P10_fabrication_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P10_fabrication_collab">
    <bpmn:participant id="P10_fabrication_pool" name="Fabrication à l’atelier" processRef="P10_fabrication" />
  </bpmn:collaboration>
  <bpmn:process id="P10_fabrication" name="Fabrication à l’atelier" isExecutable="false">
    <bpmn:documentation>L’atelier voit les commandes en quatre colonnes, en prend une en charge, fabrique, puis la marque prête. Chaque carte montre le client, les pièces et les retards.</bpmn:documentation>
    <bpmn:laneSet id="P10_fabrication_voies">
      <bpmn:lane id="P10_fabrication_voie_atelier" name="Atelier">
        <bpmn:flowNodeRef>P10_fabrication_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_fabrication_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_fabrication_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_fabrication_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_fabrication_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_fabrication_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_fabrication_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_fabrication_t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_fabrication_t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_fabrication_t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_fabrication_f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_fabrication_gj1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P10_fabrication_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P10_fabrication_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_fabrication_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P10_fabrication_t11</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P10_fabrication_voie_client" name="Visiteur / Client">

      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P10_fabrication_d" name="Une commande est validée"><bpmn:outgoing>P10_fabrication_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P10_fabrication_t1" name="Voir les commandes par étape : à lancer, en fabrication, prêtes à retirer, prêtes à livrer"><bpmn:documentation>Dans l’application : Fabrication ; retards signalés par une pastille et un compteur</bpmn:documentation><bpmn:incoming>P10_fabrication_flux1</bpmn:incoming><bpmn:outgoing>P10_fabrication_flux2</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P10_fabrication_g1" name="La prendre en charge ?"><bpmn:incoming>P10_fabrication_flux2</bpmn:incoming><bpmn:outgoing>P10_fabrication_flux3</bpmn:outgoing><bpmn:outgoing>P10_fabrication_flux4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P10_fabrication_t2" name="Prendre la commande en charge, ou annuler / reprendre celle d’un collègue"><bpmn:documentation>Dans l’application : Rien ne lie une commande à un salarié</bpmn:documentation><bpmn:incoming>P10_fabrication_flux3</bpmn:incoming><bpmn:outgoing>P10_fabrication_flux5</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P10_fabrication_t3" name="Imprimer la fiche de fabrication, ou la suivre et la cocher à l’écran (avancement partagé entre les postes) : rendu des pièces, puis feuille par feuille (récupérer, toutes les découpes, tous les pliages, mettre de côté)"><bpmn:documentation>Dans l’application : Fabrication › Imprimer la fiche (PDF) : date de création de la commande, nom du client, jamais l’adresse ni les prix ; pas de QR code</bpmn:documentation><bpmn:incoming>P10_fabrication_flux15</bpmn:incoming><bpmn:outgoing>P10_fabrication_flux6</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P10_fabrication_t4" name="Conseiller la feuille à prendre : chutes d’abord, moins de perte, et dire ce qui reste en chute à garder ou à jeter"><bpmn:documentation>Dans l’application : Fabrication › Feuilles à prendre ; sur la fiche : un morceau dont tous les côtés font au moins 200 mm se garde</bpmn:documentation><bpmn:incoming>P10_fabrication_flux6</bpmn:incoming><bpmn:outgoing>P10_fabrication_flux7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P10_fabrication_t5" name="Lancer la fabrication"><bpmn:documentation>Dans l’application : Bouton « Lancer la fabrication » : prend aussi la commande en charge</bpmn:documentation><bpmn:incoming>P10_fabrication_flux7</bpmn:incoming><bpmn:outgoing>P10_fabrication_flux8</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P10_fabrication_t6" name="Décompter les feuilles utilisées du stock"><bpmn:documentation>Dans l’application : Suivi pas à pas : en fin de feuille, un bouton sort les feuilles du stock ; sans feuille conseillée, le stock se corrige à la main</bpmn:documentation><bpmn:incoming>P10_fabrication_flux8</bpmn:incoming><bpmn:outgoing>P10_fabrication_flux9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:manualTask id="P10_fabrication_t7" name="Découper et plier les pièces"><bpmn:documentation>Hors application : Travail sur machine</bpmn:documentation><bpmn:incoming>P10_fabrication_flux9</bpmn:incoming><bpmn:outgoing>P10_fabrication_flux10</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="P10_fabrication_t8" name="Confirmer les chutes obtenues et les remettre au stock"><bpmn:documentation>Dans l’application : Même bouton en fin de feuille : les chutes à garder (côtés d’au moins 200 mm) entrent au stock en chute</bpmn:documentation><bpmn:incoming>P10_fabrication_flux10</bpmn:incoming><bpmn:outgoing>P10_fabrication_flux11</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="P10_fabrication_t9" name="Contrôler les pièces (cotes, angles)"><bpmn:documentation>Hors application : Aucun contrôle qualité enregistré</bpmn:documentation><bpmn:incoming>P10_fabrication_flux11</bpmn:incoming><bpmn:outgoing>P10_fabrication_flux12</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="P10_fabrication_t10" name="Marquer la commande prête"><bpmn:documentation>Dans l’application : Le client voit « Prête » dans son espace</bpmn:documentation><bpmn:incoming>P10_fabrication_flux12</bpmn:incoming><bpmn:outgoing>P10_fabrication_flux13</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P10_fabrication_t11" name="Prévenir le client par e-mail que sa commande est prête"><bpmn:documentation>Pas encore : Aujourd’hui il le voit seulement dans son espace</bpmn:documentation><bpmn:incoming>P10_fabrication_flux13</bpmn:incoming><bpmn:outgoing>P10_fabrication_flux14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P10_fabrication_f" name="Pièces prêtes : voir « Livraison et retrait »"><bpmn:incoming>P10_fabrication_flux14</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="P10_fabrication_gj1" name=""><bpmn:incoming>P10_fabrication_flux4</bpmn:incoming><bpmn:incoming>P10_fabrication_flux5</bpmn:incoming><bpmn:outgoing>P10_fabrication_flux15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P10_fabrication_flux1" sourceRef="P10_fabrication_d" targetRef="P10_fabrication_t1" />
    <bpmn:sequenceFlow id="P10_fabrication_flux2" sourceRef="P10_fabrication_t1" targetRef="P10_fabrication_g1" />
    <bpmn:sequenceFlow id="P10_fabrication_flux3" name="Oui" sourceRef="P10_fabrication_g1" targetRef="P10_fabrication_t2" />
    <bpmn:sequenceFlow id="P10_fabrication_flux4" name="Directement" sourceRef="P10_fabrication_g1" targetRef="P10_fabrication_gj1" />
    <bpmn:sequenceFlow id="P10_fabrication_flux5" sourceRef="P10_fabrication_t2" targetRef="P10_fabrication_gj1" />
    <bpmn:sequenceFlow id="P10_fabrication_flux6" sourceRef="P10_fabrication_t3" targetRef="P10_fabrication_t4" />
    <bpmn:sequenceFlow id="P10_fabrication_flux7" sourceRef="P10_fabrication_t4" targetRef="P10_fabrication_t5" />
    <bpmn:sequenceFlow id="P10_fabrication_flux8" sourceRef="P10_fabrication_t5" targetRef="P10_fabrication_t6" />
    <bpmn:sequenceFlow id="P10_fabrication_flux9" sourceRef="P10_fabrication_t6" targetRef="P10_fabrication_t7" />
    <bpmn:sequenceFlow id="P10_fabrication_flux10" sourceRef="P10_fabrication_t7" targetRef="P10_fabrication_t8" />
    <bpmn:sequenceFlow id="P10_fabrication_flux11" sourceRef="P10_fabrication_t8" targetRef="P10_fabrication_t9" />
    <bpmn:sequenceFlow id="P10_fabrication_flux12" sourceRef="P10_fabrication_t9" targetRef="P10_fabrication_t10" />
    <bpmn:sequenceFlow id="P10_fabrication_flux13" sourceRef="P10_fabrication_t10" targetRef="P10_fabrication_t11" />
    <bpmn:sequenceFlow id="P10_fabrication_flux14" sourceRef="P10_fabrication_t11" targetRef="P10_fabrication_f" />
    <bpmn:sequenceFlow id="P10_fabrication_flux15" sourceRef="P10_fabrication_gj1" targetRef="P10_fabrication_t3" />
    <bpmn:textAnnotation id="P10_fabrication_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
