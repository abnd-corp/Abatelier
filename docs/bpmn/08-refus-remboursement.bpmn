<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P8_refus_remboursement_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P8_refus_remboursement_collab">
    <bpmn:participant id="P8_refus_remboursement_pool" name="Refus d’une commande payée et remboursement" processRef="P8_refus_remboursement" />
  </bpmn:collaboration>
  <bpmn:process id="P8_refus_remboursement" name="Refus d’une commande payée et remboursement" isExecutable="false">
    <bpmn:documentation>Cas exceptionnel : une commande déjà payée ne peut pas être réalisée. La direction la refuse, le client est remboursé en totalité et prévenu.</bpmn:documentation>
    <bpmn:laneSet id="P8_refus_remboursement_voies">
      <bpmn:lane id="P8_refus_remboursement_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P8_refus_remboursement_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P8_refus_remboursement_t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P8_refus_remboursement_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P8_refus_remboursement_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P8_refus_remboursement_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P8_refus_remboursement_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P8_refus_remboursement_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P8_refus_remboursement_t6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P8_refus_remboursement_voie_paiement" name="Prestataire de paiement">
        <bpmn:flowNodeRef>P8_refus_remboursement_t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P8_refus_remboursement_voie_client" name="Visiteur / Client">
        <bpmn:flowNodeRef>P8_refus_remboursement_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P8_refus_remboursement_f</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P8_refus_remboursement_d" name="Une commande payée ne peut pas être réalisée"><bpmn:outgoing>P8_refus_remboursement_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P8_refus_remboursement_t1" name="Refuser la commande en notant le motif"><bpmn:documentation>Dans l’application : Commande › Refuser et rembourser</bpmn:documentation><bpmn:incoming>P8_refus_remboursement_flux1</bpmn:incoming><bpmn:outgoing>P8_refus_remboursement_flux2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P8_refus_remboursement_t2" name="Demander le remboursement intégral au prestataire"><bpmn:documentation>Dans l’application : Remboursement sur le moyen de paiement utilisé</bpmn:documentation><bpmn:incoming>P8_refus_remboursement_flux2</bpmn:incoming><bpmn:outgoing>P8_refus_remboursement_flux3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P8_refus_remboursement_t3" name="Rembourser la carte du client"><bpmn:documentation>En partie : Vérifié avec le mode test de Stripe</bpmn:documentation><bpmn:incoming>P8_refus_remboursement_flux3</bpmn:incoming><bpmn:outgoing>P8_refus_remboursement_flux4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P8_refus_remboursement_g1" name="Une facture avait-elle été émise ?"><bpmn:incoming>P8_refus_remboursement_flux4</bpmn:incoming><bpmn:outgoing>P8_refus_remboursement_flux5</bpmn:outgoing><bpmn:outgoing>P8_refus_remboursement_flux6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P8_refus_remboursement_t4" name="Émettre l’avoir correspondant"><bpmn:documentation>Dans l’application : Numérotation continue</bpmn:documentation><bpmn:incoming>P8_refus_remboursement_flux5</bpmn:incoming><bpmn:outgoing>P8_refus_remboursement_flux7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P8_refus_remboursement_t5" name="Passer la commande à « annulée » et tenir le journal"><bpmn:documentation>Dans l’application : Qui, quand, pourquoi</bpmn:documentation><bpmn:incoming>P8_refus_remboursement_flux6</bpmn:incoming><bpmn:incoming>P8_refus_remboursement_flux7</bpmn:incoming><bpmn:outgoing>P8_refus_remboursement_flux8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P8_refus_remboursement_t6" name="Prévenir le client avec le motif et le délai d’arrivée des fonds"><bpmn:documentation>Dans l’application : E-mail mis en page</bpmn:documentation><bpmn:incoming>P8_refus_remboursement_flux8</bpmn:incoming><bpmn:outgoing>P8_refus_remboursement_flux9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:manualTask id="P8_refus_remboursement_t7" name="Recevoir le remboursement sur son compte"><bpmn:documentation>Hors application : Quelques jours selon sa banque</bpmn:documentation><bpmn:incoming>P8_refus_remboursement_flux9</bpmn:incoming><bpmn:outgoing>P8_refus_remboursement_flux10</bpmn:outgoing></bpmn:manualTask>
    <bpmn:endEvent id="P8_refus_remboursement_f" name="Client remboursé"><bpmn:incoming>P8_refus_remboursement_flux10</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P8_refus_remboursement_flux1" sourceRef="P8_refus_remboursement_d" targetRef="P8_refus_remboursement_t1" />
    <bpmn:sequenceFlow id="P8_refus_remboursement_flux2" sourceRef="P8_refus_remboursement_t1" targetRef="P8_refus_remboursement_t2" />
    <bpmn:sequenceFlow id="P8_refus_remboursement_flux3" sourceRef="P8_refus_remboursement_t2" targetRef="P8_refus_remboursement_t3" />
    <bpmn:sequenceFlow id="P8_refus_remboursement_flux4" sourceRef="P8_refus_remboursement_t3" targetRef="P8_refus_remboursement_g1" />
    <bpmn:sequenceFlow id="P8_refus_remboursement_flux5" name="Oui" sourceRef="P8_refus_remboursement_g1" targetRef="P8_refus_remboursement_t4" />
    <bpmn:sequenceFlow id="P8_refus_remboursement_flux6" name="Non" sourceRef="P8_refus_remboursement_g1" targetRef="P8_refus_remboursement_t5" />
    <bpmn:sequenceFlow id="P8_refus_remboursement_flux7" sourceRef="P8_refus_remboursement_t4" targetRef="P8_refus_remboursement_t5" />
    <bpmn:sequenceFlow id="P8_refus_remboursement_flux8" sourceRef="P8_refus_remboursement_t5" targetRef="P8_refus_remboursement_t6" />
    <bpmn:sequenceFlow id="P8_refus_remboursement_flux9" sourceRef="P8_refus_remboursement_t6" targetRef="P8_refus_remboursement_t7" />
    <bpmn:sequenceFlow id="P8_refus_remboursement_flux10" sourceRef="P8_refus_remboursement_t7" targetRef="P8_refus_remboursement_f" />
    <bpmn:textAnnotation id="P8_refus_remboursement_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
