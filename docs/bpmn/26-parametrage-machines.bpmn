      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P26_parametrage_machines_voie_systeme_di" bpmnElement="P26_parametrage_machines_voie_systeme" isHorizontal="true">
        <dc:Bounds x="70" y="160" width="1220" height="120" />
      </bpmndi:BPMNShape>
