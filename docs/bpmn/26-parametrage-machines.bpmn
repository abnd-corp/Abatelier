      <bpmndi:BPMNShape id="P26_parametrage_machines_t3_di" bpmnElement="P26_parametrage_machines_t3" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="710" y="180" width="150" height="80" />
