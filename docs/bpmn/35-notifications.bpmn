<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P35_notifications_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P35_notifications_collab">
    <bpmn:participant id="P35_notifications_pool" name="Notifications de la direction" processRef="P35_notifications" />
  </bpmn:collaboration>
  <bpmn:process id="P35_notifications" name="Notifications de la direction" isExecutable="false">
    <bpmn:documentation>Tout ce qui concerne la direction arrive dans la plateforme, en un seul endroit, pour chaque compte qui en a le droit. Un clic ouvre la page où traiter la demande. Si trop de notifications restent non lues, un e-mail d’alerte part.</bpmn:documentation>
    <bpmn:laneSet id="P35_notifications_voies">
      <bpmn:lane id="P35_notifications_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P35_notifications_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P35_notifications_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P35_notifications_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P35_notifications_t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P35_notifications_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P35_notifications_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P35_notifications_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P35_notifications_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P35_notifications_f</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P35_notifications_d" name="Un événement concerne la direction (commande, contact, devis, stock…)"><bpmn:outgoing>P35_notifications_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P35_notifications_t1" name="Créer la notification pour chaque compte de la direction qui en a le droit"><bpmn:documentation>En partie : Aujourd’hui des e-mails aux adresses réglées pour l’équipe</bpmn:documentation><bpmn:incoming>P35_notifications_flux1</bpmn:incoming><bpmn:outgoing>P35_notifications_flux2</bpmn:outgoing><bpmn:outgoing>P35_notifications_flux3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P35_notifications_t6" name="Envoyer un e-mail d’alerte à la direction si trop de notifications restent non lues"><bpmn:documentation>Pas encore : Seuil réglable ; seul cas où la direction reçoit un e-mail</bpmn:documentation><bpmn:incoming>P35_notifications_flux3</bpmn:incoming><bpmn:outgoing>P35_notifications_flux4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P35_notifications_t2" name="Voir le nombre de notifications non lues dans le menu"><bpmn:documentation>Pas encore : Pastille sur une cloche, dans le menu de gauche</bpmn:documentation><bpmn:incoming>P35_notifications_flux2</bpmn:incoming><bpmn:incoming>P35_notifications_flux4</bpmn:incoming><bpmn:outgoing>P35_notifications_flux5</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P35_notifications_t3" name="Ouvrir la notification : arriver directement sur la page à traiter"><bpmn:documentation>Pas encore : Commande, demande de contact, devis, stock : la page exacte, pas la liste</bpmn:documentation><bpmn:incoming>P35_notifications_flux5</bpmn:incoming><bpmn:outgoing>P35_notifications_flux6</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P35_notifications_t4" name="Traiter la demande dans l’application"><bpmn:documentation>Dans l’application : Les pages existent déjà (commandes, demandes reçues, stock)</bpmn:documentation><bpmn:incoming>P35_notifications_flux6</bpmn:incoming><bpmn:outgoing>P35_notifications_flux7</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P35_notifications_t5" name="Marquer la notification comme lue, puis traitée"><bpmn:documentation>Pas encore : Lue pour tous les comptes ou pour chacun : à définir avec le client</bpmn:documentation><bpmn:incoming>P35_notifications_flux7</bpmn:incoming><bpmn:outgoing>P35_notifications_flux8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P35_notifications_f" name="Direction informée, rien d’oublié"><bpmn:incoming>P35_notifications_flux8</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P35_notifications_flux1" sourceRef="P35_notifications_d" targetRef="P35_notifications_t1" />
    <bpmn:sequenceFlow id="P35_notifications_flux2" sourceRef="P35_notifications_t1" targetRef="P35_notifications_t2" />
    <bpmn:sequenceFlow id="P35_notifications_flux3" name="Trop de non lues" sourceRef="P35_notifications_t1" targetRef="P35_notifications_t6" />
    <bpmn:sequenceFlow id="P35_notifications_flux4" sourceRef="P35_notifications_t6" targetRef="P35_notifications_t2" />
    <bpmn:sequenceFlow id="P35_notifications_flux5" sourceRef="P35_notifications_t2" targetRef="P35_notifications_t3" />
    <bpmn:sequenceFlow id="P35_notifications_flux6" sourceRef="P35_notifications_t3" targetRef="P35_notifications_t4" />
    <bpmn:sequenceFlow id="P35_notifications_flux7" sourceRef="P35_notifications_t4" targetRef="P35_notifications_t5" />
    <bpmn:sequenceFlow id="P35_notifications_flux8" sourceRef="P35_notifications_t5" targetRef="P35_notifications_f" />
    <bpmn:textAnnotation id="P35_notifications_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
