  <bpmn:collaboration id="P3_devis_en_ligne_collab">
    <bpmn:participant id="P3_devis_en_ligne_pool" name="Devis en ligne avec le configurateur" processRef="P3_devis_en_ligne" />
  </bpmn:collaboration>
  <bpmn:process id="P3_devis_en_ligne" name="Devis en ligne avec le configurateur" isExecutable="false">
    <bpmn:documentation>Le client dessine sa pièce, voit le prix, reçoit un devis numéroté et l’accepte ou le refuse.</bpmn:documentation>
    <bpmn:laneSet id="P3_devis_en_ligne_voies">
      <bpmn:lane id="P3_devis_en_ligne_voie_client" name="Visiteur / Client">
        <bpmn:flowNodeRef>P3_devis_en_ligne_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_devis_en_ligne_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_devis_en_ligne_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_devis_en_ligne_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_devis_en_ligne_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_devis_en_ligne_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_devis_en_ligne_t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_devis_en_ligne_f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P3_devis_en_ligne_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P3_devis_en_ligne_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_devis_en_ligne_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_devis_en_ligne_t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P3_devis_en_ligne_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P3_devis_en_ligne_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_devis_en_ligne_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P3_devis_en_ligne_d" name="Le client veut un prix pour une pièce"><bpmn:outgoing>P3_devis_en_ligne_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P3_devis_en_ligne_t1" name="Choisir ou dessiner la pièce, la matière, le coloris, la longueur"><bpmn:documentation>Dans l’application : Site public › Configurateur (prix en direct, vue 3D)</bpmn:documentation><bpmn:incoming>P3_devis_en_ligne_flux1</bpmn:incoming><bpmn:outgoing>P3_devis_en_ligne_flux2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P3_devis_en_ligne_t2" name="Vérifier les limites de pliage et calculer le prix"><bpmn:documentation>Dans l’application : Limites de la plieuse paramétrables</bpmn:documentation><bpmn:incoming>P3_devis_en_ligne_flux2</bpmn:incoming><bpmn:outgoing>P3_devis_en_ligne_flux3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P3_devis_en_ligne_g1" name="A-t-il un espace client ?"><bpmn:incoming>P3_devis_en_ligne_flux3</bpmn:incoming><bpmn:outgoing>P3_devis_en_ligne_flux4</bpmn:outgoing><bpmn:outgoing>P3_devis_en_ligne_flux5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P3_devis_en_ligne_t3" name="Créer son espace (la pièce est conservée)"><bpmn:documentation>Dans l’application : Voir « Espace client »</bpmn:documentation><bpmn:incoming>P3_devis_en_ligne_flux4</bpmn:incoming><bpmn:outgoing>P3_devis_en_ligne_flux6</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P3_devis_en_ligne_t4" name="Créer la commande et éditer le devis PDF numéroté"><bpmn:documentation>Dans l’application : Numérotation continue D-AAAA-NNNN</bpmn:documentation><bpmn:incoming>P3_devis_en_ligne_flux5</bpmn:incoming><bpmn:incoming>P3_devis_en_ligne_flux6</bpmn:incoming><bpmn:outgoing>P3_devis_en_ligne_flux7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P3_devis_en_ligne_t5" name="Prévenir la direction par e-mail"><bpmn:documentation>Dans l’application</bpmn:documentation><bpmn:incoming>P3_devis_en_ligne_flux7</bpmn:incoming><bpmn:outgoing>P3_devis_en_ligne_flux8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P3_devis_en_ligne_g2" name="Accepte le devis ?"><bpmn:incoming>P3_devis_en_ligne_flux8</bpmn:incoming><bpmn:outgoing>P3_devis_en_ligne_flux9</bpmn:outgoing><bpmn:outgoing>P3_devis_en_ligne_flux10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P3_devis_en_ligne_t6" name="Accepter le devis dans son espace"><bpmn:documentation>Dans l’application : Espace client › commande › Accepter le devis</bpmn:documentation><bpmn:incoming>P3_devis_en_ligne_flux9</bpmn:incoming><bpmn:outgoing>P3_devis_en_ligne_flux11</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P3_devis_en_ligne_t7" name="Valider la commande"><bpmn:documentation>Dans l’application : Commandes › Valider la commande</bpmn:documentation><bpmn:incoming>P3_devis_en_ligne_flux11</bpmn:incoming><bpmn:outgoing>P3_devis_en_ligne_flux12</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P3_devis_en_ligne_t8" name="Refuser le devis"><bpmn:documentation>Dans l’application : La commande reste, la direction le voit</bpmn:documentation><bpmn:incoming>P3_devis_en_ligne_flux10</bpmn:incoming><bpmn:outgoing>P3_devis_en_ligne_flux13</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P3_devis_en_ligne_f1" name="Commande validée : voir « Fabrication »"><bpmn:incoming>P3_devis_en_ligne_flux12</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P3_devis_en_ligne_f2" name="Devis refusé"><bpmn:incoming>P3_devis_en_ligne_flux13</bpmn:incoming></bpmn:endEvent>
