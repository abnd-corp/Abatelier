    <bpmn:sequenceFlow id="P32_mise_en_service_flux9" sourceRef="P32_mise_en_service_t8" targetRef="P32_mise_en_service_t9" />
    <bpmn:sequenceFlow id="P32_mise_en_service_flux10" sourceRef="P32_mise_en_service_t9" targetRef="P32_mise_en_service_t10" />
    <bpmn:sequenceFlow id="P32_mise_en_service_flux11" sourceRef="P32_mise_en_service_t10" targetRef="P32_mise_en_service_t11" />
    <bpmn:sequenceFlow id="P32_mise_en_service_flux12" sourceRef="P32_mise_en_service_t11" targetRef="P32_mise_en_service_f" />
    <bpmn:textAnnotation id="P32_mise_en_service_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
