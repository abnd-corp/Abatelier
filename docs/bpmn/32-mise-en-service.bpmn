<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P32_mise_en_service_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P32_mise_en_service_collab">
    <bpmn:participant id="P32_mise_en_service_pool" name="Mise en service chez un client" processRef="P32_mise_en_service" />
  </bpmn:collaboration>
  <bpmn:process id="P32_mise_en_service" name="Mise en service chez un client" isExecutable="false">
    <bpmn:documentation>Ce que nous installons et ce que le client renseigne avant de s’en servir : entreprise, numérotation, tarifs, équipe, références, stock de départ, site.</bpmn:documentation>
    <bpmn:laneSet id="P32_mise_en_service_voies">
      <bpmn:lane id="P32_mise_en_service_voie_maintenance" name="Maintenance (nous)">
        <bpmn:flowNodeRef>P32_mise_en_service_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P32_mise_en_service_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P32_mise_en_service_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P32_mise_en_service_t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P32_mise_en_service_t11</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P32_mise_en_service_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P32_mise_en_service_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P32_mise_en_service_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P32_mise_en_service_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P32_mise_en_service_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P32_mise_en_service_t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P32_mise_en_service_t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P32_mise_en_service_f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P32_mise_en_service_voie_atelier" name="Atelier">
        <bpmn:flowNodeRef>P32_mise_en_service_t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P32_mise_en_service_voie_systeme" name="Application (automatique)">

      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P32_mise_en_service_d" name="Un client choisit l’application"><bpmn:outgoing>P32_mise_en_service_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:manualTask id="P32_mise_en_service_t1" name="Installer l’application, créer le compte administrateur, régler les secrets (e-mail, paiement)"><bpmn:documentation>En partie : Docker prêt ; domaine HTTPS et serveur chez le client à finaliser</bpmn:documentation><bpmn:incoming>P32_mise_en_service_flux1</bpmn:incoming><bpmn:outgoing>P32_mise_en_service_flux2</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="P32_mise_en_service_t2" name="Renseigner l’hébergeur et le médiateur des pages légales"><bpmn:documentation>Dans l’application : Deux réglages d’installation</bpmn:documentation><bpmn:incoming>P32_mise_en_service_flux2</bpmn:incoming><bpmn:outgoing>P32_mise_en_service_flux3</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="P32_mise_en_service_t3" name="Saisir l’entreprise, le logo, le modèle des documents, la numérotation de départ"><bpmn:documentation>Dans l’application : Le dernier numéro de facture de l’ancien outil se saisit avant le premier document</bpmn:documentation><bpmn:incoming>P32_mise_en_service_flux3</bpmn:incoming><bpmn:outgoing>P32_mise_en_service_flux4</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P32_mise_en_service_t4" name="Saisir les tarifs, matières, coloris, modèles de pièces, accessoires, livraison"><bpmn:documentation>Dans l’application : Tarifs et catalogue</bpmn:documentation><bpmn:incoming>P32_mise_en_service_flux4</bpmn:incoming><bpmn:outgoing>P32_mise_en_service_flux5</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P32_mise_en_service_t5" name="Créer les salariés et leurs comptes"><bpmn:documentation>Dans l’application : Équipe › Salariés, Administration › Comptes</bpmn:documentation><bpmn:incoming>P32_mise_en_service_flux5</bpmn:incoming><bpmn:outgoing>P32_mise_en_service_flux6</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P32_mise_en_service_t6" name="Définir les références de feuilles et leurs codes-barres"><bpmn:documentation>Dans l’application : Direction › Matériaux</bpmn:documentation><bpmn:incoming>P32_mise_en_service_flux6</bpmn:incoming><bpmn:outgoing>P32_mise_en_service_flux7</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P32_mise_en_service_t7" name="Compter les feuilles présentes (stock de départ)"><bpmn:documentation>Dans l’application : Stock de feuilles › Compter</bpmn:documentation><bpmn:incoming>P32_mise_en_service_flux7</bpmn:incoming><bpmn:outgoing>P32_mise_en_service_flux8</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P32_mise_en_service_t8" name="Remplir le site : produits, textes, photos"><bpmn:documentation>Dans l’application : Produits, Site vitrine</bpmn:documentation><bpmn:incoming>P32_mise_en_service_flux8</bpmn:incoming><bpmn:outgoing>P32_mise_en_service_flux9</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P32_mise_en_service_t9" name="Importer les clients et l’historique de l’ancien outil"><bpmn:documentation>Pas encore : Facultatif ; dépend de la forme des données existantes</bpmn:documentation><bpmn:incoming>P32_mise_en_service_flux9</bpmn:incoming><bpmn:outgoing>P32_mise_en_service_flux10</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="P32_mise_en_service_t10" name="Brancher le prestataire de paiement du client et faire un paiement de test"><bpmn:documentation>En partie : Stripe essayé en test ; le choix du prestataire se fait avec le client</bpmn:documentation><bpmn:incoming>P32_mise_en_service_flux10</bpmn:incoming><bpmn:outgoing>P32_mise_en_service_flux11</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="P32_mise_en_service_t11" name="Former les utilisateurs"><bpmn:documentation>Hors application : Se fait sur place avec les écrans réels</bpmn:documentation><bpmn:incoming>P32_mise_en_service_flux11</bpmn:incoming><bpmn:outgoing>P32_mise_en_service_flux12</bpmn:outgoing></bpmn:manualTask>
    <bpmn:endEvent id="P32_mise_en_service_f" name="Application prête à servir"><bpmn:incoming>P32_mise_en_service_flux12</bpmn:incoming></bpmn:endEvent>
