<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P23_stats_comparateur_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P23_stats_comparateur_collab">
    <bpmn:participant id="P23_stats_comparateur_pool" name="Statistiques : comparer des périodes" processRef="P23_stats_comparateur" />
  </bpmn:collaboration>
  <bpmn:process id="P23_stats_comparateur" name="Statistiques : comparer des périodes" isExecutable="false">
    <bpmn:documentation>La direction superpose deux périodes ou plus, pour le même chiffre (mois contre mois, année contre année).</bpmn:documentation>
    <bpmn:laneSet id="P23_stats_comparateur_voies">
      <bpmn:lane id="P23_stats_comparateur_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P23_stats_comparateur_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P23_stats_comparateur_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P23_stats_comparateur_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P23_stats_comparateur_f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P23_stats_comparateur_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P23_stats_comparateur_t2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P23_stats_comparateur_d" name="La direction veut comparer deux périodes"><bpmn:outgoing>P23_stats_comparateur_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P23_stats_comparateur_t1" name="Choisir deux périodes ou plus et le chiffre à comparer"><bpmn:documentation>Pas encore : Mêmes chiffres que les autres statistiques</bpmn:documentation><bpmn:incoming>P23_stats_comparateur_flux1</bpmn:incoming><bpmn:outgoing>P23_stats_comparateur_flux2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P23_stats_comparateur_t2" name="Superposer les courbes"><bpmn:documentation>Pas encore : Courbes lisibles sur téléphone, thème clair et sombre</bpmn:documentation><bpmn:incoming>P23_stats_comparateur_flux2</bpmn:incoming><bpmn:outgoing>P23_stats_comparateur_flux3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P23_stats_comparateur_t3" name="Lire l’écart"><bpmn:documentation>Pas encore : Accès réservé à la direction (permission stats.read) ; lisible sur téléphone</bpmn:documentation><bpmn:incoming>P23_stats_comparateur_flux3</bpmn:incoming><bpmn:outgoing>P23_stats_comparateur_flux4</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P23_stats_comparateur_f" name="Décision prise"><bpmn:incoming>P23_stats_comparateur_flux4</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P23_stats_comparateur_flux1" sourceRef="P23_stats_comparateur_d" targetRef="P23_stats_comparateur_t1" />
    <bpmn:sequenceFlow id="P23_stats_comparateur_flux2" sourceRef="P23_stats_comparateur_t1" targetRef="P23_stats_comparateur_t2" />
    <bpmn:sequenceFlow id="P23_stats_comparateur_flux3" sourceRef="P23_stats_comparateur_t2" targetRef="P23_stats_comparateur_t3" />
    <bpmn:sequenceFlow id="P23_stats_comparateur_flux4" sourceRef="P23_stats_comparateur_t3" targetRef="P23_stats_comparateur_f" />
    <bpmn:textAnnotation id="P23_stats_comparateur_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P23_stats_comparateur_diagram">
