      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P23_stats_comparateur_t1_di" bpmnElement="P23_stats_comparateur_t1" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="330" y="60" width="150" height="80" />
