      <bpmndi:BPMNShape id="P23_stats_comparateur_t2_di" bpmnElement="P23_stats_comparateur_t2" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="520" y="180" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P23_stats_comparateur_t3_di" bpmnElement="P23_stats_comparateur_t3" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="710" y="60" width="150" height="80" />
