      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P23_stats_comparateur_flux2_di" bpmnElement="P23_stats_comparateur_flux2">
        <di:waypoint x="480" y="100" />
        <di:waypoint x="495" y="100" />
        <di:waypoint x="495" y="220" />
        <di:waypoint x="520" y="220" />
      </bpmndi:BPMNEdge>
