<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P3_connexion_google_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P3_connexion_google_collab">
    <bpmn:participant id="P3_connexion_google_pool" name="Connexion à l’espace client avec Google" processRef="P3_connexion_google" />
  </bpmn:collaboration>
  <bpmn:process id="P3_connexion_google" name="Connexion à l’espace client avec Google" isExecutable="false">
    <bpmn:documentation>Le client entre dans son espace en un clic avec son compte Google : l’application le reconnaît par son adresse e-mail vérifiée par Google, sans doublon, ou crée son espace après le choix particulier ou professionnel. Le mot de passe reste possible.</bpmn:documentation>
    <bpmn:laneSet id="P3_connexion_google_voies">
      <bpmn:lane id="P3_connexion_google_voie_client" name="Visiteur / Client">
        <bpmn:flowNodeRef>P3_connexion_google_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_connexion_google_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_connexion_google_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_connexion_google_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_connexion_google_t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_connexion_google_f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P3_connexion_google_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P3_connexion_google_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_connexion_google_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_connexion_google_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_connexion_google_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_connexion_google_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P3_connexion_google_t8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P3_connexion_google_d" name="Le client veut entrer dans son espace sans mot de passe"><bpmn:outgoing>P3_connexion_google_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P3_connexion_google_t1" name="Cliquer sur « Continuer avec Google »"><bpmn:documentation>Dans l’application : Pages Connexion et Créer mon espace ; bouton affiché seulement si Google est configuré</bpmn:documentation><bpmn:incoming>P3_connexion_google_flux1</bpmn:incoming><bpmn:outgoing>P3_connexion_google_flux2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P3_connexion_google_t2" name="Envoyer le client chez Google (état, nonce et clé PKCE gardés dans un cookie signé de 10 minutes)"><bpmn:documentation>Dans l’application : Aucun script de Google sur le site : une simple redirection</bpmn:documentation><bpmn:incoming>P3_connexion_google_flux2</bpmn:incoming><bpmn:outgoing>P3_connexion_google_flux3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P3_connexion_google_t3" name="Choisir son compte Google et accepter"><bpmn:documentation>Hors application : Écran de Google</bpmn:documentation><bpmn:incoming>P3_connexion_google_flux3</bpmn:incoming><bpmn:outgoing>P3_connexion_google_flux4</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P3_connexion_google_t4" name="Échanger le code avec Google et contrôler le jeton (émetteur, destinataire, durée, nonce, e-mail vérifié)"><bpmn:documentation>Dans l’application : Au moindre doute : retour à la connexion avec un message clair, noté au journal. Validé avec le vrai Google le 30 octobre 2026</bpmn:documentation><bpmn:incoming>P3_connexion_google_flux4</bpmn:incoming><bpmn:outgoing>P3_connexion_google_flux5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P3_connexion_google_g1" name="Compte Google déjà lié, ou adresse déjà connue ?"><bpmn:incoming>P3_connexion_google_flux5</bpmn:incoming><bpmn:outgoing>P3_connexion_google_flux6</bpmn:outgoing><bpmn:outgoing>P3_connexion_google_flux7</bpmn:outgoing><bpmn:outgoing>P3_connexion_google_flux8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P3_connexion_google_t5" name="Ouvrir la session de l’espace existant"><bpmn:documentation>Dans l’application : Rattachement automatique de Google à l’espace qui a la même adresse, sans doublon ; noté au journal</bpmn:documentation><bpmn:incoming>P3_connexion_google_flux6</bpmn:incoming><bpmn:outgoing>P3_connexion_google_flux10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P3_connexion_google_t6" name="Ouvrir l’espace d’une fiche créée par l’atelier"><bpmn:documentation>Dans l’application : Google prouve que l’adresse est la sienne : pas besoin du lien d’activation</bpmn:documentation><bpmn:incoming>P3_connexion_google_flux7</bpmn:incoming><bpmn:outgoing>P3_connexion_google_flux11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P3_connexion_google_t7" name="Indiquer particulier ou professionnel (raison sociale) et accepter l’utilisation de ses données"><bpmn:documentation>Dans l’application : Une étape après Google, mêmes règles que l’inscription</bpmn:documentation><bpmn:incoming>P3_connexion_google_flux8</bpmn:incoming><bpmn:outgoing>P3_connexion_google_flux9</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P3_connexion_google_t8" name="Créer la fiche client et l’espace sans mot de passe, envoyer le message de bienvenue"><bpmn:documentation>Dans l’application : Nom, prénom et e-mail repris de Google ; mot de passe possible plus tard avec « Mot de passe oublié »</bpmn:documentation><bpmn:incoming>P3_connexion_google_flux9</bpmn:incoming><bpmn:outgoing>P3_connexion_google_flux12</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P3_connexion_google_t9" name="Retrouver ses devis, commandes et factures"><bpmn:documentation>Dans l’application : Espace client ; fermeture de l’espace confirmée par l’adresse e-mail faute de mot de passe</bpmn:documentation><bpmn:incoming>P3_connexion_google_flux10</bpmn:incoming><bpmn:incoming>P3_connexion_google_flux11</bpmn:incoming><bpmn:incoming>P3_connexion_google_flux12</bpmn:incoming><bpmn:outgoing>P3_connexion_google_flux13</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P3_connexion_google_f" name="Client connecté"><bpmn:incoming>P3_connexion_google_flux13</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P3_connexion_google_flux1" sourceRef="P3_connexion_google_d" targetRef="P3_connexion_google_t1" />
    <bpmn:sequenceFlow id="P3_connexion_google_flux2" sourceRef="P3_connexion_google_t1" targetRef="P3_connexion_google_t2" />
    <bpmn:sequenceFlow id="P3_connexion_google_flux3" sourceRef="P3_connexion_google_t2" targetRef="P3_connexion_google_t3" />
    <bpmn:sequenceFlow id="P3_connexion_google_flux4" sourceRef="P3_connexion_google_t3" targetRef="P3_connexion_google_t4" />
    <bpmn:sequenceFlow id="P3_connexion_google_flux5" sourceRef="P3_connexion_google_t4" targetRef="P3_connexion_google_g1" />
    <bpmn:sequenceFlow id="P3_connexion_google_flux6" name="Oui, avec un espace" sourceRef="P3_connexion_google_g1" targetRef="P3_connexion_google_t5" />
    <bpmn:sequenceFlow id="P3_connexion_google_flux7" name="Oui, fiche sans espace" sourceRef="P3_connexion_google_g1" targetRef="P3_connexion_google_t6" />
    <bpmn:sequenceFlow id="P3_connexion_google_flux8" name="Non, première visite" sourceRef="P3_connexion_google_g1" targetRef="P3_connexion_google_t7" />
    <bpmn:sequenceFlow id="P3_connexion_google_flux9" sourceRef="P3_connexion_google_t7" targetRef="P3_connexion_google_t8" />
    <bpmn:sequenceFlow id="P3_connexion_google_flux10" sourceRef="P3_connexion_google_t5" targetRef="P3_connexion_google_t9" />
    <bpmn:sequenceFlow id="P3_connexion_google_flux11" sourceRef="P3_connexion_google_t6" targetRef="P3_connexion_google_t9" />
    <bpmn:sequenceFlow id="P3_connexion_google_flux12" sourceRef="P3_connexion_google_t8" targetRef="P3_connexion_google_t9" />
    <bpmn:sequenceFlow id="P3_connexion_google_flux13" sourceRef="P3_connexion_google_t9" targetRef="P3_connexion_google_f" />
    <bpmn:textAnnotation id="P3_connexion_google_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
