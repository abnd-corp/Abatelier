<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P1_contact_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P1_contact_collab">
    <bpmn:participant id="P1_contact_pool" name="Demande de contact" processRef="P1_contact" />
  </bpmn:collaboration>
  <bpmn:process id="P1_contact" name="Demande de contact" isExecutable="false">
    <bpmn:documentation>Dernier recours : le visiteur ne passe par la direction que si le configurateur, le devis et la commande en ligne ne suffisent pas (pièce hors limites, question, cas particulier). Le reste se fait seul.</bpmn:documentation>
    <bpmn:laneSet id="P1_contact_voies">
      <bpmn:lane id="P1_contact_voie_client" name="Visiteur / Client">
        <bpmn:flowNodeRef>P1_contact_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_contact_g0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_contact_t0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_contact_f0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_contact_t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P1_contact_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P1_contact_t0b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_contact_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_contact_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_contact_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_contact_t8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P1_contact_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P1_contact_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_contact_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_contact_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P1_contact_f</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P1_contact_d" name="Besoin d’un renseignement ou d’un devis"><bpmn:outgoing>P1_contact_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P1_contact_t0b" name="Proposer d’abord les services en ligne et les réponses aux questions fréquentes"><bpmn:documentation>Pas encore : En tête de la page Contact : liens vers configurateur, devis, commande ; délais, matières, livraison</bpmn:documentation><bpmn:incoming>P1_contact_flux1</bpmn:incoming><bpmn:outgoing>P1_contact_flux2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P1_contact_g0" name="Peut-il se débrouiller seul ? (sinon : hors limites, question, cas particulier)"><bpmn:incoming>P1_contact_flux2</bpmn:incoming><bpmn:outgoing>P1_contact_flux3</bpmn:outgoing><bpmn:outgoing>P1_contact_flux4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P1_contact_t0" name="Utiliser le configurateur, le devis ou la commande en ligne"><bpmn:documentation>Dans l’application : Voir « Configurateur », « Devis » et « Commande payée en ligne »</bpmn:documentation><bpmn:incoming>P1_contact_flux3</bpmn:incoming><bpmn:outgoing>P1_contact_flux5</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P1_contact_f0" name="Aucune demande : la direction n’intervient pas"><bpmn:incoming>P1_contact_flux5</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="P1_contact_t1" name="Remplir le formulaire de contact (plan joint possible)"><bpmn:documentation>Dans l’application : Site public › Contact (consentement RGPD demandé)</bpmn:documentation><bpmn:incoming>P1_contact_flux4</bpmn:incoming><bpmn:outgoing>P1_contact_flux6</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P1_contact_t2" name="Enregistrer la demande et notifier la direction dans la plateforme"><bpmn:documentation>En partie : Notification avec le plan, la pièce choisie dans le configurateur et un lien. Aujourd’hui par e-mail ; passe dans les notifications de la plateforme</bpmn:documentation><bpmn:incoming>P1_contact_flux6</bpmn:incoming><bpmn:outgoing>P1_contact_flux7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P1_contact_t3" name="Envoyer un accusé de réception au visiteur, avec les liens utiles"><bpmn:documentation>Pas encore : Aujourd’hui seule l’équipe est prévenue</bpmn:documentation><bpmn:incoming>P1_contact_flux7</bpmn:incoming><bpmn:outgoing>P1_contact_flux8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P1_contact_t5" name="Retrouver ou créer la fiche client depuis la demande"><bpmn:documentation>Dans l’application : Bouton « Fiche client » sur la demande : retrouvée par l’adresse e-mail, sinon créée, sans doublon</bpmn:documentation><bpmn:incoming>P1_contact_flux8</bpmn:incoming><bpmn:outgoing>P1_contact_flux9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P1_contact_t4" name="Lire la demande et télécharger le plan"><bpmn:documentation>Dans l’application : Site vitrine › Demandes reçues</bpmn:documentation><bpmn:incoming>P1_contact_flux9</bpmn:incoming><bpmn:outgoing>P1_contact_flux10</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="P1_contact_t6" name="Répondre au client (téléphone ou e-mail)"><bpmn:documentation>Hors application : La réponse part de la messagerie habituelle</bpmn:documentation><bpmn:incoming>P1_contact_flux10</bpmn:incoming><bpmn:outgoing>P1_contact_flux11</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="P1_contact_t7" name="Marquer la demande comme traitée"><bpmn:documentation>Dans l’application : Site vitrine › Demandes reçues</bpmn:documentation><bpmn:incoming>P1_contact_flux11</bpmn:incoming><bpmn:outgoing>P1_contact_flux12</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P1_contact_t8" name="Supprimer la demande au bout de 12 mois"><bpmn:documentation>Dans l’application : Purge automatique chaque heure des demandes de plus de 12 mois sans commande, notée au journal ; suppression à la demande de la personne aussi</bpmn:documentation><bpmn:incoming>P1_contact_flux12</bpmn:incoming><bpmn:outgoing>P1_contact_flux13</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P1_contact_f" name="Demande clôturée"><bpmn:incoming>P1_contact_flux13</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P1_contact_flux1" sourceRef="P1_contact_d" targetRef="P1_contact_t0b" />
    <bpmn:sequenceFlow id="P1_contact_flux2" sourceRef="P1_contact_t0b" targetRef="P1_contact_g0" />
    <bpmn:sequenceFlow id="P1_contact_flux3" name="Oui" sourceRef="P1_contact_g0" targetRef="P1_contact_t0" />
    <bpmn:sequenceFlow id="P1_contact_flux4" name="Non" sourceRef="P1_contact_g0" targetRef="P1_contact_t1" />
    <bpmn:sequenceFlow id="P1_contact_flux5" sourceRef="P1_contact_t0" targetRef="P1_contact_f0" />
    <bpmn:sequenceFlow id="P1_contact_flux6" sourceRef="P1_contact_t1" targetRef="P1_contact_t2" />
    <bpmn:sequenceFlow id="P1_contact_flux7" sourceRef="P1_contact_t2" targetRef="P1_contact_t3" />
    <bpmn:sequenceFlow id="P1_contact_flux8" sourceRef="P1_contact_t3" targetRef="P1_contact_t5" />
    <bpmn:sequenceFlow id="P1_contact_flux9" sourceRef="P1_contact_t5" targetRef="P1_contact_t4" />
    <bpmn:sequenceFlow id="P1_contact_flux10" sourceRef="P1_contact_t4" targetRef="P1_contact_t6" />
    <bpmn:sequenceFlow id="P1_contact_flux11" sourceRef="P1_contact_t6" targetRef="P1_contact_t7" />
    <bpmn:sequenceFlow id="P1_contact_flux12" sourceRef="P1_contact_t7" targetRef="P1_contact_t8" />
    <bpmn:sequenceFlow id="P1_contact_flux13" sourceRef="P1_contact_t8" targetRef="P1_contact_f" />
    <bpmn:textAnnotation id="P1_contact_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
