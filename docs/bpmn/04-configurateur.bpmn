<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P4_configurateur_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P4_configurateur_collab">
    <bpmn:participant id="P4_configurateur_pool" name="Configurateur : faisabilité contrôlée, prix et date estimée" processRef="P4_configurateur" />
  </bpmn:collaboration>
  <bpmn:process id="P4_configurateur" name="Configurateur : faisabilité contrôlée, prix et date estimée" isExecutable="false">
    <bpmn:documentation>Le client dessine sa pièce. L’application vérifie tout, l’aide à corriger, calcule le prix et une date estimée ; au-delà de ses limites, il passe par une demande de contact.</bpmn:documentation>
    <bpmn:laneSet id="P4_configurateur_voies">
      <bpmn:lane id="P4_configurateur_voie_client" name="Visiteur / Client">
        <bpmn:flowNodeRef>P4_configurateur_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_configurateur_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_configurateur_f1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_configurateur_t6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P4_configurateur_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P4_configurateur_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_configurateur_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_configurateur_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_configurateur_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_configurateur_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_configurateur_t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P4_configurateur_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P4_configurateur_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P4_configurateur_f2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P4_configurateur_d" name="Le client veut un prix pour une pièce"><bpmn:outgoing>P4_configurateur_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P4_configurateur_t1" name="Choisir ou dessiner la pièce, la matière, le coloris, la longueur, la quantité"><bpmn:documentation>Dans l’application : Site public › Configurateur (prix en direct, vue 3D)</bpmn:documentation><bpmn:incoming>P4_configurateur_flux1</bpmn:incoming><bpmn:incoming>P4_configurateur_flux6</bpmn:incoming><bpmn:outgoing>P4_configurateur_flux2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P4_configurateur_t2" name="Vérifier les limites : plis, angles, cote minimale, développé, longueur"><bpmn:documentation>Dans l’application : Limites paramétrables dans « Façonnage et conditions »</bpmn:documentation><bpmn:incoming>P4_configurateur_flux2</bpmn:incoming><bpmn:outgoing>P4_configurateur_flux3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P4_configurateur_g1" name="La pièce est-elle faisable ?"><bpmn:incoming>P4_configurateur_flux3</bpmn:incoming><bpmn:outgoing>P4_configurateur_flux4</bpmn:outgoing><bpmn:outgoing>P4_configurateur_flux5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P4_configurateur_t3" name="Dire quelle limite est dépassée, sur le champ concerné"><bpmn:documentation>Dans l’application : Message précis ; la proposition de correction chiffrée reste à faire</bpmn:documentation><bpmn:incoming>P4_configurateur_flux5</bpmn:incoming><bpmn:outgoing>P4_configurateur_flux6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P4_configurateur_t4" name="Vérifier la quantité et la charge de l’atelier"><bpmn:documentation>Pas encore : Plafond de quantité et capacité par jour : en attente des données de l’atelier</bpmn:documentation><bpmn:incoming>P4_configurateur_flux4</bpmn:incoming><bpmn:outgoing>P4_configurateur_flux7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P4_configurateur_g2" name="Dans la capacité de l’atelier ?"><bpmn:incoming>P4_configurateur_flux7</bpmn:incoming><bpmn:outgoing>P4_configurateur_flux8</bpmn:outgoing><bpmn:outgoing>P4_configurateur_flux9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P4_configurateur_t5" name="Calculer le prix, la livraison et la date estimée"><bpmn:documentation>En partie : Date = jour + délai standard ; pas encore selon la quantité, le stock ni la charge</bpmn:documentation><bpmn:incoming>P4_configurateur_flux8</bpmn:incoming><bpmn:outgoing>P4_configurateur_flux10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P4_configurateur_f1" name="Suite : « Commande payée en ligne » ou « Devis depuis l’espace client »"><bpmn:incoming>P4_configurateur_flux10</bpmn:incoming></bpmn:endEvent>
    <bpmn:userTask id="P4_configurateur_t6" name="Envoyer une demande de contact avec sa pièce"><bpmn:documentation>Dans l’application : La pièce choisie est jointe à la demande (voir « Demande de contact »)</bpmn:documentation><bpmn:incoming>P4_configurateur_flux9</bpmn:incoming><bpmn:outgoing>P4_configurateur_flux11</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P4_configurateur_t7" name="Traiter la demande hors limites"><bpmn:documentation>Dans l’application : Site vitrine › Demandes reçues</bpmn:documentation><bpmn:incoming>P4_configurateur_flux11</bpmn:incoming><bpmn:outgoing>P4_configurateur_flux12</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P4_configurateur_f2" name="Demande prise en charge"><bpmn:incoming>P4_configurateur_flux12</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P4_configurateur_flux1" sourceRef="P4_configurateur_d" targetRef="P4_configurateur_t1" />
    <bpmn:sequenceFlow id="P4_configurateur_flux2" sourceRef="P4_configurateur_t1" targetRef="P4_configurateur_t2" />
    <bpmn:sequenceFlow id="P4_configurateur_flux3" sourceRef="P4_configurateur_t2" targetRef="P4_configurateur_g1" />
    <bpmn:sequenceFlow id="P4_configurateur_flux4" name="Oui" sourceRef="P4_configurateur_g1" targetRef="P4_configurateur_t4" />
    <bpmn:sequenceFlow id="P4_configurateur_flux5" name="Non" sourceRef="P4_configurateur_g1" targetRef="P4_configurateur_t3" />
    <bpmn:sequenceFlow id="P4_configurateur_flux6" sourceRef="P4_configurateur_t3" targetRef="P4_configurateur_t1" />
    <bpmn:sequenceFlow id="P4_configurateur_flux7" sourceRef="P4_configurateur_t4" targetRef="P4_configurateur_g2" />
    <bpmn:sequenceFlow id="P4_configurateur_flux8" name="Oui" sourceRef="P4_configurateur_g2" targetRef="P4_configurateur_t5" />
    <bpmn:sequenceFlow id="P4_configurateur_flux9" name="Non" sourceRef="P4_configurateur_g2" targetRef="P4_configurateur_t6" />
    <bpmn:sequenceFlow id="P4_configurateur_flux10" sourceRef="P4_configurateur_t5" targetRef="P4_configurateur_f1" />
    <bpmn:sequenceFlow id="P4_configurateur_flux11" sourceRef="P4_configurateur_t6" targetRef="P4_configurateur_t7" />
    <bpmn:sequenceFlow id="P4_configurateur_flux12" sourceRef="P4_configurateur_t7" targetRef="P4_configurateur_f2" />
    <bpmn:textAnnotation id="P4_configurateur_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P4_configurateur_diagram">
    <bpmndi:BPMNPlane id="P4_configurateur_plane" bpmnElement="P4_configurateur_collab">
