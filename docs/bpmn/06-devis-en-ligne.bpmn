<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P6_devis_en_ligne_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P6_devis_en_ligne_collab">
    <bpmn:participant id="P6_devis_en_ligne_pool" name="Devis depuis l’espace client" processRef="P6_devis_en_ligne" />
  </bpmn:collaboration>
  <bpmn:process id="P6_devis_en_ligne" name="Devis depuis l’espace client" isExecutable="false">
    <bpmn:documentation>Le client enregistre son devis numéroté, l’accepte ou le refuse en ligne. L’acceptation valide la commande toute seule ; la direction est seulement prévenue, dans les deux cas.</bpmn:documentation>
    <bpmn:laneSet id="P6_devis_en_ligne_voies">
      <bpmn:lane id="P6_devis_en_ligne_voie_client" name="Visiteur / Client">
        <bpmn:flowNodeRef>P6_devis_en_ligne_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_devis_en_ligne_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_devis_en_ligne_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_devis_en_ligne_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_devis_en_ligne_t6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P6_devis_en_ligne_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P6_devis_en_ligne_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_devis_en_ligne_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_devis_en_ligne_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_devis_en_ligne_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_devis_en_ligne_t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_devis_en_ligne_t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P6_devis_en_ligne_f1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P6_devis_en_ligne_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P6_devis_en_ligne_f2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P6_devis_en_ligne_d" name="Le client veut un devis avant de commander"><bpmn:outgoing>P6_devis_en_ligne_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P6_devis_en_ligne_t1" name="Enregistrer son devis depuis le configurateur (compte nécessaire)"><bpmn:documentation>Dans l’application : Voir « Espace client » ; la pièce est conservée</bpmn:documentation><bpmn:incoming>P6_devis_en_ligne_flux1</bpmn:incoming><bpmn:outgoing>P6_devis_en_ligne_flux2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P6_devis_en_ligne_t2" name="Créer la commande et éditer le devis PDF numéroté"><bpmn:documentation>Dans l’application : Numérotation continue D-AAAA-NNNN</bpmn:documentation><bpmn:incoming>P6_devis_en_ligne_flux2</bpmn:incoming><bpmn:outgoing>P6_devis_en_ligne_flux3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P6_devis_en_ligne_t3" name="Notifier la direction dans la plateforme : devis demandé"><bpmn:documentation>En partie : Aujourd’hui par e-mail ; passe dans les notifications de la plateforme</bpmn:documentation><bpmn:incoming>P6_devis_en_ligne_flux3</bpmn:incoming><bpmn:outgoing>P6_devis_en_ligne_flux4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P6_devis_en_ligne_g1" name="Accepte le devis ?"><bpmn:incoming>P6_devis_en_ligne_flux4</bpmn:incoming><bpmn:outgoing>P6_devis_en_ligne_flux5</bpmn:outgoing><bpmn:outgoing>P6_devis_en_ligne_flux6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P6_devis_en_ligne_t4" name="Accepter le devis dans son espace"><bpmn:documentation>Dans l’application : Espace client › commande › Accepter le devis</bpmn:documentation><bpmn:incoming>P6_devis_en_ligne_flux5</bpmn:incoming><bpmn:outgoing>P6_devis_en_ligne_flux7</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P6_devis_en_ligne_t5" name="Valider la commande tout de suite, sans passer par la direction"><bpmn:documentation>Pas encore : Aujourd’hui la direction valide à la main (un clic depuis le devis) ; devis encore valable et prix inchangés</bpmn:documentation><bpmn:incoming>P6_devis_en_ligne_flux7</bpmn:incoming><bpmn:outgoing>P6_devis_en_ligne_flux8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P6_devis_en_ligne_t7" name="Notifier la direction dans la plateforme : devis accepté, commande validée"><bpmn:documentation>En partie : Aujourd’hui par e-mail ; passe dans les notifications de la plateforme ; le texte dit encore « attend votre validation »</bpmn:documentation><bpmn:incoming>P6_devis_en_ligne_flux8</bpmn:incoming><bpmn:outgoing>P6_devis_en_ligne_flux9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P6_devis_en_ligne_t6" name="Refuser le devis"><bpmn:documentation>Dans l’application : La commande reste, avec la réponse du client</bpmn:documentation><bpmn:incoming>P6_devis_en_ligne_flux6</bpmn:incoming><bpmn:outgoing>P6_devis_en_ligne_flux10</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P6_devis_en_ligne_t9" name="Annuler la commande toute seule (motif : devis refusé par le client)"><bpmn:documentation>Pas encore : Aujourd’hui la commande reste ouverte et la direction doit l’annuler à la main</bpmn:documentation><bpmn:incoming>P6_devis_en_ligne_flux10</bpmn:incoming><bpmn:outgoing>P6_devis_en_ligne_flux11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P6_devis_en_ligne_t8" name="Notifier la direction dans la plateforme : devis refusé"><bpmn:documentation>En partie : Avec un lien vers la commande, pour information. Aujourd’hui par e-mail ; passe dans les notifications de la plateforme</bpmn:documentation><bpmn:incoming>P6_devis_en_ligne_flux11</bpmn:incoming><bpmn:outgoing>P6_devis_en_ligne_flux12</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P6_devis_en_ligne_f1" name="Commande validée : voir « Fabrication »"><bpmn:incoming>P6_devis_en_ligne_flux9</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P6_devis_en_ligne_f2" name="Devis refusé, commande annulée, direction prévenue"><bpmn:incoming>P6_devis_en_ligne_flux12</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P6_devis_en_ligne_flux1" sourceRef="P6_devis_en_ligne_d" targetRef="P6_devis_en_ligne_t1" />
    <bpmn:sequenceFlow id="P6_devis_en_ligne_flux2" sourceRef="P6_devis_en_ligne_t1" targetRef="P6_devis_en_ligne_t2" />
    <bpmn:sequenceFlow id="P6_devis_en_ligne_flux3" sourceRef="P6_devis_en_ligne_t2" targetRef="P6_devis_en_ligne_t3" />
    <bpmn:sequenceFlow id="P6_devis_en_ligne_flux4" sourceRef="P6_devis_en_ligne_t3" targetRef="P6_devis_en_ligne_g1" />
    <bpmn:sequenceFlow id="P6_devis_en_ligne_flux5" name="Oui" sourceRef="P6_devis_en_ligne_g1" targetRef="P6_devis_en_ligne_t4" />
    <bpmn:sequenceFlow id="P6_devis_en_ligne_flux6" name="Non" sourceRef="P6_devis_en_ligne_g1" targetRef="P6_devis_en_ligne_t6" />
    <bpmn:sequenceFlow id="P6_devis_en_ligne_flux7" sourceRef="P6_devis_en_ligne_t4" targetRef="P6_devis_en_ligne_t5" />
    <bpmn:sequenceFlow id="P6_devis_en_ligne_flux8" sourceRef="P6_devis_en_ligne_t5" targetRef="P6_devis_en_ligne_t7" />
    <bpmn:sequenceFlow id="P6_devis_en_ligne_flux9" sourceRef="P6_devis_en_ligne_t7" targetRef="P6_devis_en_ligne_f1" />
    <bpmn:sequenceFlow id="P6_devis_en_ligne_flux10" sourceRef="P6_devis_en_ligne_t6" targetRef="P6_devis_en_ligne_t9" />
    <bpmn:sequenceFlow id="P6_devis_en_ligne_flux11" sourceRef="P6_devis_en_ligne_t9" targetRef="P6_devis_en_ligne_t8" />
    <bpmn:sequenceFlow id="P6_devis_en_ligne_flux12" sourceRef="P6_devis_en_ligne_t8" targetRef="P6_devis_en_ligne_f2" />
    <bpmn:textAnnotation id="P6_devis_en_ligne_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
