    <bpmn:sequenceFlow id="P13_facturation_flux6" sourceRef="P13_facturation_t5" targetRef="P13_facturation_g1" />
    <bpmn:sequenceFlow id="P13_facturation_flux7" name="Oui" sourceRef="P13_facturation_g1" targetRef="P13_facturation_t6" />
    <bpmn:sequenceFlow id="P13_facturation_flux8" name="Non" sourceRef="P13_facturation_g1" targetRef="P13_facturation_t7" />
    <bpmn:sequenceFlow id="P13_facturation_flux9" sourceRef="P13_facturation_t7" targetRef="P13_facturation_t6" />
    <bpmn:sequenceFlow id="P13_facturation_flux10" sourceRef="P13_facturation_t6" targetRef="P13_facturation_g2" />
    <bpmn:sequenceFlow id="P13_facturation_flux11" name="Oui" sourceRef="P13_facturation_g2" targetRef="P13_facturation_t8" />
    <bpmn:sequenceFlow id="P13_facturation_flux12" name="Non" sourceRef="P13_facturation_g2" targetRef="P13_facturation_t9" />
    <bpmn:sequenceFlow id="P13_facturation_flux13" sourceRef="P13_facturation_t8" targetRef="P13_facturation_t9" />
    <bpmn:sequenceFlow id="P13_facturation_flux14" sourceRef="P13_facturation_t9" targetRef="P13_facturation_f" />
    <bpmn:textAnnotation id="P13_facturation_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
