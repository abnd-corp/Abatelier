<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P13_facturation_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P13_facturation_collab">
    <bpmn:participant id="P13_facturation_pool" name="Facturation et encaissement" processRef="P13_facturation" />
  </bpmn:collaboration>
  <bpmn:process id="P13_facturation" name="Facturation et encaissement" isExecutable="false">
    <bpmn:documentation>De la commande livrée à la facture payée, avec avoir et export pour le comptable. Aucun document n’est joint aux e-mails.</bpmn:documentation>
    <bpmn:laneSet id="P13_facturation_voies">
      <bpmn:lane id="P13_facturation_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P13_facturation_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_facturation_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_facturation_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_facturation_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_facturation_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_facturation_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_facturation_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_facturation_t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_facturation_t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_facturation_f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P13_facturation_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P13_facturation_t2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P13_facturation_voie_client" name="Visiteur / Client">
        <bpmn:flowNodeRef>P13_facturation_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_facturation_t5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P13_facturation_d" name="Commande livrée ou retirée"><bpmn:outgoing>P13_facturation_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P13_facturation_t1" name="Facturer la commande"><bpmn:documentation>Dans l’application : Commande › Facturer (numérotation F-AAAA-NNNN sans trou)</bpmn:documentation><bpmn:incoming>P13_facturation_flux1</bpmn:incoming><bpmn:outgoing>P13_facturation_flux2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P13_facturation_t2" name="Éditer la facture PDF, avec le fichier Factur-X"><bpmn:documentation>Dans l’application : Checklist des mentions obligatoires, QR code du site</bpmn:documentation><bpmn:incoming>P13_facturation_flux2</bpmn:incoming><bpmn:outgoing>P13_facturation_flux3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P13_facturation_t3" name="Prévenir le client par e-mail (sans pièce jointe)"><bpmn:documentation>Dans l’application : Le message renvoie vers l’espace client, ou l’invite à l’activer</bpmn:documentation><bpmn:incoming>P13_facturation_flux3</bpmn:incoming><bpmn:outgoing>P13_facturation_flux4</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P13_facturation_t4" name="Consulter et télécharger sa facture dans son espace"><bpmn:documentation>Dans l’application : Espace client › Factures</bpmn:documentation><bpmn:incoming>P13_facturation_flux4</bpmn:incoming><bpmn:outgoing>P13_facturation_flux5</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="P13_facturation_t5" name="Payer (virement, chèque, espèces, carte)"><bpmn:documentation>Hors application : Le règlement hors ligne se fait hors de l’application</bpmn:documentation><bpmn:incoming>P13_facturation_flux5</bpmn:incoming><bpmn:outgoing>P13_facturation_flux6</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="P13_facturation_g1" name="Payée dans les délais ?"><bpmn:incoming>P13_facturation_flux6</bpmn:incoming><bpmn:outgoing>P13_facturation_flux7</bpmn:outgoing><bpmn:outgoing>P13_facturation_flux8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P13_facturation_t6" name="Enregistrer le paiement (date, mode)"><bpmn:documentation>Dans l’application : Facture › Enregistrer le paiement (annulable)</bpmn:documentation><bpmn:incoming>P13_facturation_flux7</bpmn:incoming><bpmn:incoming>P13_facturation_flux9</bpmn:incoming><bpmn:outgoing>P13_facturation_flux10</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P13_facturation_t7" name="Relancer le client par e-mail"><bpmn:documentation>Pas encore : Pas de relance automatique ni de liste des impayés</bpmn:documentation><bpmn:incoming>P13_facturation_flux8</bpmn:incoming><bpmn:outgoing>P13_facturation_flux9</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P13_facturation_g2" name="Erreur ou geste commercial ?"><bpmn:incoming>P13_facturation_flux10</bpmn:incoming><bpmn:outgoing>P13_facturation_flux11</bpmn:outgoing><bpmn:outgoing>P13_facturation_flux12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P13_facturation_t8" name="Faire un avoir (total)"><bpmn:documentation>Dans l’application : Facture › Faire un avoir ; l’avoir partiel est à faire</bpmn:documentation><bpmn:incoming>P13_facturation_flux11</bpmn:incoming><bpmn:outgoing>P13_facturation_flux13</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P13_facturation_t9" name="Exporter les ventes et encaissements pour le comptable"><bpmn:documentation>Dans l’application : Devis et factures › Exporter pour le comptable (CSV)</bpmn:documentation><bpmn:incoming>P13_facturation_flux12</bpmn:incoming><bpmn:incoming>P13_facturation_flux13</bpmn:incoming><bpmn:outgoing>P13_facturation_flux14</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P13_facturation_f" name="Facture classée"><bpmn:incoming>P13_facturation_flux14</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P13_facturation_flux1" sourceRef="P13_facturation_d" targetRef="P13_facturation_t1" />
    <bpmn:sequenceFlow id="P13_facturation_flux2" sourceRef="P13_facturation_t1" targetRef="P13_facturation_t2" />
    <bpmn:sequenceFlow id="P13_facturation_flux3" sourceRef="P13_facturation_t2" targetRef="P13_facturation_t3" />
