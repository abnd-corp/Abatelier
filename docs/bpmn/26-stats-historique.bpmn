<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P26_stats_historique_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P26_stats_historique_collab">
    <bpmn:participant id="P26_stats_historique_pool" name="Statistiques : reprise de l’historique" processRef="P26_stats_historique" />
  </bpmn:collaboration>
  <bpmn:process id="P26_stats_historique" name="Statistiques : reprise de l’historique" isExecutable="false">
    <bpmn:documentation>L’entreprise a déjà des données (logiciel de facturation, tableurs) : les reprendre donne des courbes dès le départ.</bpmn:documentation>
    <bpmn:laneSet id="P26_stats_historique_voies">
      <bpmn:lane id="P26_stats_historique_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P26_stats_historique_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P26_stats_historique_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P26_stats_historique_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P26_stats_historique_f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P26_stats_historique_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P26_stats_historique_t2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P26_stats_historique_d" name="L’entreprise a d’anciennes données"><bpmn:outgoing>P26_stats_historique_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P26_stats_historique_t1" name="Choisir le fichier (CSV ou Excel) de l’ancien outil"><bpmn:documentation>Pas encore : À recueillir : quelles données existent et sous quelle forme</bpmn:documentation><bpmn:incoming>P26_stats_historique_flux1</bpmn:incoming><bpmn:outgoing>P26_stats_historique_flux2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P26_stats_historique_t2" name="Contrôler puis importer l’historique"><bpmn:documentation>Pas encore : Les données personnelles ne sont pas reprises dans les statistiques</bpmn:documentation><bpmn:incoming>P26_stats_historique_flux2</bpmn:incoming><bpmn:outgoing>P26_stats_historique_flux3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P26_stats_historique_t3" name="Vérifier les courbes dès le départ"><bpmn:documentation>Pas encore : Accès réservé à la direction (permission stats.read) ; lisible sur téléphone</bpmn:documentation><bpmn:incoming>P26_stats_historique_flux3</bpmn:incoming><bpmn:outgoing>P26_stats_historique_flux4</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P26_stats_historique_f" name="Historique repris"><bpmn:incoming>P26_stats_historique_flux4</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P26_stats_historique_flux1" sourceRef="P26_stats_historique_d" targetRef="P26_stats_historique_t1" />
    <bpmn:sequenceFlow id="P26_stats_historique_flux2" sourceRef="P26_stats_historique_t1" targetRef="P26_stats_historique_t2" />
    <bpmn:sequenceFlow id="P26_stats_historique_flux3" sourceRef="P26_stats_historique_t2" targetRef="P26_stats_historique_t3" />
    <bpmn:sequenceFlow id="P26_stats_historique_flux4" sourceRef="P26_stats_historique_t3" targetRef="P26_stats_historique_f" />
    <bpmn:textAnnotation id="P26_stats_historique_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P26_stats_historique_diagram">
    <bpmndi:BPMNPlane id="P26_stats_historique_plane" bpmnElement="P26_stats_historique_collab">
      <bpmndi:BPMNShape id="P26_stats_historique_pool_di" bpmnElement="P26_stats_historique_pool" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="1060" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P26_stats_historique_voie_direction_di" bpmnElement="P26_stats_historique_voie_direction" isHorizontal="true">
        <dc:Bounds x="70" y="40" width="1030" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P26_stats_historique_voie_systeme_di" bpmnElement="P26_stats_historique_voie_systeme" isHorizontal="true">
        <dc:Bounds x="70" y="160" width="1030" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P26_stats_historique_d_di" bpmnElement="P26_stats_historique_d">
        <dc:Bounds x="197" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P26_stats_historique_t1_di" bpmnElement="P26_stats_historique_t1" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="330" y="60" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P26_stats_historique_t2_di" bpmnElement="P26_stats_historique_t2" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="520" y="180" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P26_stats_historique_t3_di" bpmnElement="P26_stats_historique_t3" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="710" y="60" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P26_stats_historique_f_di" bpmnElement="P26_stats_historique_f">
        <dc:Bounds x="957" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P26_stats_historique_flux1_di" bpmnElement="P26_stats_historique_flux1">
        <di:waypoint x="233" y="100" />
        <di:waypoint x="330" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P26_stats_historique_flux2_di" bpmnElement="P26_stats_historique_flux2">
        <di:waypoint x="480" y="100" />
        <di:waypoint x="495" y="100" />
        <di:waypoint x="495" y="220" />
        <di:waypoint x="520" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P26_stats_historique_flux3_di" bpmnElement="P26_stats_historique_flux3">
        <di:waypoint x="670" y="220" />
        <di:waypoint x="685" y="220" />
        <di:waypoint x="685" y="100" />
        <di:waypoint x="710" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P26_stats_historique_flux4_di" bpmnElement="P26_stats_historique_flux4">
        <di:waypoint x="860" y="100" />
        <di:waypoint x="957" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="P26_stats_historique_legende_di" bpmnElement="P26_stats_historique_legende">
        <dc:Bounds x="70" y="300" width="760" height="30" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
