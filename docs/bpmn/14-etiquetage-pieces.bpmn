<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P14_etiquetage_pieces_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P14_etiquetage_pieces_collab">
    <bpmn:participant id="P14_etiquetage_pieces_pool" name="Étiqueter chaque pièce avec le code de la commande" processRef="P14_etiquetage_pieces" />
  </bpmn:collaboration>
  <bpmn:process id="P14_etiquetage_pieces" name="Étiqueter chaque pièce avec le code de la commande" isExecutable="false">
    <bpmn:documentation>Idée à valider : chaque pièce pliée reçoit une étiquette avec le code-barres de sa commande, son repère et son numéro (3 sur 6). Un scan suffit pour identifier une pièce, retrouver sa commande et regrouper toutes les pièces avant la remise.</bpmn:documentation>
    <bpmn:laneSet id="P14_etiquetage_pieces_voies">
      <bpmn:lane id="P14_etiquetage_pieces_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P14_etiquetage_pieces_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_etiquetage_pieces_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_etiquetage_pieces_t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P14_etiquetage_pieces_voie_atelier" name="Atelier">
        <bpmn:flowNodeRef>P14_etiquetage_pieces_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_etiquetage_pieces_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_etiquetage_pieces_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_etiquetage_pieces_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_etiquetage_pieces_f</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P14_etiquetage_pieces_d" name="Une commande est en fabrication"><bpmn:outgoing>P14_etiquetage_pieces_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P14_etiquetage_pieces_t1" name="Attribuer un code unique de 13 chiffres (EAN-13) à la commande"><bpmn:documentation>Pas encore : Même principe que le code client ; à cadrer : un code par commande (avec le numéro de pièce écrit en clair) ou un code par pièce</bpmn:documentation><bpmn:incoming>P14_etiquetage_pieces_flux1</bpmn:incoming><bpmn:outgoing>P14_etiquetage_pieces_flux2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P14_etiquetage_pieces_t2" name="Éditer les étiquettes : code-barres, repère, pièce n sur N, nom du client"><bpmn:documentation>Pas encore : Imprimées avec la fiche de fabrication ; le client n’apparaît que par son nom, jamais son adresse</bpmn:documentation><bpmn:incoming>P14_etiquetage_pieces_flux2</bpmn:incoming><bpmn:outgoing>P14_etiquetage_pieces_flux3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:manualTask id="P14_etiquetage_pieces_t3" name="Coller une étiquette sur chaque pièce pliée en la mettant de côté"><bpmn:documentation>Hors application : À valider avec l’atelier : imprimante d’étiquettes ou feuille adhésive A4 ?</bpmn:documentation><bpmn:incoming>P14_etiquetage_pieces_flux3</bpmn:incoming><bpmn:outgoing>P14_etiquetage_pieces_flux4</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="P14_etiquetage_pieces_t4" name="Scanner une pièce pour identifier sa commande"><bpmn:documentation>Pas encore : Caméra du téléphone ; utile aussi pour retrouver une pièce égarée dans l’atelier</bpmn:documentation><bpmn:incoming>P14_etiquetage_pieces_flux4</bpmn:incoming><bpmn:outgoing>P14_etiquetage_pieces_flux5</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P14_etiquetage_pieces_t5" name="Afficher la commande et compter les pièces regroupées (3 sur 6)"><bpmn:documentation>Pas encore : Montre ce qu’il reste à réunir avant de passer la commande à « Prête »</bpmn:documentation><bpmn:incoming>P14_etiquetage_pieces_flux5</bpmn:incoming><bpmn:outgoing>P14_etiquetage_pieces_flux6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P14_etiquetage_pieces_t6" name="Marquer la commande prête quand toutes les pièces sont réunies"><bpmn:documentation>En partie : Aujourd’hui un bouton « Marquer prête » sans contrôle ; avec le comptage, l’application peut vérifier que rien ne manque</bpmn:documentation><bpmn:incoming>P14_etiquetage_pieces_flux6</bpmn:incoming><bpmn:outgoing>P14_etiquetage_pieces_flux7</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P14_etiquetage_pieces_f" name="Pièces identifiées et regroupées, prêtes pour la remise (voir « Livraison et retrait »)"><bpmn:incoming>P14_etiquetage_pieces_flux7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P14_etiquetage_pieces_flux1" sourceRef="P14_etiquetage_pieces_d" targetRef="P14_etiquetage_pieces_t1" />
    <bpmn:sequenceFlow id="P14_etiquetage_pieces_flux2" sourceRef="P14_etiquetage_pieces_t1" targetRef="P14_etiquetage_pieces_t2" />
    <bpmn:sequenceFlow id="P14_etiquetage_pieces_flux3" sourceRef="P14_etiquetage_pieces_t2" targetRef="P14_etiquetage_pieces_t3" />
    <bpmn:sequenceFlow id="P14_etiquetage_pieces_flux4" sourceRef="P14_etiquetage_pieces_t3" targetRef="P14_etiquetage_pieces_t4" />
    <bpmn:sequenceFlow id="P14_etiquetage_pieces_flux5" sourceRef="P14_etiquetage_pieces_t4" targetRef="P14_etiquetage_pieces_t5" />
    <bpmn:sequenceFlow id="P14_etiquetage_pieces_flux6" sourceRef="P14_etiquetage_pieces_t5" targetRef="P14_etiquetage_pieces_t6" />
    <bpmn:sequenceFlow id="P14_etiquetage_pieces_flux7" sourceRef="P14_etiquetage_pieces_t6" targetRef="P14_etiquetage_pieces_f" />
    <bpmn:textAnnotation id="P14_etiquetage_pieces_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P14_etiquetage_pieces_diagram">
