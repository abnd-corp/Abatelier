<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P18_messages_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P18_messages_collab">
    <bpmn:participant id="P18_messages_pool" name="Messages envoyés par l’application" processRef="P18_messages" />
  </bpmn:collaboration>
  <bpmn:process id="P18_messages" name="Messages envoyés par l’application" isExecutable="false">
    <bpmn:documentation>Les messages automatiques : par e-mail pour les clients, qui ne se connectent pas souvent ; dans la plateforme, en un seul endroit, pour la direction. Jamais de publicité, jamais de document joint, jamais de mot de passe.</bpmn:documentation>
    <bpmn:laneSet id="P18_messages_voies">
      <bpmn:lane id="P18_messages_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P18_messages_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_messages_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_messages_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_messages_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_messages_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_messages_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_messages_t6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P18_messages_voie_client" name="Visiteur / Client">
        <bpmn:flowNodeRef>P18_messages_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_messages_f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P18_messages_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P18_messages_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_messages_t8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P18_messages_d" name="Un événement se produit dans l’application"><bpmn:outgoing>P18_messages_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="P18_messages_g1" name="Pour qui ?"><bpmn:incoming>P18_messages_flux1</bpmn:incoming><bpmn:outgoing>P18_messages_flux2</bpmn:outgoing><bpmn:outgoing>P18_messages_flux3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P18_messages_t1" name="Bienvenue, activation de l’espace, mot de passe oublié, mot de passe modifié"><bpmn:documentation>Dans l’application : Liens à usage unique ; message de sécurité à chaque changement de mot de passe</bpmn:documentation><bpmn:incoming>P18_messages_flux2</bpmn:incoming><bpmn:outgoing>P18_messages_flux4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P18_messages_t2" name="Commande confirmée, commande refusée et remboursée"><bpmn:documentation>Dans l’application : Récapitulatif, date estimée, bouton vers l’espace client</bpmn:documentation><bpmn:incoming>P18_messages_flux4</bpmn:incoming><bpmn:outgoing>P18_messages_flux5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P18_messages_t3" name="Devis, facture ou avoir disponible dans l’espace client"><bpmn:documentation>Dans l’application : Aucune pièce jointe ; envoyé par la direction, texte modifiable</bpmn:documentation><bpmn:incoming>P18_messages_flux5</bpmn:incoming><bpmn:outgoing>P18_messages_flux6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P18_messages_t4" name="Commande prête, accusé de réception d’une demande de contact"><bpmn:documentation>Pas encore : Pas encore envoyés au client</bpmn:documentation><bpmn:incoming>P18_messages_flux6</bpmn:incoming><bpmn:outgoing>P18_messages_flux7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P18_messages_t5" name="Lire le message (rappel de sécurité et lien vers son espace)"><bpmn:documentation>Dans l’application : Version mise en page et version texte</bpmn:documentation><bpmn:incoming>P18_messages_flux7</bpmn:incoming><bpmn:outgoing>P18_messages_flux8</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P18_messages_t6" name="Notifier la direction dans la plateforme (commande, contact, devis)"><bpmn:documentation>En partie : Centre de notifications unique (lues et non lues, par compte, selon les droits) ; aujourd’hui des e-mails aux adresses réglées</bpmn:documentation><bpmn:incoming>P18_messages_flux3</bpmn:incoming><bpmn:outgoing>P18_messages_flux9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P18_messages_t7" name="Lire la notification et ouvrir la commande ou la demande"><bpmn:documentation>En partie : Un seul endroit pour tout, sans séparer les informations entre e-mail et plateforme</bpmn:documentation><bpmn:incoming>P18_messages_flux9</bpmn:incoming><bpmn:outgoing>P18_messages_flux10</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P18_messages_t8" name="Vérifier le rendu de chaque message et se l’envoyer"><bpmn:documentation>Dans l’application : Site vitrine › E-mails › Aperçu des messages (13 modèles)</bpmn:documentation><bpmn:incoming>P18_messages_flux8</bpmn:incoming><bpmn:incoming>P18_messages_flux10</bpmn:incoming><bpmn:outgoing>P18_messages_flux11</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P18_messages_f" name="Client informé, sans publicité"><bpmn:incoming>P18_messages_flux11</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P18_messages_flux1" sourceRef="P18_messages_d" targetRef="P18_messages_g1" />
    <bpmn:sequenceFlow id="P18_messages_flux2" name="Client : compte" sourceRef="P18_messages_g1" targetRef="P18_messages_t1" />
    <bpmn:sequenceFlow id="P18_messages_flux3" name="Direction" sourceRef="P18_messages_g1" targetRef="P18_messages_t6" />
    <bpmn:sequenceFlow id="P18_messages_flux4" sourceRef="P18_messages_t1" targetRef="P18_messages_t2" />
    <bpmn:sequenceFlow id="P18_messages_flux5" sourceRef="P18_messages_t2" targetRef="P18_messages_t3" />
    <bpmn:sequenceFlow id="P18_messages_flux6" sourceRef="P18_messages_t3" targetRef="P18_messages_t4" />
    <bpmn:sequenceFlow id="P18_messages_flux7" sourceRef="P18_messages_t4" targetRef="P18_messages_t5" />
    <bpmn:sequenceFlow id="P18_messages_flux8" sourceRef="P18_messages_t5" targetRef="P18_messages_t8" />
    <bpmn:sequenceFlow id="P18_messages_flux9" sourceRef="P18_messages_t6" targetRef="P18_messages_t7" />
    <bpmn:sequenceFlow id="P18_messages_flux10" sourceRef="P18_messages_t7" targetRef="P18_messages_t8" />
    <bpmn:sequenceFlow id="P18_messages_flux11" sourceRef="P18_messages_t8" targetRef="P18_messages_f" />
    <bpmn:textAnnotation id="P18_messages_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
