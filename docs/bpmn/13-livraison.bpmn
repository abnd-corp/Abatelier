<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P13_livraison_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P13_livraison_collab">
    <bpmn:participant id="P13_livraison_pool" name="Livraison et retrait" processRef="P13_livraison" />
  </bpmn:collaboration>
  <bpmn:process id="P13_livraison" name="Livraison et retrait" isExecutable="false">
    <bpmn:documentation>La commande prête est retirée à l’atelier, ou livrée sur chantier par un salarié avec le camion de l’entreprise. Chaque colis porte une étiquette code-barres : la remise se valide en la scannant et en faisant signer le client sur l’écran. La remise lance ensuite la facture.</bpmn:documentation>
    <bpmn:laneSet id="P13_livraison_voies">
      <bpmn:lane id="P13_livraison_voie_atelier" name="Atelier">
        <bpmn:flowNodeRef>P13_livraison_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_livraison_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_livraison_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_livraison_f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_livraison_gj1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P13_livraison_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P13_livraison_g1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P13_livraison_voie_client" name="Visiteur / Client">
        <bpmn:flowNodeRef>P13_livraison_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_livraison_t6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P13_livraison_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P13_livraison_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_livraison_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_livraison_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P13_livraison_t8</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P13_livraison_d" name="Commande prête"><bpmn:outgoing>P13_livraison_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P13_livraison_t5" name="Générer le code-barres du colis et l’étiquette à imprimer"><bpmn:documentation>Pas encore : Un code par colis (ou par commande, à cadrer) ; l’atelier imprime l’étiquette et la colle sur le colis</bpmn:documentation><bpmn:incoming>P13_livraison_flux1</bpmn:incoming><bpmn:outgoing>P13_livraison_flux2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P13_livraison_g1" name="Retrait ou livraison ?"><bpmn:incoming>P13_livraison_flux2</bpmn:incoming><bpmn:outgoing>P13_livraison_flux3</bpmn:outgoing><bpmn:outgoing>P13_livraison_flux4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P13_livraison_t1" name="Venir chercher la commande à l’atelier"><bpmn:documentation>Hors application : Le mode « retrait » est choisi à la commande</bpmn:documentation><bpmn:incoming>P13_livraison_flux3</bpmn:incoming><bpmn:outgoing>P13_livraison_flux8</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P13_livraison_t2" name="Fournir l’adresse, la distance et les frais de livraison"><bpmn:documentation>Dans l’application : Calculés à la commande (distance par la route)</bpmn:documentation><bpmn:incoming>P13_livraison_flux4</bpmn:incoming><bpmn:outgoing>P13_livraison_flux5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P13_livraison_t3" name="Grouper les colis et préparer la tournée du salarié livreur"><bpmn:documentation>Pas encore : Les livraisons sont faites par des salariés avec le camion de l’entreprise ; groupes de pièces et ordre de passage à définir avec le client</bpmn:documentation><bpmn:incoming>P13_livraison_flux5</bpmn:incoming><bpmn:outgoing>P13_livraison_flux6</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P13_livraison_t4" name="Éditer le bon de livraison"><bpmn:documentation>Pas encore : Prévu : nouveau type de document ; gardé avec la commande une fois signé</bpmn:documentation><bpmn:incoming>P13_livraison_flux6</bpmn:incoming><bpmn:outgoing>P13_livraison_flux7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P13_livraison_t7" name="Scanner le code-barres du colis à la remise (caméra du téléphone)"><bpmn:documentation>Pas encore : Comme pour la réception des feuilles ; sans le scan, la remise n’est pas validée</bpmn:documentation><bpmn:incoming>P13_livraison_flux12</bpmn:incoming><bpmn:outgoing>P13_livraison_flux9</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P13_livraison_t6" name="Signer la réception sur l’écran du salarié"><bpmn:documentation>Pas encore : Signature gardée avec la commande ; que faire d’un client absent est à définir</bpmn:documentation><bpmn:incoming>P13_livraison_flux9</bpmn:incoming><bpmn:outgoing>P13_livraison_flux10</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P13_livraison_t8" name="Valider la remise : la commande passe à « Livrée » ou « Retirée »"><bpmn:documentation>En partie : Aujourd’hui un bouton « Marquer livrée » ou « Marquer retirée » ; avec le scan et la signature, plus de bouton à presser</bpmn:documentation><bpmn:incoming>P13_livraison_flux10</bpmn:incoming><bpmn:outgoing>P13_livraison_flux11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P13_livraison_f" name="Commande remise : la facturation démarre, voir « Facturation »"><bpmn:incoming>P13_livraison_flux11</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="P13_livraison_gj1" name=""><bpmn:incoming>P13_livraison_flux7</bpmn:incoming><bpmn:incoming>P13_livraison_flux8</bpmn:incoming><bpmn:outgoing>P13_livraison_flux12</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P13_livraison_flux1" sourceRef="P13_livraison_d" targetRef="P13_livraison_t5" />
    <bpmn:sequenceFlow id="P13_livraison_flux2" sourceRef="P13_livraison_t5" targetRef="P13_livraison_g1" />
    <bpmn:sequenceFlow id="P13_livraison_flux3" name="Retrait" sourceRef="P13_livraison_g1" targetRef="P13_livraison_t1" />
    <bpmn:sequenceFlow id="P13_livraison_flux4" name="Livraison" sourceRef="P13_livraison_g1" targetRef="P13_livraison_t2" />
    <bpmn:sequenceFlow id="P13_livraison_flux5" sourceRef="P13_livraison_t2" targetRef="P13_livraison_t3" />
    <bpmn:sequenceFlow id="P13_livraison_flux6" sourceRef="P13_livraison_t3" targetRef="P13_livraison_t4" />
    <bpmn:sequenceFlow id="P13_livraison_flux7" sourceRef="P13_livraison_t4" targetRef="P13_livraison_gj1" />
    <bpmn:sequenceFlow id="P13_livraison_flux8" sourceRef="P13_livraison_t1" targetRef="P13_livraison_gj1" />
    <bpmn:sequenceFlow id="P13_livraison_flux9" sourceRef="P13_livraison_t7" targetRef="P13_livraison_t6" />
    <bpmn:sequenceFlow id="P13_livraison_flux10" sourceRef="P13_livraison_t6" targetRef="P13_livraison_t8" />
    <bpmn:sequenceFlow id="P13_livraison_flux11" sourceRef="P13_livraison_t8" targetRef="P13_livraison_f" />
    <bpmn:sequenceFlow id="P13_livraison_flux12" sourceRef="P13_livraison_gj1" targetRef="P13_livraison_t7" />
    <bpmn:textAnnotation id="P13_livraison_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
