<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P22_stats_atelier_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P22_stats_atelier_collab">
    <bpmn:participant id="P22_stats_atelier_pool" name="Statistiques : délais tenus et charge de l’atelier" processRef="P22_stats_atelier" />
  </bpmn:collaboration>
  <bpmn:process id="P22_stats_atelier" name="Statistiques : délais tenus et charge de l’atelier" isExecutable="false">
    <bpmn:documentation>La direction compare ce qu’elle annonce à ce qu’elle fait. Les dates estimée et réelle sont déjà enregistrées.</bpmn:documentation>
    <bpmn:laneSet id="P22_stats_atelier_voies">
      <bpmn:lane id="P22_stats_atelier_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P22_stats_atelier_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P22_stats_atelier_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P22_stats_atelier_t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P22_stats_atelier_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P22_stats_atelier_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P22_stats_atelier_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P22_stats_atelier_f</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P22_stats_atelier_d" name="La direction veut savoir si elle tient ses délais"><bpmn:outgoing>P22_stats_atelier_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P22_stats_atelier_t1" name="Mesurer les délais validée, prête, livrée et les comparer à la date estimée"><bpmn:documentation>Pas encore : Les dates sont déjà enregistrées</bpmn:documentation><bpmn:incoming>P22_stats_atelier_flux1</bpmn:incoming><bpmn:outgoing>P22_stats_atelier_flux2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P22_stats_atelier_t2" name="Repérer les retards et la charge par semaine"><bpmn:documentation>Pas encore : Aucun classement de salariés : des agrégats seulement</bpmn:documentation><bpmn:incoming>P22_stats_atelier_flux2</bpmn:incoming><bpmn:outgoing>P22_stats_atelier_flux3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P22_stats_atelier_t3" name="Calculer le rendement matière : feuilles commandées contre consommées, chutes"><bpmn:documentation>Pas encore : Dépend du décompte automatique du stock</bpmn:documentation><bpmn:incoming>P22_stats_atelier_flux3</bpmn:incoming><bpmn:outgoing>P22_stats_atelier_flux4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P22_stats_atelier_t4" name="Lire les délais, la charge et le rendement"><bpmn:documentation>Pas encore : Accès réservé à la direction (permission stats.read) ; lisible sur téléphone</bpmn:documentation><bpmn:incoming>P22_stats_atelier_flux4</bpmn:incoming><bpmn:outgoing>P22_stats_atelier_flux5</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P22_stats_atelier_f" name="Décision : recalibrer les délais annoncés, renforcer l’atelier"><bpmn:incoming>P22_stats_atelier_flux5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P22_stats_atelier_flux1" sourceRef="P22_stats_atelier_d" targetRef="P22_stats_atelier_t1" />
    <bpmn:sequenceFlow id="P22_stats_atelier_flux2" sourceRef="P22_stats_atelier_t1" targetRef="P22_stats_atelier_t2" />
    <bpmn:sequenceFlow id="P22_stats_atelier_flux3" sourceRef="P22_stats_atelier_t2" targetRef="P22_stats_atelier_t3" />
    <bpmn:sequenceFlow id="P22_stats_atelier_flux4" sourceRef="P22_stats_atelier_t3" targetRef="P22_stats_atelier_t4" />
    <bpmn:sequenceFlow id="P22_stats_atelier_flux5" sourceRef="P22_stats_atelier_t4" targetRef="P22_stats_atelier_f" />
    <bpmn:textAnnotation id="P22_stats_atelier_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P22_stats_atelier_diagram">
    <bpmndi:BPMNPlane id="P22_stats_atelier_plane" bpmnElement="P22_stats_atelier_collab">
      <bpmndi:BPMNShape id="P22_stats_atelier_pool_di" bpmnElement="P22_stats_atelier_pool" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="1250" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P22_stats_atelier_voie_systeme_di" bpmnElement="P22_stats_atelier_voie_systeme" isHorizontal="true">
        <dc:Bounds x="70" y="40" width="1220" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P22_stats_atelier_voie_direction_di" bpmnElement="P22_stats_atelier_voie_direction" isHorizontal="true">
        <dc:Bounds x="70" y="160" width="1220" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P22_stats_atelier_d_di" bpmnElement="P22_stats_atelier_d">
        <dc:Bounds x="197" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P22_stats_atelier_t1_di" bpmnElement="P22_stats_atelier_t1" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="330" y="60" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P22_stats_atelier_t2_di" bpmnElement="P22_stats_atelier_t2" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="520" y="60" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P22_stats_atelier_t3_di" bpmnElement="P22_stats_atelier_t3" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="710" y="60" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P22_stats_atelier_t4_di" bpmnElement="P22_stats_atelier_t4" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="900" y="180" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P22_stats_atelier_f_di" bpmnElement="P22_stats_atelier_f">
        <dc:Bounds x="1147" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P22_stats_atelier_flux1_di" bpmnElement="P22_stats_atelier_flux1">
        <di:waypoint x="233" y="220" />
        <di:waypoint x="305" y="220" />
        <di:waypoint x="305" y="100" />
        <di:waypoint x="330" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P22_stats_atelier_flux2_di" bpmnElement="P22_stats_atelier_flux2">
        <di:waypoint x="480" y="100" />
        <di:waypoint x="520" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P22_stats_atelier_flux3_di" bpmnElement="P22_stats_atelier_flux3">
        <di:waypoint x="670" y="100" />
        <di:waypoint x="710" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P22_stats_atelier_flux4_di" bpmnElement="P22_stats_atelier_flux4">
        <di:waypoint x="860" y="100" />
        <di:waypoint x="875" y="100" />
        <di:waypoint x="875" y="220" />
        <di:waypoint x="900" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P22_stats_atelier_flux5_di" bpmnElement="P22_stats_atelier_flux5">
        <di:waypoint x="1050" y="220" />
        <di:waypoint x="1147" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="P22_stats_atelier_legende_di" bpmnElement="P22_stats_atelier_legende">
        <dc:Bounds x="70" y="300" width="760" height="30" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
