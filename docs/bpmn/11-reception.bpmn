<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P11_reception_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P11_reception_collab">
    <bpmn:participant id="P11_reception_pool" name="Réception de marchandise au scan" processRef="P11_reception" />
  </bpmn:collaboration>
  <bpmn:process id="P11_reception" name="Réception de marchandise au scan" isExecutable="false">
    <bpmn:documentation>L’atelier reçoit des feuilles : il scanne le code-barres d’une feuille et indique le nombre reçu. Le stock monte, la réception est tracée.</bpmn:documentation>
    <bpmn:laneSet id="P11_reception_voies">
      <bpmn:lane id="P11_reception_voie_atelier" name="Atelier">
        <bpmn:flowNodeRef>P11_reception_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_reception_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_reception_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_reception_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_reception_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_reception_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_reception_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_reception_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_reception_f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P11_reception_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P11_reception_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_reception_t5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P11_reception_d" name="Une livraison de feuilles arrive"><bpmn:outgoing>P11_reception_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:manualTask id="P11_reception_t1" name="Décharger et contrôler la livraison"><bpmn:documentation>Hors application : Contrôle sur place</bpmn:documentation><bpmn:incoming>P11_reception_flux1</bpmn:incoming><bpmn:outgoing>P11_reception_flux2</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="P11_reception_t2" name="Scanner le code-barres d’une feuille (caméra du téléphone) ou le saisir"><bpmn:documentation>Dans l’application : Atelier › Réception ; la caméra demande une connexion sécurisée (HTTPS)</bpmn:documentation><bpmn:incoming>P11_reception_flux2</bpmn:incoming><bpmn:incoming>P11_reception_flux10</bpmn:incoming><bpmn:outgoing>P11_reception_flux3</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P11_reception_g1" name="Code reconnu ?"><bpmn:incoming>P11_reception_flux3</bpmn:incoming><bpmn:outgoing>P11_reception_flux4</bpmn:outgoing><bpmn:outgoing>P11_reception_flux5</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P11_reception_t3" name="Associer le code à une référence ou en créer une"><bpmn:documentation>Dans l’application : Le code est reconnu aux réceptions suivantes</bpmn:documentation><bpmn:incoming>P11_reception_flux5</bpmn:incoming><bpmn:outgoing>P11_reception_flux6</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P11_reception_t4" name="Indiquer le nombre de feuilles reçues et une note (bon de livraison)"><bpmn:documentation>Dans l’application : Un code = une feuille ; on scanne une fois et on indique la quantité</bpmn:documentation><bpmn:incoming>P11_reception_flux4</bpmn:incoming><bpmn:incoming>P11_reception_flux6</bpmn:incoming><bpmn:outgoing>P11_reception_flux7</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P11_reception_t5" name="Augmenter le stock et tracer l’entrée (qui, quand, quelle note)"><bpmn:documentation>Dans l’application : Dernières réceptions affichées à côté</bpmn:documentation><bpmn:incoming>P11_reception_flux7</bpmn:incoming><bpmn:outgoing>P11_reception_flux8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P11_reception_g2" name="D’autres références dans la livraison ?"><bpmn:incoming>P11_reception_flux8</bpmn:incoming><bpmn:outgoing>P11_reception_flux9</bpmn:outgoing><bpmn:outgoing>P11_reception_flux11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P11_reception_t6" name="Passer au code suivant"><bpmn:documentation>Dans l’application : La caméra est prête pour la feuille suivante</bpmn:documentation><bpmn:incoming>P11_reception_flux9</bpmn:incoming><bpmn:outgoing>P11_reception_flux10</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="P11_reception_t7" name="Commander des feuilles au fournisseur"><bpmn:documentation>Hors application : Reste dans l’outil indépendant du client : l’application ne gère pas les commandes fournisseur</bpmn:documentation><bpmn:incoming>P11_reception_flux11</bpmn:incoming><bpmn:outgoing>P11_reception_flux12</bpmn:outgoing></bpmn:manualTask>
    <bpmn:endEvent id="P11_reception_f" name="Livraison enregistrée"><bpmn:incoming>P11_reception_flux12</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P11_reception_flux1" sourceRef="P11_reception_d" targetRef="P11_reception_t1" />
    <bpmn:sequenceFlow id="P11_reception_flux2" sourceRef="P11_reception_t1" targetRef="P11_reception_t2" />
    <bpmn:sequenceFlow id="P11_reception_flux3" sourceRef="P11_reception_t2" targetRef="P11_reception_g1" />
    <bpmn:sequenceFlow id="P11_reception_flux4" name="Oui" sourceRef="P11_reception_g1" targetRef="P11_reception_t4" />
    <bpmn:sequenceFlow id="P11_reception_flux5" name="Non" sourceRef="P11_reception_g1" targetRef="P11_reception_t3" />
    <bpmn:sequenceFlow id="P11_reception_flux6" sourceRef="P11_reception_t3" targetRef="P11_reception_t4" />
    <bpmn:sequenceFlow id="P11_reception_flux7" sourceRef="P11_reception_t4" targetRef="P11_reception_t5" />
    <bpmn:sequenceFlow id="P11_reception_flux8" sourceRef="P11_reception_t5" targetRef="P11_reception_g2" />
    <bpmn:sequenceFlow id="P11_reception_flux9" name="Oui" sourceRef="P11_reception_g2" targetRef="P11_reception_t6" />
    <bpmn:sequenceFlow id="P11_reception_flux10" sourceRef="P11_reception_t6" targetRef="P11_reception_t2" />
    <bpmn:sequenceFlow id="P11_reception_flux11" name="Non" sourceRef="P11_reception_g2" targetRef="P11_reception_t7" />
    <bpmn:sequenceFlow id="P11_reception_flux12" sourceRef="P11_reception_t7" targetRef="P11_reception_f" />
    <bpmn:textAnnotation id="P11_reception_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
