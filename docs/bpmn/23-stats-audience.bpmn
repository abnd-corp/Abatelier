      <bpmndi:BPMNShape id="P23_stats_audience_legende_di" bpmnElement="P23_stats_audience_legende">
        <dc:Bounds x="70" y="300" width="760" height="30" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
