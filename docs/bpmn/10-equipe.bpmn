      <bpmndi:BPMNShape id="P10_equipe_voie_direction_di" bpmnElement="P10_equipe_voie_direction" isHorizontal="true">
        <dc:Bounds x="70" y="40" width="1980" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P10_equipe_voie_systeme_di" bpmnElement="P10_equipe_voie_systeme" isHorizontal="true">
