        <dc:Bounds x="1090" y="60" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P10_equipe_t6_di" bpmnElement="P10_equipe_t6" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="1280" y="60" width="150" height="80" />
