        <dc:Bounds x="197" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P10_equipe_t1_di" bpmnElement="P10_equipe_t1" bioc:stroke="#2e7d32" bioc:fill="#d8f0dc">
