<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P21_facturation_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P21_facturation_collab">
    <bpmn:participant id="P21_facturation_pool" name="Facturation et encaissement" processRef="P21_facturation" />
  </bpmn:collaboration>
  <bpmn:process id="P21_facturation" name="Facturation et encaissement" isExecutable="false">
    <bpmn:documentation>La remise de la commande (retrait ou livraison) lance la facture toute seule, le client est prévenu et la consulte dans son espace. La direction n’enregistre pas les paiements : ils sont constatés par l’application. Avoir et export pour le comptable restent à sa main.</bpmn:documentation>
    <bpmn:laneSet id="P21_facturation_voies">
      <bpmn:lane id="P21_facturation_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P21_facturation_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_facturation_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_facturation_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_facturation_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_facturation_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_facturation_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_facturation_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_facturation_t8</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P21_facturation_voie_client" name="Visiteur / Client">
        <bpmn:flowNodeRef>P21_facturation_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_facturation_t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P21_facturation_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P21_facturation_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_facturation_t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_facturation_t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_facturation_f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P21_facturation_gj1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P21_facturation_d" name="Commande remise (retirée ou livrée)"><bpmn:outgoing>P21_facturation_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P21_facturation_t1" name="Détecter la remise et émettre la facture toute seule"><bpmn:documentation>En partie : Aujourd’hui la direction clique sur « Facturer » ; numérotation F-AAAA-NNNN sans trou</bpmn:documentation><bpmn:incoming>P21_facturation_flux1</bpmn:incoming><bpmn:outgoing>P21_facturation_flux2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P21_facturation_t2" name="Éditer la facture PDF, avec le fichier Factur-X"><bpmn:documentation>Dans l’application : Checklist des mentions obligatoires, QR code du site</bpmn:documentation><bpmn:incoming>P21_facturation_flux2</bpmn:incoming><bpmn:outgoing>P21_facturation_flux3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P21_facturation_t3" name="Prévenir le client par e-mail : sa facture est dans son espace (sans pièce jointe)"><bpmn:documentation>En partie : Le message existe ; il part aujourd’hui sur geste de la direction</bpmn:documentation><bpmn:incoming>P21_facturation_flux3</bpmn:incoming><bpmn:outgoing>P21_facturation_flux4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P21_facturation_t4" name="Consulter et télécharger sa facture dans son espace"><bpmn:documentation>Dans l’application : Espace client › Factures</bpmn:documentation><bpmn:incoming>P21_facturation_flux4</bpmn:incoming><bpmn:outgoing>P21_facturation_flux5</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P21_facturation_g1" name="Déjà payée ?"><bpmn:incoming>P21_facturation_flux5</bpmn:incoming><bpmn:outgoing>P21_facturation_flux6</bpmn:outgoing><bpmn:outgoing>P21_facturation_flux7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P21_facturation_t5" name="Marquer la facture payée avec la confirmation du prestataire de paiement"><bpmn:documentation>Pas encore : Le paiement en ligne est déjà enregistré ; la facture n’est pas encore marquée payée toute seule</bpmn:documentation><bpmn:incoming>P21_facturation_flux6</bpmn:incoming><bpmn:outgoing>P21_facturation_flux10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P21_facturation_t6" name="Relancer le client par e-mail : rappel à l’échéance, puis relances"><bpmn:documentation>Pas encore : Pas de relance automatique ni de liste des impayés</bpmn:documentation><bpmn:incoming>P21_facturation_flux7</bpmn:incoming><bpmn:outgoing>P21_facturation_flux8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:manualTask id="P21_facturation_t7" name="Payer (virement, chèque…)"><bpmn:documentation>Hors application : À recueillir : quelles commandes partent sans paiement préalable, et comment elles sont réglées</bpmn:documentation><bpmn:incoming>P21_facturation_flux8</bpmn:incoming><bpmn:outgoing>P21_facturation_flux9</bpmn:outgoing></bpmn:manualTask>
    <bpmn:serviceTask id="P21_facturation_t8" name="Constater le paiement sans saisie de la direction (par exemple en lisant le relevé bancaire)"><bpmn:documentation>Pas encore : À définir avec le client ; aujourd’hui la direction enregistre le paiement à la main</bpmn:documentation><bpmn:incoming>P21_facturation_flux9</bpmn:incoming><bpmn:outgoing>P21_facturation_flux11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P21_facturation_g2" name="Erreur ou geste commercial ?"><bpmn:incoming>P21_facturation_flux10</bpmn:incoming><bpmn:incoming>P21_facturation_flux11</bpmn:incoming><bpmn:outgoing>P21_facturation_flux12</bpmn:outgoing><bpmn:outgoing>P21_facturation_flux13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P21_facturation_t9" name="Faire un avoir (total)"><bpmn:documentation>Dans l’application : Facture › Faire un avoir ; l’avoir partiel est à faire</bpmn:documentation><bpmn:incoming>P21_facturation_flux12</bpmn:incoming><bpmn:outgoing>P21_facturation_flux14</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P21_facturation_t10" name="Exporter les ventes et encaissements pour le comptable"><bpmn:documentation>Dans l’application : Devis et factures › Exporter pour le comptable (CSV)</bpmn:documentation><bpmn:incoming>P21_facturation_flux16</bpmn:incoming><bpmn:outgoing>P21_facturation_flux15</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P21_facturation_f" name="Facture classée"><bpmn:incoming>P21_facturation_flux15</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="P21_facturation_gj1" name=""><bpmn:incoming>P21_facturation_flux13</bpmn:incoming><bpmn:incoming>P21_facturation_flux14</bpmn:incoming><bpmn:outgoing>P21_facturation_flux16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P21_facturation_flux1" sourceRef="P21_facturation_d" targetRef="P21_facturation_t1" />
    <bpmn:sequenceFlow id="P21_facturation_flux2" sourceRef="P21_facturation_t1" targetRef="P21_facturation_t2" />
