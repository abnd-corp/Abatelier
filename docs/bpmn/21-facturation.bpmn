    <bpmn:sequenceFlow id="P21_facturation_flux6" name="Oui" sourceRef="P21_facturation_g1" targetRef="P21_facturation_t5" />
    <bpmn:sequenceFlow id="P21_facturation_flux7" name="Non" sourceRef="P21_facturation_g1" targetRef="P21_facturation_t6" />
    <bpmn:sequenceFlow id="P21_facturation_flux8" sourceRef="P21_facturation_t6" targetRef="P21_facturation_t7" />
    <bpmn:sequenceFlow id="P21_facturation_flux9" sourceRef="P21_facturation_t7" targetRef="P21_facturation_t8" />
    <bpmn:sequenceFlow id="P21_facturation_flux10" sourceRef="P21_facturation_t5" targetRef="P21_facturation_g2" />
    <bpmn:sequenceFlow id="P21_facturation_flux11" sourceRef="P21_facturation_t8" targetRef="P21_facturation_g2" />
    <bpmn:sequenceFlow id="P21_facturation_flux12" name="Oui" sourceRef="P21_facturation_g2" targetRef="P21_facturation_t9" />
    <bpmn:sequenceFlow id="P21_facturation_flux13" name="Non" sourceRef="P21_facturation_g2" targetRef="P21_facturation_gj1" />
    <bpmn:sequenceFlow id="P21_facturation_flux14" sourceRef="P21_facturation_t9" targetRef="P21_facturation_gj1" />
    <bpmn:sequenceFlow id="P21_facturation_flux15" sourceRef="P21_facturation_t10" targetRef="P21_facturation_f" />
    <bpmn:sequenceFlow id="P21_facturation_flux16" sourceRef="P21_facturation_gj1" targetRef="P21_facturation_t10" />
    <bpmn:textAnnotation id="P21_facturation_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
