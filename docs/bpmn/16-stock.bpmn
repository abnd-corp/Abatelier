<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P16_stock_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P16_stock_collab">
    <bpmn:participant id="P16_stock_pool" name="Suivi du stock de feuilles" processRef="P16_stock" />
  </bpmn:collaboration>
  <bpmn:process id="P16_stock" name="Suivi du stock de feuilles" isExecutable="false">
    <bpmn:documentation>Voir ce qu’il reste, être prévenu quand le stock baisse, compter, et tenir les chutes à part des feuilles entières.</bpmn:documentation>
    <bpmn:laneSet id="P16_stock_voies">
      <bpmn:lane id="P16_stock_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P16_stock_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_stock_f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P16_stock_voie_atelier" name="Atelier">
        <bpmn:flowNodeRef>P16_stock_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_stock_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_stock_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_stock_t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P16_stock_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P16_stock_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_stock_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P16_stock_t7</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P16_stock_d" name="Besoin de savoir ce qu’il reste"><bpmn:outgoing>P16_stock_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P16_stock_t1" name="Voir les feuilles par matière, coloris, format ou état"><bpmn:documentation>Dans l’application : Atelier › Stock de feuilles (filtres, état vide / critique / bas / ok)</bpmn:documentation><bpmn:incoming>P16_stock_flux1</bpmn:incoming><bpmn:outgoing>P16_stock_flux2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P16_stock_t2" name="Notifier la direction dans la plateforme quand le stock est bas (seuil par référence, aucune alerte sur une chute)"><bpmn:documentation>Dans l’application : Seuil réglable sur chaque carte ; à ranger dans le centre de notifications</bpmn:documentation><bpmn:incoming>P16_stock_flux2</bpmn:incoming><bpmn:outgoing>P16_stock_flux3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P16_stock_t3" name="Ajuster : entrée, sortie, perte, chute récupérée"><bpmn:documentation>Dans l’application : Chaque mouvement garde qui, quand et pourquoi</bpmn:documentation><bpmn:incoming>P16_stock_flux3</bpmn:incoming><bpmn:outgoing>P16_stock_flux4</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P16_stock_t4" name="Faire l’inventaire (quantité comptée)"><bpmn:documentation>Dans l’application : Sert aussi à saisir le stock de départ</bpmn:documentation><bpmn:incoming>P16_stock_flux4</bpmn:incoming><bpmn:outgoing>P16_stock_flux5</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P16_stock_t5" name="Décompter automatiquement ce qu’une commande consomme"><bpmn:documentation>Pas encore : Décidé : au lancement, avec confirmation des chutes à la fin</bpmn:documentation><bpmn:incoming>P16_stock_flux5</bpmn:incoming><bpmn:outgoing>P16_stock_flux6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P16_stock_t6" name="Consulter l’historique des mouvements"><bpmn:documentation>Dans l’application : Stock de feuilles › Historique</bpmn:documentation><bpmn:incoming>P16_stock_flux6</bpmn:incoming><bpmn:outgoing>P16_stock_flux7</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P16_stock_t7" name="Estimer la date d’une commande selon le stock disponible"><bpmn:documentation>Pas encore : Si les feuilles manquent : délai standard + délai du fournisseur (données à recueillir)</bpmn:documentation><bpmn:incoming>P16_stock_flux7</bpmn:incoming><bpmn:outgoing>P16_stock_flux8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P16_stock_f" name="Stock à jour"><bpmn:incoming>P16_stock_flux8</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P16_stock_flux1" sourceRef="P16_stock_d" targetRef="P16_stock_t1" />
    <bpmn:sequenceFlow id="P16_stock_flux2" sourceRef="P16_stock_t1" targetRef="P16_stock_t2" />
    <bpmn:sequenceFlow id="P16_stock_flux3" sourceRef="P16_stock_t2" targetRef="P16_stock_t3" />
    <bpmn:sequenceFlow id="P16_stock_flux4" sourceRef="P16_stock_t3" targetRef="P16_stock_t4" />
    <bpmn:sequenceFlow id="P16_stock_flux5" sourceRef="P16_stock_t4" targetRef="P16_stock_t5" />
    <bpmn:sequenceFlow id="P16_stock_flux6" sourceRef="P16_stock_t5" targetRef="P16_stock_t6" />
    <bpmn:sequenceFlow id="P16_stock_flux7" sourceRef="P16_stock_t6" targetRef="P16_stock_t7" />
    <bpmn:sequenceFlow id="P16_stock_flux8" sourceRef="P16_stock_t7" targetRef="P16_stock_f" />
    <bpmn:textAnnotation id="P16_stock_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P16_stock_diagram">
    <bpmndi:BPMNPlane id="P16_stock_plane" bpmnElement="P16_stock_collab">
      <bpmndi:BPMNShape id="P16_stock_pool_di" bpmnElement="P16_stock_pool" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="1820" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P16_stock_voie_direction_di" bpmnElement="P16_stock_voie_direction" isHorizontal="true">
