<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P14_materiaux_gestion_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P14_materiaux_gestion_collab">
    <bpmn:participant id="P14_materiaux_gestion_pool" name="Faire vivre les références de feuilles (facultatif)" processRef="P14_materiaux_gestion" />
  </bpmn:collaboration>
  <bpmn:process id="P14_materiaux_gestion" name="Faire vivre les références de feuilles (facultatif)" isExecutable="false">
    <bpmn:documentation>Ce qui n’est pas nécessaire pour qu’une référence soit prête : ajouter ou retirer des codes-barres, archiver une référence qui n’est plus utilisée, importer un fichier.</bpmn:documentation>
    <bpmn:laneSet id="P14_materiaux_gestion_voies">
      <bpmn:lane id="P14_materiaux_gestion_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P14_materiaux_gestion_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_materiaux_gestion_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_materiaux_gestion_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_materiaux_gestion_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_materiaux_gestion_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P14_materiaux_gestion_f</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P14_materiaux_gestion_d" name="Une référence change ou n’est plus utilisée"><bpmn:outgoing>P14_materiaux_gestion_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="P14_materiaux_gestion_g1" name="Que faire ?"><bpmn:incoming>P14_materiaux_gestion_flux1</bpmn:incoming><bpmn:outgoing>P14_materiaux_gestion_flux2</bpmn:outgoing><bpmn:outgoing>P14_materiaux_gestion_flux3</bpmn:outgoing><bpmn:outgoing>P14_materiaux_gestion_flux4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P14_materiaux_gestion_t1" name="Ajouter ou retirer des codes-barres, chercher une référence"><bpmn:documentation>Dans l’application : Plusieurs codes possibles pour une référence ; scan ou saisie</bpmn:documentation><bpmn:incoming>P14_materiaux_gestion_flux2</bpmn:incoming><bpmn:outgoing>P14_materiaux_gestion_flux5</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P14_materiaux_gestion_t2" name="Archiver une référence qui n’est plus utilisée"><bpmn:documentation>Dans l’application : Jamais supprimée : l’historique s’y rapporte ; possible seulement à zéro</bpmn:documentation><bpmn:incoming>P14_materiaux_gestion_flux3</bpmn:incoming><bpmn:outgoing>P14_materiaux_gestion_flux6</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P14_materiaux_gestion_t3" name="Importer toutes les références d’un coup (fichier)"><bpmn:documentation>Pas encore : Décidé : plus tard</bpmn:documentation><bpmn:incoming>P14_materiaux_gestion_flux4</bpmn:incoming><bpmn:outgoing>P14_materiaux_gestion_flux7</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P14_materiaux_gestion_f" name="Références à jour"><bpmn:incoming>P14_materiaux_gestion_flux5</bpmn:incoming><bpmn:incoming>P14_materiaux_gestion_flux6</bpmn:incoming><bpmn:incoming>P14_materiaux_gestion_flux7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P14_materiaux_gestion_flux1" sourceRef="P14_materiaux_gestion_d" targetRef="P14_materiaux_gestion_g1" />
    <bpmn:sequenceFlow id="P14_materiaux_gestion_flux2" name="Codes-barres" sourceRef="P14_materiaux_gestion_g1" targetRef="P14_materiaux_gestion_t1" />
    <bpmn:sequenceFlow id="P14_materiaux_gestion_flux3" name="Archiver" sourceRef="P14_materiaux_gestion_g1" targetRef="P14_materiaux_gestion_t2" />
    <bpmn:sequenceFlow id="P14_materiaux_gestion_flux4" name="Importer" sourceRef="P14_materiaux_gestion_g1" targetRef="P14_materiaux_gestion_t3" />
    <bpmn:sequenceFlow id="P14_materiaux_gestion_flux5" sourceRef="P14_materiaux_gestion_t1" targetRef="P14_materiaux_gestion_f" />
    <bpmn:sequenceFlow id="P14_materiaux_gestion_flux6" sourceRef="P14_materiaux_gestion_t2" targetRef="P14_materiaux_gestion_f" />
    <bpmn:sequenceFlow id="P14_materiaux_gestion_flux7" sourceRef="P14_materiaux_gestion_t3" targetRef="P14_materiaux_gestion_f" />
    <bpmn:textAnnotation id="P14_materiaux_gestion_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
