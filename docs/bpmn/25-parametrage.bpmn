<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P25_parametrage_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P25_parametrage_collab">
    <bpmn:participant id="P25_parametrage_pool" name="Paramétrage par la direction" processRef="P25_parametrage" />
  </bpmn:collaboration>
  <bpmn:process id="P25_parametrage" name="Paramétrage par la direction" isExecutable="false">
    <bpmn:documentation>Tarifs, catalogue, documents : ce que la direction règle sans développeur, en gardant simple ce qui change souvent.</bpmn:documentation>
    <bpmn:laneSet id="P25_parametrage_voies">
      <bpmn:lane id="P25_parametrage_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P25_parametrage_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_parametrage_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_parametrage_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_parametrage_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_parametrage_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_parametrage_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_parametrage_f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P25_parametrage_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P25_parametrage_t6</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P25_parametrage_d" name="Un prix ou une règle change"><bpmn:outgoing>P25_parametrage_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P25_parametrage_t1" name="Régler matières, coloris, façonnage, accessoires, livraison"><bpmn:documentation>Dans l’application : Tarifs et catalogue (désactivable sans effacer) ; prix de la boutique en TTC, du sur-mesure en HT</bpmn:documentation><bpmn:incoming>P25_parametrage_flux1</bpmn:incoming><bpmn:outgoing>P25_parametrage_flux2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P25_parametrage_t2" name="Régler les limites de pliage et les modèles de pièces"><bpmn:documentation>Dans l’application : Catalogue › Modèles de pièces</bpmn:documentation><bpmn:incoming>P25_parametrage_flux2</bpmn:incoming><bpmn:outgoing>P25_parametrage_flux3</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P25_parametrage_t3" name="Régler l’entreprise, le modèle des documents, la numérotation"><bpmn:documentation>Dans l’application : Modèles de documents (la numérotation se verrouille au premier document)</bpmn:documentation><bpmn:incoming>P25_parametrage_flux3</bpmn:incoming><bpmn:outgoing>P25_parametrage_flux4</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P25_parametrage_t4" name="Régler les limites par matière, la quantité maximale et le délai selon la quantité"><bpmn:documentation>Pas encore : En attente des données des machines de l’atelier</bpmn:documentation><bpmn:incoming>P25_parametrage_flux4</bpmn:incoming><bpmn:outgoing>P25_parametrage_flux5</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P25_parametrage_t5" name="Déclarer les jours fériés et les fermetures"><bpmn:documentation>Pas encore : Le délai annoncé saute les week-ends, pas les jours fériés</bpmn:documentation><bpmn:incoming>P25_parametrage_flux5</bpmn:incoming><bpmn:outgoing>P25_parametrage_flux6</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P25_parametrage_t6" name="Appliquer tout de suite aux prochains devis, commandes et au site"><bpmn:documentation>Dans l’application : Les documents déjà émis ne changent pas</bpmn:documentation><bpmn:incoming>P25_parametrage_flux6</bpmn:incoming><bpmn:outgoing>P25_parametrage_flux7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P25_parametrage_f" name="Réglage en place"><bpmn:incoming>P25_parametrage_flux7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P25_parametrage_flux1" sourceRef="P25_parametrage_d" targetRef="P25_parametrage_t1" />
    <bpmn:sequenceFlow id="P25_parametrage_flux2" sourceRef="P25_parametrage_t1" targetRef="P25_parametrage_t2" />
    <bpmn:sequenceFlow id="P25_parametrage_flux3" sourceRef="P25_parametrage_t2" targetRef="P25_parametrage_t3" />
    <bpmn:sequenceFlow id="P25_parametrage_flux4" sourceRef="P25_parametrage_t3" targetRef="P25_parametrage_t4" />
    <bpmn:sequenceFlow id="P25_parametrage_flux5" sourceRef="P25_parametrage_t4" targetRef="P25_parametrage_t5" />
    <bpmn:sequenceFlow id="P25_parametrage_flux6" sourceRef="P25_parametrage_t5" targetRef="P25_parametrage_t6" />
    <bpmn:sequenceFlow id="P25_parametrage_flux7" sourceRef="P25_parametrage_t6" targetRef="P25_parametrage_f" />
    <bpmn:textAnnotation id="P25_parametrage_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P25_parametrage_diagram">
    <bpmndi:BPMNPlane id="P25_parametrage_plane" bpmnElement="P25_parametrage_collab">
      <bpmndi:BPMNShape id="P25_parametrage_pool_di" bpmnElement="P25_parametrage_pool" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="1630" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P25_parametrage_voie_direction_di" bpmnElement="P25_parametrage_voie_direction" isHorizontal="true">
        <dc:Bounds x="70" y="40" width="1600" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P25_parametrage_voie_systeme_di" bpmnElement="P25_parametrage_voie_systeme" isHorizontal="true">
        <dc:Bounds x="70" y="160" width="1600" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P25_parametrage_d_di" bpmnElement="P25_parametrage_d">
        <dc:Bounds x="197" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P25_parametrage_t1_di" bpmnElement="P25_parametrage_t1" bioc:stroke="#2e7d32" bioc:fill="#d8f0dc">
        <dc:Bounds x="330" y="60" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P25_parametrage_t2_di" bpmnElement="P25_parametrage_t2" bioc:stroke="#2e7d32" bioc:fill="#d8f0dc">
        <dc:Bounds x="520" y="60" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P25_parametrage_t3_di" bpmnElement="P25_parametrage_t3" bioc:stroke="#2e7d32" bioc:fill="#d8f0dc">
        <dc:Bounds x="710" y="60" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P25_parametrage_t4_di" bpmnElement="P25_parametrage_t4" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="900" y="60" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P25_parametrage_t5_di" bpmnElement="P25_parametrage_t5" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="1090" y="60" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P25_parametrage_t6_di" bpmnElement="P25_parametrage_t6" bioc:stroke="#2e7d32" bioc:fill="#d8f0dc">
        <dc:Bounds x="1280" y="180" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P25_parametrage_f_di" bpmnElement="P25_parametrage_f">
        <dc:Bounds x="1527" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P25_parametrage_flux1_di" bpmnElement="P25_parametrage_flux1">
        <di:waypoint x="233" y="100" />
        <di:waypoint x="330" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P25_parametrage_flux2_di" bpmnElement="P25_parametrage_flux2">
        <di:waypoint x="480" y="100" />
        <di:waypoint x="520" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P25_parametrage_flux3_di" bpmnElement="P25_parametrage_flux3">
        <di:waypoint x="670" y="100" />
        <di:waypoint x="710" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P25_parametrage_flux4_di" bpmnElement="P25_parametrage_flux4">
        <di:waypoint x="860" y="100" />
        <di:waypoint x="900" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P25_parametrage_flux5_di" bpmnElement="P25_parametrage_flux5">
        <di:waypoint x="1050" y="100" />
        <di:waypoint x="1090" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P25_parametrage_flux6_di" bpmnElement="P25_parametrage_flux6">
        <di:waypoint x="1240" y="100" />
        <di:waypoint x="1255" y="100" />
        <di:waypoint x="1255" y="220" />
        <di:waypoint x="1280" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P25_parametrage_flux7_di" bpmnElement="P25_parametrage_flux7">
        <di:waypoint x="1430" y="220" />
        <di:waypoint x="1502" y="220" />
        <di:waypoint x="1502" y="100" />
        <di:waypoint x="1527" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="P25_parametrage_legende_di" bpmnElement="P25_parametrage_legende">
        <dc:Bounds x="70" y="300" width="760" height="30" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
