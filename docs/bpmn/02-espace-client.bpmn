<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P2_espace_client_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P2_espace_client_collab">
    <bpmn:participant id="P2_espace_client_pool" name="Espace client : création, activation, mot de passe, fermeture" processRef="P2_espace_client" />
  </bpmn:collaboration>
  <bpmn:process id="P2_espace_client" name="Espace client : création, activation, mot de passe, fermeture" isExecutable="false">
    <bpmn:documentation>Création de l’espace d’un particulier ou d’un professionnel, activation sur une fiche existante, mot de passe oublié, vérification automatique du statut pro auprès de l’annuaire officiel, fermeture.</bpmn:documentation>
    <bpmn:laneSet id="P2_espace_client_voies">
      <bpmn:lane id="P2_espace_client_voie_client" name="Visiteur / Client">
        <bpmn:flowNodeRef>P2_espace_client_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_t12</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_t13</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_gj3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_espace_client_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P2_espace_client_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_t11</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_t14</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_gs1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_gj2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_espace_client_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P2_espace_client_t8b</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P2_espace_client_d" name="Le visiteur veut commander ou suivre une commande"><bpmn:outgoing>P2_espace_client_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P2_espace_client_t1" name="Créer son espace (particulier ou professionnel, consentement)"><bpmn:documentation>Dans l’application : Site public › Créer mon espace client</bpmn:documentation><bpmn:incoming>P2_espace_client_flux1</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux2</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P2_espace_client_g1" name="Adresse déjà connue de l’atelier ?"><bpmn:incoming>P2_espace_client_flux2</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux3</bpmn:outgoing><bpmn:outgoing>P2_espace_client_flux4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P2_espace_client_t2" name="Créer l’espace et la fiche, ouvrir la session"><bpmn:documentation>Dans l’application : Mot de passe contrôlé (12 caractères, pas de mot de passe courant)</bpmn:documentation><bpmn:incoming>P2_espace_client_flux3</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P2_espace_client_t3" name="Envoyer le message de bienvenue"><bpmn:documentation>Dans l’application : Sans publicité : seulement les messages utiles au compte</bpmn:documentation><bpmn:incoming>P2_espace_client_flux5</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P2_espace_client_t4" name="Envoyer un lien d’activation à l’adresse de la fiche existante"><bpmn:documentation>Dans l’application : Valable 7 jours, usage unique ; une adresse déjà active ne peut pas être réclamée</bpmn:documentation><bpmn:incoming>P2_espace_client_flux4</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P2_espace_client_t5" name="Choisir son mot de passe avec le lien reçu"><bpmn:documentation>Dans l’application : Seul le propriétaire de l’adresse peut le faire</bpmn:documentation><bpmn:incoming>P2_espace_client_flux7</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux8</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P2_espace_client_t6" name="Rattacher l’espace à la fiche existante, ouvrir la session"><bpmn:documentation>Dans l’application : Aucun doublon : ses devis et factures y sont déjà</bpmn:documentation><bpmn:incoming>P2_espace_client_flux8</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P2_espace_client_g2" name="Professionnel ?"><bpmn:incoming>P2_espace_client_flux6</bpmn:incoming><bpmn:incoming>P2_espace_client_flux9</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux10</bpmn:outgoing><bpmn:outgoing>P2_espace_client_flux11</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P2_espace_client_t7" name="Compléter « Mes informations » (SIRET, TVA, adresse de facturation)"><bpmn:documentation>Dans l’application : Espace client › Mes informations</bpmn:documentation><bpmn:incoming>P2_espace_client_flux10</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux12</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P2_espace_client_t8" name="Vérifier le SIRET dans l’annuaire officiel des entreprises (en activité, nom concordant)"><bpmn:documentation>Pas encore : Annuaire public et gratuit (recherche-entreprises.api.gouv.fr) ; le n° de TVA se contrôle avec VIES. Aujourd’hui la direction vérifie à la main</bpmn:documentation><bpmn:incoming>P2_espace_client_flux12</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux22</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P2_espace_client_t8b" name="Examiner à la main seulement si la vérification échoue"><bpmn:documentation>Dans l’application : Clients › fiche › Valider le statut professionnel (exception)</bpmn:documentation><bpmn:incoming>P2_espace_client_flux24</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux13</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P2_espace_client_t9" name="Appliquer la remise professionnelle aux devis suivants"><bpmn:documentation>Dans l’application : Seulement après validation</bpmn:documentation><bpmn:incoming>P2_espace_client_flux25</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P2_espace_client_t10" name="Retrouver ses devis, commandes et factures"><bpmn:documentation>Dans l’application : Espace client</bpmn:documentation><bpmn:incoming>P2_espace_client_flux26</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux15</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P2_espace_client_g3" name="Mot de passe oublié ?"><bpmn:incoming>P2_espace_client_flux15</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux16</bpmn:outgoing><bpmn:outgoing>P2_espace_client_flux19</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P2_espace_client_t11" name="Envoyer un lien valable 1 heure pour choisir un nouveau mot de passe"><bpmn:documentation>Dans l’application : Réponse identique que l’adresse existe ou non</bpmn:documentation><bpmn:incoming>P2_espace_client_flux16</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux17</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P2_espace_client_t12" name="Choisir un nouveau mot de passe"><bpmn:documentation>Dans l’application : Déconnecte les autres appareils et prévient le client par e-mail</bpmn:documentation><bpmn:incoming>P2_espace_client_flux17</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux18</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P2_espace_client_t13" name="Fermer son espace (mot de passe demandé)"><bpmn:documentation>Dans l’application : Espace client › Fermer mon espace</bpmn:documentation><bpmn:incoming>P2_espace_client_flux19</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux20</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P2_espace_client_t14" name="Anonymiser la fiche, garder les factures, libérer l’adresse"><bpmn:documentation>Dans l’application : Les factures sont conservées 10 ans (obligation légale)</bpmn:documentation><bpmn:incoming>P2_espace_client_flux20</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux21</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P2_espace_client_f" name="Espace fermé"><bpmn:incoming>P2_espace_client_flux21</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="P2_espace_client_gs1" name="SIRET concordant ?"><bpmn:incoming>P2_espace_client_flux22</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux23</bpmn:outgoing><bpmn:outgoing>P2_espace_client_flux24</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P2_espace_client_gj2" name=""><bpmn:incoming>P2_espace_client_flux13</bpmn:incoming><bpmn:incoming>P2_espace_client_flux23</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux25</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P2_espace_client_gj3" name=""><bpmn:incoming>P2_espace_client_flux11</bpmn:incoming><bpmn:incoming>P2_espace_client_flux14</bpmn:incoming><bpmn:incoming>P2_espace_client_flux18</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux26</bpmn:outgoing></bpmn:exclusiveGateway>
