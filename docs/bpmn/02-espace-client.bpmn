    <bpmn:sequenceFlow id="P2_espace_client_flux9" sourceRef="P2_espace_client_t6" targetRef="P2_espace_client_t7" />
    <bpmn:sequenceFlow id="P2_espace_client_flux10" sourceRef="P2_espace_client_t7" targetRef="P2_espace_client_g2" />
    <bpmn:sequenceFlow id="P2_espace_client_flux11" name="Oui" sourceRef="P2_espace_client_g2" targetRef="P2_espace_client_t8" />
    <bpmn:sequenceFlow id="P2_espace_client_flux12" sourceRef="P2_espace_client_t8" targetRef="P2_espace_client_t7" />
    <bpmn:sequenceFlow id="P2_espace_client_flux13" name="Non" sourceRef="P2_espace_client_g2" targetRef="P2_espace_client_t9" />
    <bpmn:sequenceFlow id="P2_espace_client_flux14" sourceRef="P2_espace_client_t9" targetRef="P2_espace_client_t10" />
    <bpmn:sequenceFlow id="P2_espace_client_flux15" sourceRef="P2_espace_client_t10" targetRef="P2_espace_client_f" />
    <bpmn:textAnnotation id="P2_espace_client_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
