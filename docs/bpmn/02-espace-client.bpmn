<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P2_espace_client_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P2_espace_client_collab">
    <bpmn:participant id="P2_espace_client_pool" name="Espace client : inscription, accès, fermeture" processRef="P2_espace_client" />
  </bpmn:collaboration>
  <bpmn:process id="P2_espace_client" name="Espace client : inscription, accès, fermeture" isExecutable="false">
    <bpmn:documentation>Création du compte d’un particulier ou d’un professionnel, validation du statut pro, fermeture du compte.</bpmn:documentation>
    <bpmn:laneSet id="P2_espace_client_voies">
      <bpmn:lane id="P2_espace_client_voie_client" name="Visiteur / Client">
        <bpmn:flowNodeRef>P2_espace_client_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_espace_client_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P2_espace_client_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P2_espace_client_t10</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P2_espace_client_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P2_espace_client_t5</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P2_espace_client_d" name="Le visiteur veut commander ou suivre une commande"><bpmn:outgoing>P2_espace_client_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P2_espace_client_t1" name="Créer son espace (particulier ou professionnel, consentement)"><bpmn:documentation>Dans l’application : Site public › Créer mon espace client</bpmn:documentation><bpmn:incoming>P2_espace_client_flux1</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P2_espace_client_t2" name="Créer le compte et la fiche client, ouvrir la session"><bpmn:documentation>Dans l’application : Mot de passe contrôlé (12 caractères, pas de mot de passe courant)</bpmn:documentation><bpmn:incoming>P2_espace_client_flux2</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P2_espace_client_t3" name="Confirmer l’adresse e-mail"><bpmn:documentation>Pas encore : Prévu (M6) : lien de confirmation envoyé par e-mail</bpmn:documentation><bpmn:incoming>P2_espace_client_flux3</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P2_espace_client_g1" name="Professionnel ?"><bpmn:incoming>P2_espace_client_flux4</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux5</bpmn:outgoing><bpmn:outgoing>P2_espace_client_flux6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P2_espace_client_t4" name="Compléter « Mes informations » (SIRET, TVA, adresse de facturation)"><bpmn:documentation>Dans l’application : Espace client › Mes informations</bpmn:documentation><bpmn:incoming>P2_espace_client_flux5</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux7</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P2_espace_client_t5" name="Vérifier puis valider le statut professionnel"><bpmn:documentation>Dans l’application : Clients › fiche › Valider le statut professionnel</bpmn:documentation><bpmn:incoming>P2_espace_client_flux7</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux8</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P2_espace_client_t6" name="Appliquer la remise professionnelle aux devis suivants"><bpmn:documentation>Dans l’application : Seulement après validation</bpmn:documentation><bpmn:incoming>P2_espace_client_flux8</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P2_espace_client_t7" name="Retrouver ses devis, commandes et factures"><bpmn:documentation>Dans l’application : Espace client</bpmn:documentation><bpmn:incoming>P2_espace_client_flux6</bpmn:incoming><bpmn:incoming>P2_espace_client_flux9</bpmn:incoming><bpmn:incoming>P2_espace_client_flux12</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux10</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P2_espace_client_g2" name="Mot de passe oublié ?"><bpmn:incoming>P2_espace_client_flux10</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux11</bpmn:outgoing><bpmn:outgoing>P2_espace_client_flux13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P2_espace_client_t8" name="Envoyer un lien pour choisir un nouveau mot de passe"><bpmn:documentation>Pas encore : Prévu (M6)</bpmn:documentation><bpmn:incoming>P2_espace_client_flux11</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux12</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P2_espace_client_t9" name="Fermer son espace (mot de passe demandé)"><bpmn:documentation>Dans l’application : Espace client › Fermer mon espace</bpmn:documentation><bpmn:incoming>P2_espace_client_flux13</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux14</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P2_espace_client_t10" name="Anonymiser la fiche, garder les factures, libérer l’adresse"><bpmn:documentation>Dans l’application : Les factures sont conservées 10 ans (obligation légale)</bpmn:documentation><bpmn:incoming>P2_espace_client_flux14</bpmn:incoming><bpmn:outgoing>P2_espace_client_flux15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P2_espace_client_f" name="Espace fermé"><bpmn:incoming>P2_espace_client_flux15</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P2_espace_client_flux1" sourceRef="P2_espace_client_d" targetRef="P2_espace_client_t1" />
    <bpmn:sequenceFlow id="P2_espace_client_flux2" sourceRef="P2_espace_client_t1" targetRef="P2_espace_client_t2" />
    <bpmn:sequenceFlow id="P2_espace_client_flux3" sourceRef="P2_espace_client_t2" targetRef="P2_espace_client_t3" />
    <bpmn:sequenceFlow id="P2_espace_client_flux4" sourceRef="P2_espace_client_t3" targetRef="P2_espace_client_g1" />
    <bpmn:sequenceFlow id="P2_espace_client_flux5" name="Oui" sourceRef="P2_espace_client_g1" targetRef="P2_espace_client_t4" />
    <bpmn:sequenceFlow id="P2_espace_client_flux6" name="Non" sourceRef="P2_espace_client_g1" targetRef="P2_espace_client_t7" />
    <bpmn:sequenceFlow id="P2_espace_client_flux7" sourceRef="P2_espace_client_t4" targetRef="P2_espace_client_t5" />
