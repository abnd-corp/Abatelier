    <bpmn:sequenceFlow id="P18_reception_flux10" sourceRef="P18_reception_t5b" targetRef="P18_reception_g2" />
    <bpmn:sequenceFlow id="P18_reception_flux11" name="Oui" sourceRef="P18_reception_g2" targetRef="P18_reception_t6" />
    <bpmn:sequenceFlow id="P18_reception_flux12" sourceRef="P18_reception_t6" targetRef="P18_reception_t2" />
    <bpmn:sequenceFlow id="P18_reception_flux13" name="Non" sourceRef="P18_reception_g2" targetRef="P18_reception_g3" />
    <bpmn:sequenceFlow id="P18_reception_flux14" name="Oui" sourceRef="P18_reception_g3" targetRef="P18_reception_t10" />
    <bpmn:sequenceFlow id="P18_reception_flux15" name="Non" sourceRef="P18_reception_g3" targetRef="P18_reception_t9" />
    <bpmn:sequenceFlow id="P18_reception_flux16" sourceRef="P18_reception_t10" targetRef="P18_reception_f" />
    <bpmn:sequenceFlow id="P18_reception_flux17" sourceRef="P18_reception_t9" targetRef="P18_reception_t8" />
    <bpmn:sequenceFlow id="P18_reception_flux18" sourceRef="P18_reception_t8" targetRef="P18_reception_f2" />
    <bpmn:textAnnotation id="P18_reception_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
