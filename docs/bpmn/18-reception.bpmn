<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P18_reception_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P18_reception_collab">
    <bpmn:participant id="P18_reception_pool" name="Réception de marchandise au scan" processRef="P18_reception" />
  </bpmn:collaboration>
  <bpmn:process id="P18_reception" name="Réception de marchandise au scan" isExecutable="false">
    <bpmn:documentation>L’atelier reçoit des feuilles : il scanne le code-barres d’une feuille et indique, sur la plateforme, le nombre reçu. Le stock monte et la réception est comparée à la commande passée au fournisseur. Elle peut être suspendue et reprise au camion suivant.</bpmn:documentation>
    <bpmn:laneSet id="P18_reception_voies">
      <bpmn:lane id="P18_reception_voie_atelier" name="Atelier">
        <bpmn:flowNodeRef>P18_reception_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_reception_t0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_reception_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_reception_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_reception_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_reception_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_reception_g2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_reception_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_reception_t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_reception_f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_reception_f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P18_reception_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P18_reception_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_reception_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_reception_t5b</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_reception_g3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_reception_t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_reception_t9</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P18_reception_d" name="Un camion de feuilles arrive"><bpmn:outgoing>P18_reception_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P18_reception_t0" name="Ouvrir la commande fournisseur attendue"><bpmn:documentation>Pas encore : Reprend aussi une réception laissée en attente</bpmn:documentation><bpmn:incoming>P18_reception_flux1</bpmn:incoming><bpmn:outgoing>P18_reception_flux2</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="P18_reception_t1" name="Décharger et contrôler la livraison"><bpmn:documentation>Hors application : Contrôle sur place</bpmn:documentation><bpmn:incoming>P18_reception_flux2</bpmn:incoming><bpmn:outgoing>P18_reception_flux3</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="P18_reception_t2" name="Scanner le code-barres d’une feuille (caméra du téléphone) ou le saisir"><bpmn:documentation>Dans l’application : Atelier › Réception ; la caméra demande une connexion sécurisée (HTTPS)</bpmn:documentation><bpmn:incoming>P18_reception_flux3</bpmn:incoming><bpmn:incoming>P18_reception_flux12</bpmn:incoming><bpmn:outgoing>P18_reception_flux4</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P18_reception_g1" name="Code reconnu ?"><bpmn:incoming>P18_reception_flux4</bpmn:incoming><bpmn:outgoing>P18_reception_flux5</bpmn:outgoing><bpmn:outgoing>P18_reception_flux6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P18_reception_t3" name="Associer le code à une référence ou en créer une"><bpmn:documentation>Dans l’application : Le code est reconnu aux réceptions suivantes</bpmn:documentation><bpmn:incoming>P18_reception_flux6</bpmn:incoming><bpmn:outgoing>P18_reception_flux7</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P18_reception_t4" name="Indiquer le nombre de feuilles reçues et une note (bon de livraison)"><bpmn:documentation>Dans l’application : Un code = une feuille ; on scanne une fois et on indique la quantité</bpmn:documentation><bpmn:incoming>P18_reception_flux5</bpmn:incoming><bpmn:incoming>P18_reception_flux7</bpmn:incoming><bpmn:outgoing>P18_reception_flux8</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P18_reception_t5" name="Augmenter le stock et tracer l’entrée (qui, quand, quelle note)"><bpmn:documentation>Dans l’application : Dernières réceptions affichées à côté</bpmn:documentation><bpmn:incoming>P18_reception_flux8</bpmn:incoming><bpmn:outgoing>P18_reception_flux9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P18_reception_t5b" name="Comparer à la commande : ce qui reste à recevoir"><bpmn:documentation>Pas encore : Dépend de « Commande de feuilles au fournisseur »</bpmn:documentation><bpmn:incoming>P18_reception_flux9</bpmn:incoming><bpmn:outgoing>P18_reception_flux10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P18_reception_g2" name="Autre feuille à scanner ?"><bpmn:incoming>P18_reception_flux10</bpmn:incoming><bpmn:outgoing>P18_reception_flux11</bpmn:outgoing><bpmn:outgoing>P18_reception_flux13</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P18_reception_t6" name="Passer au code suivant"><bpmn:documentation>Dans l’application : La caméra est prête pour la feuille suivante</bpmn:documentation><bpmn:incoming>P18_reception_flux11</bpmn:incoming><bpmn:outgoing>P18_reception_flux12</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P18_reception_g3" name="Tout ce qui était commandé est arrivé ?"><bpmn:incoming>P18_reception_flux13</bpmn:incoming><bpmn:outgoing>P18_reception_flux14</bpmn:outgoing><bpmn:outgoing>P18_reception_flux15</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P18_reception_t10" name="Clore la commande fournisseur"><bpmn:documentation>Pas encore : Les feuilles attendues disparaissent de « en commande »</bpmn:documentation><bpmn:incoming>P18_reception_flux14</bpmn:incoming><bpmn:outgoing>P18_reception_flux16</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P18_reception_t9" name="Notifier la direction de l’écart (manque ou surplus)"><bpmn:documentation>Pas encore : Notification dans la plateforme</bpmn:documentation><bpmn:incoming>P18_reception_flux15</bpmn:incoming><bpmn:outgoing>P18_reception_flux17</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P18_reception_t8" name="Suspendre la réception, la reprendre au camion suivant"><bpmn:documentation>Pas encore : Livraison en plusieurs camions : on sort de la réception sans perdre ce qui est scanné</bpmn:documentation><bpmn:incoming>P18_reception_flux17</bpmn:incoming><bpmn:outgoing>P18_reception_flux18</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P18_reception_f" name="Livraison enregistrée"><bpmn:incoming>P18_reception_flux16</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P18_reception_f2" name="Réception en attente du prochain camion"><bpmn:incoming>P18_reception_flux18</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P18_reception_flux1" sourceRef="P18_reception_d" targetRef="P18_reception_t0" />
    <bpmn:sequenceFlow id="P18_reception_flux2" sourceRef="P18_reception_t0" targetRef="P18_reception_t1" />
    <bpmn:sequenceFlow id="P18_reception_flux3" sourceRef="P18_reception_t1" targetRef="P18_reception_t2" />
    <bpmn:sequenceFlow id="P18_reception_flux4" sourceRef="P18_reception_t2" targetRef="P18_reception_g1" />
    <bpmn:sequenceFlow id="P18_reception_flux5" name="Oui" sourceRef="P18_reception_g1" targetRef="P18_reception_t4" />
    <bpmn:sequenceFlow id="P18_reception_flux6" name="Non" sourceRef="P18_reception_g1" targetRef="P18_reception_t3" />
    <bpmn:sequenceFlow id="P18_reception_flux7" sourceRef="P18_reception_t3" targetRef="P18_reception_t4" />
    <bpmn:sequenceFlow id="P18_reception_flux8" sourceRef="P18_reception_t4" targetRef="P18_reception_t5" />
