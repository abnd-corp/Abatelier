        <dc:Bounds x="520" y="180" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P4_code_client_t3_di" bpmnElement="P4_code_client_t3" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="710" y="60" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P4_code_client_t4_di" bpmnElement="P4_code_client_t4" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="900" y="180" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P4_code_client_t5_di" bpmnElement="P4_code_client_t5" bioc:stroke="#2e7d32" bioc:fill="#d8f0dc">
        <dc:Bounds x="1090" y="60" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P4_code_client_f_di" bpmnElement="P4_code_client_f">
        <dc:Bounds x="1337" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P4_code_client_flux1_di" bpmnElement="P4_code_client_flux1">
        <di:waypoint x="233" y="100" />
        <di:waypoint x="305" y="100" />
        <di:waypoint x="305" y="220" />
        <di:waypoint x="330" y="220" />
      </bpmndi:BPMNEdge>
