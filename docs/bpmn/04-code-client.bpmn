        <di:waypoint x="480" y="220" />
        <di:waypoint x="520" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P4_code_client_flux3_di" bpmnElement="P4_code_client_flux3">
        <di:waypoint x="670" y="220" />
        <di:waypoint x="685" y="220" />
