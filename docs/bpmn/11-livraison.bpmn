<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P11_livraison_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P11_livraison_collab">
    <bpmn:participant id="P11_livraison_pool" name="Livraison et retrait" processRef="P11_livraison" />
  </bpmn:collaboration>
  <bpmn:process id="P11_livraison" name="Livraison et retrait" isExecutable="false">
    <bpmn:documentation>La commande prête est retirée à l’atelier ou livrée sur chantier. Le client prouve qu’il l’a reçue avec un code (à valider avec le client) : la remise lance ensuite la facture.</bpmn:documentation>
    <bpmn:laneSet id="P11_livraison_voies">
      <bpmn:lane id="P11_livraison_voie_atelier" name="Atelier">
        <bpmn:flowNodeRef>P11_livraison_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_livraison_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_livraison_f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P11_livraison_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P11_livraison_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_livraison_t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P11_livraison_voie_client" name="Visiteur / Client">
        <bpmn:flowNodeRef>P11_livraison_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_livraison_t6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P11_livraison_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P11_livraison_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_livraison_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P11_livraison_t4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P11_livraison_d" name="Commande prête"><bpmn:outgoing>P11_livraison_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P11_livraison_t5" name="Donner au client un code de remise, dans son espace et par e-mail"><bpmn:documentation>Pas encore : À définir avec le client : un code que le client donne au livreur ou à l’atelier, une signature sur écran, ou la simple confirmation du livreur</bpmn:documentation><bpmn:incoming>P11_livraison_flux1</bpmn:incoming><bpmn:outgoing>P11_livraison_flux2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P11_livraison_g1" name="Retrait ou livraison ?"><bpmn:incoming>P11_livraison_flux2</bpmn:incoming><bpmn:outgoing>P11_livraison_flux3</bpmn:outgoing><bpmn:outgoing>P11_livraison_flux4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P11_livraison_t1" name="Venir chercher la commande à l’atelier"><bpmn:documentation>Hors application : Le mode « retrait » est choisi à la commande</bpmn:documentation><bpmn:incoming>P11_livraison_flux3</bpmn:incoming><bpmn:outgoing>P11_livraison_flux8</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P11_livraison_t2" name="Fournir l’adresse, la distance et les frais de livraison"><bpmn:documentation>Dans l’application : Calculés à la commande (distance par la route)</bpmn:documentation><bpmn:incoming>P11_livraison_flux4</bpmn:incoming><bpmn:outgoing>P11_livraison_flux5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:manualTask id="P11_livraison_t3" name="Planifier la tournée et livrer sur chantier"><bpmn:documentation>Pas encore : Pas de planning de tournées dans l’application ; la manière de livrer aujourd’hui est à recueillir</bpmn:documentation><bpmn:incoming>P11_livraison_flux5</bpmn:incoming><bpmn:outgoing>P11_livraison_flux6</bpmn:outgoing></bpmn:manualTask>
    <bpmn:serviceTask id="P11_livraison_t4" name="Éditer le bon de livraison"><bpmn:documentation>Pas encore : Prévu : nouveau type de document</bpmn:documentation><bpmn:incoming>P11_livraison_flux6</bpmn:incoming><bpmn:outgoing>P11_livraison_flux7</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P11_livraison_t6" name="Confirmer la réception (en donnant son code ou en signant)"><bpmn:documentation>Pas encore : Le client prévient lui-même que tout est arrivé</bpmn:documentation><bpmn:incoming>P11_livraison_flux7</bpmn:incoming><bpmn:incoming>P11_livraison_flux8</bpmn:incoming><bpmn:outgoing>P11_livraison_flux9</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P11_livraison_t7" name="Marquer la commande retirée ou livrée"><bpmn:documentation>Dans l’application : Le bouton dit « Marquer retirée » ou « Marquer livrée » selon le mode ; elle quitte Fabrication. Avec le code, ce geste peut devenir automatique</bpmn:documentation><bpmn:incoming>P11_livraison_flux9</bpmn:incoming><bpmn:outgoing>P11_livraison_flux10</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P11_livraison_f" name="Commande remise : la facturation démarre, voir « Facturation »"><bpmn:incoming>P11_livraison_flux10</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P11_livraison_flux1" sourceRef="P11_livraison_d" targetRef="P11_livraison_t5" />
    <bpmn:sequenceFlow id="P11_livraison_flux2" sourceRef="P11_livraison_t5" targetRef="P11_livraison_g1" />
    <bpmn:sequenceFlow id="P11_livraison_flux3" name="Retrait" sourceRef="P11_livraison_g1" targetRef="P11_livraison_t1" />
    <bpmn:sequenceFlow id="P11_livraison_flux4" name="Livraison" sourceRef="P11_livraison_g1" targetRef="P11_livraison_t2" />
    <bpmn:sequenceFlow id="P11_livraison_flux5" sourceRef="P11_livraison_t2" targetRef="P11_livraison_t3" />
    <bpmn:sequenceFlow id="P11_livraison_flux6" sourceRef="P11_livraison_t3" targetRef="P11_livraison_t4" />
    <bpmn:sequenceFlow id="P11_livraison_flux7" sourceRef="P11_livraison_t4" targetRef="P11_livraison_t6" />
    <bpmn:sequenceFlow id="P11_livraison_flux8" sourceRef="P11_livraison_t1" targetRef="P11_livraison_t6" />
    <bpmn:sequenceFlow id="P11_livraison_flux9" sourceRef="P11_livraison_t6" targetRef="P11_livraison_t7" />
    <bpmn:sequenceFlow id="P11_livraison_flux10" sourceRef="P11_livraison_t7" targetRef="P11_livraison_f" />
    <bpmn:textAnnotation id="P11_livraison_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P11_livraison_diagram">
    <bpmndi:BPMNPlane id="P11_livraison_plane" bpmnElement="P11_livraison_collab">
      <bpmndi:BPMNShape id="P11_livraison_pool_di" bpmnElement="P11_livraison_pool" isHorizontal="true">
