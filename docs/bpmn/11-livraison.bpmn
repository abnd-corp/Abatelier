        <dc:Bounds x="710" y="420" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_livraison_t2_di" bpmnElement="P11_livraison_t2" bioc:stroke="#2e7d32" bioc:fill="#d8f0dc">
        <dc:Bounds x="710" y="660" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_livraison_t3_di" bpmnElement="P11_livraison_t3" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="900" y="300" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P11_livraison_t4_di" bpmnElement="P11_livraison_t4" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
