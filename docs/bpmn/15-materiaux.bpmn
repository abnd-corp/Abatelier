<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P15_materiaux_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P15_materiaux_collab">
    <bpmn:participant id="P15_materiaux_pool" name="Créer une référence de feuille" processRef="P15_materiaux" />
  </bpmn:collaboration>
  <bpmn:process id="P15_materiaux" name="Créer une référence de feuille" isExecutable="false">
    <bpmn:documentation>La direction décrit une feuille que l’atelier reçoit (matière, épaisseur, coloris, format) et son code-barres. Dès lors, la réception la reconnaît au scan. Rien d’autre n’est nécessaire.</bpmn:documentation>
    <bpmn:laneSet id="P15_materiaux_voies">
      <bpmn:lane id="P15_materiaux_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P15_materiaux_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_materiaux_t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P15_materiaux_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P15_materiaux_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_materiaux_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_materiaux_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_materiaux_gj1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P15_materiaux_voie_atelier" name="Atelier">
        <bpmn:flowNodeRef>P15_materiaux_f</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P15_materiaux_d" name="Une nouvelle feuille entre dans l’atelier"><bpmn:outgoing>P15_materiaux_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P15_materiaux_t1" name="Saisir la matière, l’épaisseur, le coloris, le format et le code-barres"><bpmn:documentation>Dans l’application : Direction › Matériaux (champs libres, suggestions du catalogue)</bpmn:documentation><bpmn:incoming>P15_materiaux_flux1</bpmn:incoming><bpmn:outgoing>P15_materiaux_flux2</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="P15_materiaux_g1" name="Matière ou coloris absent du catalogue ?"><bpmn:incoming>P15_materiaux_flux2</bpmn:incoming><bpmn:outgoing>P15_materiaux_flux3</bpmn:outgoing><bpmn:outgoing>P15_materiaux_flux4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P15_materiaux_t2" name="Les créer au catalogue, inactifs et à prix zéro"><bpmn:documentation>Dans l’application : Jamais vendables à zéro euro : la direction les complète dans Tarifs et catalogue</bpmn:documentation><bpmn:incoming>P15_materiaux_flux3</bpmn:incoming><bpmn:outgoing>P15_materiaux_flux5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P15_materiaux_t3" name="Créer la référence à zéro en stock, avec son code"><bpmn:documentation>Dans l’application : Un code désigne une référence ; un code déjà pris est refusé</bpmn:documentation><bpmn:incoming>P15_materiaux_flux7</bpmn:incoming><bpmn:outgoing>P15_materiaux_flux6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P15_materiaux_f" name="Référence prête pour la réception"><bpmn:incoming>P15_materiaux_flux6</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="P15_materiaux_gj1" name=""><bpmn:incoming>P15_materiaux_flux4</bpmn:incoming><bpmn:incoming>P15_materiaux_flux5</bpmn:incoming><bpmn:outgoing>P15_materiaux_flux7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P15_materiaux_flux1" sourceRef="P15_materiaux_d" targetRef="P15_materiaux_t1" />
    <bpmn:sequenceFlow id="P15_materiaux_flux2" sourceRef="P15_materiaux_t1" targetRef="P15_materiaux_g1" />
    <bpmn:sequenceFlow id="P15_materiaux_flux3" name="Oui" sourceRef="P15_materiaux_g1" targetRef="P15_materiaux_t2" />
    <bpmn:sequenceFlow id="P15_materiaux_flux4" name="Non" sourceRef="P15_materiaux_g1" targetRef="P15_materiaux_gj1" />
    <bpmn:sequenceFlow id="P15_materiaux_flux5" sourceRef="P15_materiaux_t2" targetRef="P15_materiaux_gj1" />
    <bpmn:sequenceFlow id="P15_materiaux_flux6" sourceRef="P15_materiaux_t3" targetRef="P15_materiaux_f" />
    <bpmn:sequenceFlow id="P15_materiaux_flux7" sourceRef="P15_materiaux_gj1" targetRef="P15_materiaux_t3" />
    <bpmn:textAnnotation id="P15_materiaux_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
