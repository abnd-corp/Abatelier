<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P12_plan_atelier_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P12_plan_atelier_collab">
    <bpmn:participant id="P12_plan_atelier_pool" name="Plan visuel de l’atelier dans l’application" processRef="P12_plan_atelier" />
  </bpmn:collaboration>
  <bpmn:process id="P12_plan_atelier" name="Plan visuel de l’atelier dans l’application" isExecutable="false">
    <bpmn:documentation>La direction ouvre un plan du bâtiment, dans l’application, où les commandes se déplacent de lieu en lieu et où le stock se lit sur les racks. Le plan lit les vraies données ; l’emplacement des machines et des racks se règle une fois.</bpmn:documentation>
    <bpmn:laneSet id="P12_plan_atelier_voies">
      <bpmn:lane id="P12_plan_atelier_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P12_plan_atelier_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_plan_atelier_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_plan_atelier_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_plan_atelier_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_plan_atelier_f</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_plan_atelier_gs1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P12_plan_atelier_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P12_plan_atelier_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_plan_atelier_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_plan_atelier_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P12_plan_atelier_gj2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P12_plan_atelier_d" name="La direction veut voir l’atelier d’un coup d’œil"><bpmn:outgoing>P12_plan_atelier_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P12_plan_atelier_t1" name="Ouvrir le plan dans le menu de l’atelier"><bpmn:documentation>Pas encore : Page réservée à la direction (nouvelle permission) ; lisible sur téléphone et tablette</bpmn:documentation><bpmn:incoming>P12_plan_atelier_flux1</bpmn:incoming><bpmn:outgoing>P12_plan_atelier_flux7</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P12_plan_atelier_t2" name="Placer chaque commande dans son lieu : à lancer, sur une machine, prête, à retirer"><bpmn:documentation>Pas encore : Lecture des commandes réelles ; le nom du client n’apparaît pas</bpmn:documentation><bpmn:incoming>P12_plan_atelier_flux10</bpmn:incoming><bpmn:outgoing>P12_plan_atelier_flux2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P12_plan_atelier_t3" name="Montrer le stock sur les racks et signaler les références sous leur seuil"><bpmn:documentation>Pas encore : Lecture du stock réel et des seuils déjà réglés</bpmn:documentation><bpmn:incoming>P12_plan_atelier_flux2</bpmn:incoming><bpmn:outgoing>P12_plan_atelier_flux3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P12_plan_atelier_t4" name="Montrer les arrivages : le camion de feuilles sur le parking pendant la réception"><bpmn:documentation>Pas encore : Lit les réceptions en cours</bpmn:documentation><bpmn:incoming>P12_plan_atelier_flux3</bpmn:incoming><bpmn:outgoing>P12_plan_atelier_flux4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P12_plan_atelier_t5" name="Cliquer une commande ou un rack pour ouvrir sa page"><bpmn:documentation>Pas encore : Mène à la commande, ou à la référence de feuille</bpmn:documentation><bpmn:incoming>P12_plan_atelier_flux4</bpmn:incoming><bpmn:outgoing>P12_plan_atelier_flux5</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P12_plan_atelier_t6" name="Placer les machines, les racks et les pièces sur le plan (une fois)"><bpmn:documentation>Pas encore : Dépend de la liste des machines et du plan fourni par le client</bpmn:documentation><bpmn:incoming>P12_plan_atelier_flux9</bpmn:incoming><bpmn:outgoing>P12_plan_atelier_flux6</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P12_plan_atelier_f" name="Atelier compris en un coup d’œil"><bpmn:incoming>P12_plan_atelier_flux5</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="P12_plan_atelier_gs1" name="Première utilisation ?"><bpmn:incoming>P12_plan_atelier_flux7</bpmn:incoming><bpmn:outgoing>P12_plan_atelier_flux8</bpmn:outgoing><bpmn:outgoing>P12_plan_atelier_flux9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="P12_plan_atelier_gj2" name=""><bpmn:incoming>P12_plan_atelier_flux6</bpmn:incoming><bpmn:incoming>P12_plan_atelier_flux8</bpmn:incoming><bpmn:outgoing>P12_plan_atelier_flux10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="P12_plan_atelier_flux1" sourceRef="P12_plan_atelier_d" targetRef="P12_plan_atelier_t1" />
    <bpmn:sequenceFlow id="P12_plan_atelier_flux2" sourceRef="P12_plan_atelier_t2" targetRef="P12_plan_atelier_t3" />
    <bpmn:sequenceFlow id="P12_plan_atelier_flux3" sourceRef="P12_plan_atelier_t3" targetRef="P12_plan_atelier_t4" />
    <bpmn:sequenceFlow id="P12_plan_atelier_flux4" sourceRef="P12_plan_atelier_t4" targetRef="P12_plan_atelier_t5" />
    <bpmn:sequenceFlow id="P12_plan_atelier_flux5" sourceRef="P12_plan_atelier_t5" targetRef="P12_plan_atelier_f" />
    <bpmn:sequenceFlow id="P12_plan_atelier_flux6" sourceRef="P12_plan_atelier_t6" targetRef="P12_plan_atelier_gj2" />
    <bpmn:sequenceFlow id="P12_plan_atelier_flux7" sourceRef="P12_plan_atelier_t1" targetRef="P12_plan_atelier_gs1" />
    <bpmn:sequenceFlow id="P12_plan_atelier_flux8" name="Non" sourceRef="P12_plan_atelier_gs1" targetRef="P12_plan_atelier_gj2" />
    <bpmn:sequenceFlow id="P12_plan_atelier_flux9" name="Oui" sourceRef="P12_plan_atelier_gs1" targetRef="P12_plan_atelier_t6" />
    <bpmn:sequenceFlow id="P12_plan_atelier_flux10" sourceRef="P12_plan_atelier_gj2" targetRef="P12_plan_atelier_t2" />
    <bpmn:textAnnotation id="P12_plan_atelier_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
