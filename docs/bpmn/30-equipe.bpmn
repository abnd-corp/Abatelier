<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P30_equipe_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P30_equipe_collab">
    <bpmn:participant id="P30_equipe_pool" name="Équipe : arrivée et départ d’un salarié" processRef="P30_equipe" />
  </bpmn:collaboration>
  <bpmn:process id="P30_equipe" name="Équipe : arrivée et départ d’un salarié" isExecutable="false">
    <bpmn:documentation>Fiche du salarié, compte personnel, droits par sections, puis désactivation au départ.</bpmn:documentation>
    <bpmn:laneSet id="P30_equipe_voies">
      <bpmn:lane id="P30_equipe_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P30_equipe_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_equipe_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_equipe_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_equipe_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_equipe_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_equipe_f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P30_equipe_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P30_equipe_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P30_equipe_t7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P30_equipe_voie_atelier" name="Atelier">
        <bpmn:flowNodeRef>P30_equipe_t4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P30_equipe_d" name="Un salarié arrive"><bpmn:outgoing>P30_equipe_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P30_equipe_t1" name="Créer la fiche du salarié (contrat, dates, contact)"><bpmn:documentation>Dans l’application : Équipe › Salariés (la direction y a accès)</bpmn:documentation><bpmn:incoming>P30_equipe_flux1</bpmn:incoming><bpmn:outgoing>P30_equipe_flux2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P30_equipe_t2" name="Créer son compte personnel et cocher ses sections : Ventes, Atelier, Direction"><bpmn:documentation>Dans l’application : Seul l’administrateur crée des comptes ; sections cumulables</bpmn:documentation><bpmn:incoming>P30_equipe_flux2</bpmn:incoming><bpmn:outgoing>P30_equipe_flux3</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P30_equipe_t3" name="Générer un mot de passe temporaire, à changer à la première connexion"><bpmn:documentation>Dans l’application : Le salarié ne peut rien faire d’autre avant ; jamais envoyé par e-mail</bpmn:documentation><bpmn:incoming>P30_equipe_flux3</bpmn:incoming><bpmn:outgoing>P30_equipe_flux4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P30_equipe_t4" name="Se connecter et choisir son mot de passe"><bpmn:documentation>Dans l’application : Indicateur de robustesse</bpmn:documentation><bpmn:incoming>P30_equipe_flux4</bpmn:incoming><bpmn:outgoing>P30_equipe_flux5</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P30_equipe_t5" name="Changer ses droits ou lui donner un nouveau mot de passe temporaire"><bpmn:documentation>Dans l’application : Administration › Comptes</bpmn:documentation><bpmn:incoming>P30_equipe_flux5</bpmn:incoming><bpmn:outgoing>P30_equipe_flux6</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P30_equipe_t6" name="Enregistrer le départ : désactiver le compte"><bpmn:documentation>Dans l’application : Déconnexion immédiate de tous ses appareils</bpmn:documentation><bpmn:incoming>P30_equipe_flux6</bpmn:incoming><bpmn:outgoing>P30_equipe_flux7</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P30_equipe_t7" name="Garder l’historique et noter chaque action au journal"><bpmn:documentation>Dans l’application : Journal d’activité (qui, quoi, quand)</bpmn:documentation><bpmn:incoming>P30_equipe_flux7</bpmn:incoming><bpmn:outgoing>P30_equipe_flux8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P30_equipe_f" name="Compte fermé, historique conservé"><bpmn:incoming>P30_equipe_flux8</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P30_equipe_flux1" sourceRef="P30_equipe_d" targetRef="P30_equipe_t1" />
    <bpmn:sequenceFlow id="P30_equipe_flux2" sourceRef="P30_equipe_t1" targetRef="P30_equipe_t2" />
    <bpmn:sequenceFlow id="P30_equipe_flux3" sourceRef="P30_equipe_t2" targetRef="P30_equipe_t3" />
    <bpmn:sequenceFlow id="P30_equipe_flux4" sourceRef="P30_equipe_t3" targetRef="P30_equipe_t4" />
    <bpmn:sequenceFlow id="P30_equipe_flux5" sourceRef="P30_equipe_t4" targetRef="P30_equipe_t5" />
    <bpmn:sequenceFlow id="P30_equipe_flux6" sourceRef="P30_equipe_t5" targetRef="P30_equipe_t6" />
    <bpmn:sequenceFlow id="P30_equipe_flux7" sourceRef="P30_equipe_t6" targetRef="P30_equipe_t7" />
    <bpmn:sequenceFlow id="P30_equipe_flux8" sourceRef="P30_equipe_t7" targetRef="P30_equipe_f" />
    <bpmn:textAnnotation id="P30_equipe_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P30_equipe_diagram">
