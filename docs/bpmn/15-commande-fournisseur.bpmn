<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P15_commande_fournisseur_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P15_commande_fournisseur_collab">
    <bpmn:participant id="P15_commande_fournisseur_pool" name="Commande de feuilles au fournisseur" processRef="P15_commande_fournisseur" />
  </bpmn:collaboration>
  <bpmn:process id="P15_commande_fournisseur" name="Commande de feuilles au fournisseur" isExecutable="false">
    <bpmn:documentation>La commande passée au fournisseur est enregistrée dans la plateforme avec ses feuilles : la réception sait ce qu’elle doit scanner et compare avec ce qui arrive.</bpmn:documentation>
    <bpmn:laneSet id="P15_commande_fournisseur_voies">
      <bpmn:lane id="P15_commande_fournisseur_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P15_commande_fournisseur_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_commande_fournisseur_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_commande_fournisseur_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_commande_fournisseur_t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P15_commande_fournisseur_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P15_commande_fournisseur_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P15_commande_fournisseur_t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P15_commande_fournisseur_voie_atelier" name="Atelier">
        <bpmn:flowNodeRef>P15_commande_fournisseur_f</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P15_commande_fournisseur_d" name="Le stock d’une référence est bas"><bpmn:outgoing>P15_commande_fournisseur_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P15_commande_fournisseur_t1" name="Notifier la direction dans la plateforme : stock bas"><bpmn:documentation>Dans l’application : Seuil réglable sur chaque référence</bpmn:documentation><bpmn:incoming>P15_commande_fournisseur_flux1</bpmn:incoming><bpmn:outgoing>P15_commande_fournisseur_flux2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:manualTask id="P15_commande_fournisseur_t2" name="Passer la commande au fournisseur (téléphone, e-mail, site du fournisseur)"><bpmn:documentation>Hors application : Le fournisseur n’est pas relié à l’application ; à recueillir : qui commande, à qui, comment</bpmn:documentation><bpmn:incoming>P15_commande_fournisseur_flux2</bpmn:incoming><bpmn:outgoing>P15_commande_fournisseur_flux3</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="P15_commande_fournisseur_t3" name="Enregistrer la commande passée : fournisseur, références, nombre de feuilles de chaque lot, date de livraison prévue"><bpmn:documentation>Pas encore : À étudier : voir d’abord comment l’atelier commande, puis importer la commande (fichier ou e-mail du fournisseur) plutôt que la ressaisir</bpmn:documentation><bpmn:incoming>P15_commande_fournisseur_flux3</bpmn:incoming><bpmn:outgoing>P15_commande_fournisseur_flux4</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P15_commande_fournisseur_t4" name="Afficher « en commande » sur chaque référence et préparer les quantités attendues à la réception"><bpmn:documentation>Pas encore : Permet la comparaison entre commandé et reçu</bpmn:documentation><bpmn:incoming>P15_commande_fournisseur_flux4</bpmn:incoming><bpmn:outgoing>P15_commande_fournisseur_flux5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P15_commande_fournisseur_t5" name="Notifier la direction si la livraison n’arrive pas à la date prévue"><bpmn:documentation>Pas encore : Notification dans la plateforme</bpmn:documentation><bpmn:incoming>P15_commande_fournisseur_flux5</bpmn:incoming><bpmn:outgoing>P15_commande_fournisseur_flux6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="P15_commande_fournisseur_f" name="Livraison attendue : voir « Réception »"><bpmn:incoming>P15_commande_fournisseur_flux6</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P15_commande_fournisseur_flux1" sourceRef="P15_commande_fournisseur_d" targetRef="P15_commande_fournisseur_t1" />
    <bpmn:sequenceFlow id="P15_commande_fournisseur_flux2" sourceRef="P15_commande_fournisseur_t1" targetRef="P15_commande_fournisseur_t2" />
    <bpmn:sequenceFlow id="P15_commande_fournisseur_flux3" sourceRef="P15_commande_fournisseur_t2" targetRef="P15_commande_fournisseur_t3" />
    <bpmn:sequenceFlow id="P15_commande_fournisseur_flux4" sourceRef="P15_commande_fournisseur_t3" targetRef="P15_commande_fournisseur_t4" />
    <bpmn:sequenceFlow id="P15_commande_fournisseur_flux5" sourceRef="P15_commande_fournisseur_t4" targetRef="P15_commande_fournisseur_t5" />
    <bpmn:sequenceFlow id="P15_commande_fournisseur_flux6" sourceRef="P15_commande_fournisseur_t5" targetRef="P15_commande_fournisseur_f" />
    <bpmn:textAnnotation id="P15_commande_fournisseur_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P15_commande_fournisseur_diagram">
