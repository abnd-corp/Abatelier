<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P25_stats_alertes_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P25_stats_alertes_collab">
    <bpmn:participant id="P25_stats_alertes_pool" name="Statistiques : alertes sur le catalogue" processRef="P25_stats_alertes" />
  </bpmn:collaboration>
  <bpmn:process id="P25_stats_alertes" name="Statistiques : alertes sur le catalogue" isExecutable="false">
    <bpmn:documentation>L’application signale d’elle-même un produit qui ne se vend plus, avec une suggestion.</bpmn:documentation>
    <bpmn:laneSet id="P25_stats_alertes_voies">
      <bpmn:lane id="P25_stats_alertes_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P25_stats_alertes_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_stats_alertes_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_stats_alertes_f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P25_stats_alertes_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P25_stats_alertes_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_stats_alertes_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P25_stats_alertes_t3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P25_stats_alertes_d" name="Un produit ne se vend plus"><bpmn:outgoing>P25_stats_alertes_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P25_stats_alertes_t1" name="Régler les règles d’alerte (par exemple : sans vente depuis N mois)"><bpmn:documentation>Pas encore : À définir avec la direction : quelles actions déclenchent une alerte</bpmn:documentation><bpmn:incoming>P25_stats_alertes_flux1</bpmn:incoming><bpmn:outgoing>P25_stats_alertes_flux2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P25_stats_alertes_t2" name="Détecter un coloris ou une matière sans vente"><bpmn:documentation>Pas encore : Règles réglables</bpmn:documentation><bpmn:incoming>P25_stats_alertes_flux2</bpmn:incoming><bpmn:outgoing>P25_stats_alertes_flux3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P25_stats_alertes_t3" name="Notifier la direction dans la plateforme, avec une suggestion : désactiver, solder, ne plus réapprovisionner"><bpmn:documentation>Pas encore : Dans le centre de notifications</bpmn:documentation><bpmn:incoming>P25_stats_alertes_flux3</bpmn:incoming><bpmn:outgoing>P25_stats_alertes_flux4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P25_stats_alertes_t4" name="Désactiver au catalogue si elle le décide"><bpmn:documentation>Dans l’application : Tarifs et catalogue › désactiver</bpmn:documentation><bpmn:incoming>P25_stats_alertes_flux4</bpmn:incoming><bpmn:outgoing>P25_stats_alertes_flux5</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P25_stats_alertes_f" name="Catalogue à jour"><bpmn:incoming>P25_stats_alertes_flux5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P25_stats_alertes_flux1" sourceRef="P25_stats_alertes_d" targetRef="P25_stats_alertes_t1" />
    <bpmn:sequenceFlow id="P25_stats_alertes_flux2" sourceRef="P25_stats_alertes_t1" targetRef="P25_stats_alertes_t2" />
    <bpmn:sequenceFlow id="P25_stats_alertes_flux3" sourceRef="P25_stats_alertes_t2" targetRef="P25_stats_alertes_t3" />
    <bpmn:sequenceFlow id="P25_stats_alertes_flux4" sourceRef="P25_stats_alertes_t3" targetRef="P25_stats_alertes_t4" />
    <bpmn:sequenceFlow id="P25_stats_alertes_flux5" sourceRef="P25_stats_alertes_t4" targetRef="P25_stats_alertes_f" />
    <bpmn:textAnnotation id="P25_stats_alertes_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P25_stats_alertes_diagram">
    <bpmndi:BPMNPlane id="P25_stats_alertes_plane" bpmnElement="P25_stats_alertes_collab">
      <bpmndi:BPMNShape id="P25_stats_alertes_pool_di" bpmnElement="P25_stats_alertes_pool" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="1250" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P25_stats_alertes_voie_direction_di" bpmnElement="P25_stats_alertes_voie_direction" isHorizontal="true">
        <dc:Bounds x="70" y="40" width="1220" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P25_stats_alertes_voie_systeme_di" bpmnElement="P25_stats_alertes_voie_systeme" isHorizontal="true">
        <dc:Bounds x="70" y="160" width="1220" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P25_stats_alertes_d_di" bpmnElement="P25_stats_alertes_d">
        <dc:Bounds x="197" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P25_stats_alertes_t1_di" bpmnElement="P25_stats_alertes_t1" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="330" y="60" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P25_stats_alertes_t2_di" bpmnElement="P25_stats_alertes_t2" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="520" y="180" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P25_stats_alertes_t3_di" bpmnElement="P25_stats_alertes_t3" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="710" y="180" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P25_stats_alertes_t4_di" bpmnElement="P25_stats_alertes_t4" bioc:stroke="#2e7d32" bioc:fill="#d8f0dc">
        <dc:Bounds x="900" y="60" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P25_stats_alertes_f_di" bpmnElement="P25_stats_alertes_f">
        <dc:Bounds x="1147" y="82" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P25_stats_alertes_flux1_di" bpmnElement="P25_stats_alertes_flux1">
        <di:waypoint x="233" y="220" />
        <di:waypoint x="305" y="220" />
        <di:waypoint x="305" y="100" />
        <di:waypoint x="330" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P25_stats_alertes_flux2_di" bpmnElement="P25_stats_alertes_flux2">
        <di:waypoint x="480" y="100" />
        <di:waypoint x="495" y="100" />
        <di:waypoint x="495" y="220" />
        <di:waypoint x="520" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P25_stats_alertes_flux3_di" bpmnElement="P25_stats_alertes_flux3">
        <di:waypoint x="670" y="220" />
        <di:waypoint x="710" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P25_stats_alertes_flux4_di" bpmnElement="P25_stats_alertes_flux4">
        <di:waypoint x="860" y="220" />
        <di:waypoint x="875" y="220" />
        <di:waypoint x="875" y="100" />
        <di:waypoint x="900" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P25_stats_alertes_flux5_di" bpmnElement="P25_stats_alertes_flux5">
        <di:waypoint x="1050" y="100" />
        <di:waypoint x="1147" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="P25_stats_alertes_legende_di" bpmnElement="P25_stats_alertes_legende">
        <dc:Bounds x="70" y="300" width="760" height="30" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
