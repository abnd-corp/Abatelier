      <bpmndi:BPMNShape id="P18_stats_finances_t4_di" bpmnElement="P18_stats_finances_t4" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="900" y="300" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P18_stats_finances_t5_di" bpmnElement="P18_stats_finances_t5" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="1090" y="180" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P18_stats_finances_f_di" bpmnElement="P18_stats_finances_f">
        <dc:Bounds x="1337" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P18_stats_finances_flux1_di" bpmnElement="P18_stats_finances_flux1">
