        <dc:Bounds x="520" y="180" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P18_stats_finances_t3_di" bpmnElement="P18_stats_finances_t3" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="710" y="300" width="150" height="80" />
