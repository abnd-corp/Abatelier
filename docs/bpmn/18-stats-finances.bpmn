<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P18_stats_finances_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P18_stats_finances_collab">
    <bpmn:participant id="P18_stats_finances_pool" name="Statistiques : dépenses, entrées et marge" processRef="P18_stats_finances" />
  </bpmn:collaboration>
  <bpmn:process id="P18_stats_finances" name="Statistiques : dépenses, entrées et marge" isExecutable="false">
    <bpmn:documentation>La direction suit l’argent qui entre et qui sort. Il manque les prix d’achat et les dépenses : ils se saisissent à la réception et par catégorie.</bpmn:documentation>
    <bpmn:laneSet id="P18_stats_finances_voies">
      <bpmn:lane id="P18_stats_finances_voie_atelier" name="Atelier">
        <bpmn:flowNodeRef>P18_stats_finances_t1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P18_stats_finances_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P18_stats_finances_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_stats_finances_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_stats_finances_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_stats_finances_f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P18_stats_finances_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P18_stats_finances_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P18_stats_finances_t4</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P18_stats_finances_d" name="La direction veut savoir ce qu’elle gagne"><bpmn:outgoing>P18_stats_finances_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P18_stats_finances_t1" name="Saisir le prix d’achat à la réception de chaque lot"><bpmn:documentation>Pas encore : Aucun prix d’achat dans l’application aujourd’hui</bpmn:documentation><bpmn:incoming>P18_stats_finances_flux1</bpmn:incoming><bpmn:outgoing>P18_stats_finances_flux2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="P18_stats_finances_t2" name="Saisir les autres dépenses par catégorie"><bpmn:documentation>Pas encore : Les catégories de dépenses sont à définir avec la direction</bpmn:documentation><bpmn:incoming>P18_stats_finances_flux2</bpmn:incoming><bpmn:outgoing>P18_stats_finances_flux3</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P18_stats_finances_t3" name="Calculer les entrées (paiements, factures), les sorties et le solde"><bpmn:documentation>Pas encore : Les paiements et factures sont déjà horodatés</bpmn:documentation><bpmn:incoming>P18_stats_finances_flux3</bpmn:incoming><bpmn:outgoing>P18_stats_finances_flux4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P18_stats_finances_t4" name="Calculer la marge par matière"><bpmn:documentation>Pas encore : Dépend du prix d’achat</bpmn:documentation><bpmn:incoming>P18_stats_finances_flux4</bpmn:incoming><bpmn:outgoing>P18_stats_finances_flux5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P18_stats_finances_t5" name="Lire les entrées, les sorties et la marge"><bpmn:documentation>Pas encore : Accès réservé à la direction (permission stats.read) ; lisible sur téléphone</bpmn:documentation><bpmn:incoming>P18_stats_finances_flux5</bpmn:incoming><bpmn:outgoing>P18_stats_finances_flux6</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P18_stats_finances_f" name="Décision : ajuster les tarifs, les achats"><bpmn:incoming>P18_stats_finances_flux6</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P18_stats_finances_flux1" sourceRef="P18_stats_finances_d" targetRef="P18_stats_finances_t1" />
    <bpmn:sequenceFlow id="P18_stats_finances_flux2" sourceRef="P18_stats_finances_t1" targetRef="P18_stats_finances_t2" />
    <bpmn:sequenceFlow id="P18_stats_finances_flux3" sourceRef="P18_stats_finances_t2" targetRef="P18_stats_finances_t3" />
    <bpmn:sequenceFlow id="P18_stats_finances_flux4" sourceRef="P18_stats_finances_t3" targetRef="P18_stats_finances_t4" />
    <bpmn:sequenceFlow id="P18_stats_finances_flux5" sourceRef="P18_stats_finances_t4" targetRef="P18_stats_finances_t5" />
    <bpmn:sequenceFlow id="P18_stats_finances_flux6" sourceRef="P18_stats_finances_t5" targetRef="P18_stats_finances_f" />
    <bpmn:textAnnotation id="P18_stats_finances_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P18_stats_finances_diagram">
    <bpmndi:BPMNPlane id="P18_stats_finances_plane" bpmnElement="P18_stats_finances_collab">
      <bpmndi:BPMNShape id="P18_stats_finances_pool_di" bpmnElement="P18_stats_finances_pool" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="1440" height="360" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P18_stats_finances_voie_atelier_di" bpmnElement="P18_stats_finances_voie_atelier" isHorizontal="true">
        <dc:Bounds x="70" y="40" width="1410" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P18_stats_finances_voie_direction_di" bpmnElement="P18_stats_finances_voie_direction" isHorizontal="true">
        <dc:Bounds x="70" y="160" width="1410" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P18_stats_finances_voie_systeme_di" bpmnElement="P18_stats_finances_voie_systeme" isHorizontal="true">
        <dc:Bounds x="70" y="280" width="1410" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P18_stats_finances_d_di" bpmnElement="P18_stats_finances_d">
        <dc:Bounds x="197" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P18_stats_finances_t1_di" bpmnElement="P18_stats_finances_t1" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="330" y="60" width="150" height="80" />
