<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P17_stats_ventes_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P17_stats_ventes_collab">
    <bpmn:participant id="P17_stats_ventes_pool" name="Statistiques : chiffres clés et ventes" processRef="P17_stats_ventes" />
  </bpmn:collaboration>
  <bpmn:process id="P17_stats_ventes" name="Statistiques : chiffres clés et ventes" isExecutable="false">
    <bpmn:documentation>La direction lit ce qu’elle vend, de quoi et combien, sur la période de son choix. Les données de commandes existent déjà.</bpmn:documentation>
    <bpmn:laneSet id="P17_stats_ventes_voies">
      <bpmn:lane id="P17_stats_ventes_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P17_stats_ventes_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P17_stats_ventes_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P17_stats_ventes_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P17_stats_ventes_f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P17_stats_ventes_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P17_stats_ventes_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P17_stats_ventes_t3</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P17_stats_ventes_d" name="La direction veut savoir combien elle vend, et de quoi"><bpmn:outgoing>P17_stats_ventes_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P17_stats_ventes_t1" name="Choisir une période et un intervalle (jour, semaine, mois)"><bpmn:documentation>Pas encore : Sélecteur commun à toutes les vues de statistiques</bpmn:documentation><bpmn:incoming>P17_stats_ventes_flux1</bpmn:incoming><bpmn:outgoing>P17_stats_ventes_flux2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P17_stats_ventes_t2" name="Calculer le chiffre d’affaires, le nombre de commandes, le panier moyen, les devis acceptés"><bpmn:documentation>Pas encore : Les données de commandes existent déjà</bpmn:documentation><bpmn:incoming>P17_stats_ventes_flux2</bpmn:incoming><bpmn:outgoing>P17_stats_ventes_flux3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P17_stats_ventes_t3" name="Répartir les ventes par matière, coloris, modèle de pièce, sur mesure ou boutique"><bpmn:documentation>Pas encore : Les lignes de commande gardent déjà ces informations</bpmn:documentation><bpmn:incoming>P17_stats_ventes_flux3</bpmn:incoming><bpmn:outgoing>P17_stats_ventes_flux4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P17_stats_ventes_t4" name="Lire les chiffres, les courbes et le classement des références"><bpmn:documentation>Pas encore : Accès réservé à la direction (permission stats.read) ; lisible sur téléphone</bpmn:documentation><bpmn:incoming>P17_stats_ventes_flux4</bpmn:incoming><bpmn:outgoing>P17_stats_ventes_flux5</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P17_stats_ventes_f" name="Décision : quoi vendre, quoi mettre en avant"><bpmn:incoming>P17_stats_ventes_flux5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P17_stats_ventes_flux1" sourceRef="P17_stats_ventes_d" targetRef="P17_stats_ventes_t1" />
    <bpmn:sequenceFlow id="P17_stats_ventes_flux2" sourceRef="P17_stats_ventes_t1" targetRef="P17_stats_ventes_t2" />
    <bpmn:sequenceFlow id="P17_stats_ventes_flux3" sourceRef="P17_stats_ventes_t2" targetRef="P17_stats_ventes_t3" />
    <bpmn:sequenceFlow id="P17_stats_ventes_flux4" sourceRef="P17_stats_ventes_t3" targetRef="P17_stats_ventes_t4" />
    <bpmn:sequenceFlow id="P17_stats_ventes_flux5" sourceRef="P17_stats_ventes_t4" targetRef="P17_stats_ventes_f" />
    <bpmn:textAnnotation id="P17_stats_ventes_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P17_stats_ventes_diagram">
    <bpmndi:BPMNPlane id="P17_stats_ventes_plane" bpmnElement="P17_stats_ventes_collab">
