<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P9_livraison_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P9_livraison_collab">
    <bpmn:participant id="P9_livraison_pool" name="Livraison et retrait" processRef="P9_livraison" />
  </bpmn:collaboration>
  <bpmn:process id="P9_livraison" name="Livraison et retrait" isExecutable="false">
    <bpmn:documentation>La commande prête est retirée à l’atelier ou livrée sur chantier.</bpmn:documentation>
    <bpmn:laneSet id="P9_livraison_voies">
      <bpmn:lane id="P9_livraison_voie_atelier" name="Atelier">
        <bpmn:flowNodeRef>P9_livraison_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P9_livraison_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P9_livraison_f</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P9_livraison_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P9_livraison_g1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P9_livraison_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P9_livraison_t4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P9_livraison_voie_client" name="Visiteur / Client">
        <bpmn:flowNodeRef>P9_livraison_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P9_livraison_t5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P9_livraison_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P9_livraison_t2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P9_livraison_d" name="Commande prête"><bpmn:outgoing>P9_livraison_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:exclusiveGateway id="P9_livraison_g1" name="Retrait ou livraison ?"><bpmn:incoming>P9_livraison_flux1</bpmn:incoming><bpmn:outgoing>P9_livraison_flux2</bpmn:outgoing><bpmn:outgoing>P9_livraison_flux3</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="P9_livraison_t1" name="Venir chercher la commande à l’atelier"><bpmn:documentation>Hors application : Le mode « retrait » est choisi à la commande</bpmn:documentation><bpmn:incoming>P9_livraison_flux2</bpmn:incoming><bpmn:outgoing>P9_livraison_flux7</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P9_livraison_t2" name="Fournir l’adresse, la distance et les frais de livraison"><bpmn:documentation>Dans l’application : Calculés à la commande (distance par la route)</bpmn:documentation><bpmn:incoming>P9_livraison_flux3</bpmn:incoming><bpmn:outgoing>P9_livraison_flux4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:manualTask id="P9_livraison_t3" name="Planifier la tournée et livrer sur chantier"><bpmn:documentation>Pas encore : Pas de planning de tournées dans l’application</bpmn:documentation><bpmn:incoming>P9_livraison_flux4</bpmn:incoming><bpmn:outgoing>P9_livraison_flux5</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="P9_livraison_t4" name="Éditer le bon de livraison"><bpmn:documentation>Pas encore : Prévu : nouveau type de document</bpmn:documentation><bpmn:incoming>P9_livraison_flux5</bpmn:incoming><bpmn:outgoing>P9_livraison_flux6</bpmn:outgoing></bpmn:userTask>
    <bpmn:manualTask id="P9_livraison_t5" name="Signer la réception"><bpmn:documentation>Pas encore : Pas de signature de réception</bpmn:documentation><bpmn:incoming>P9_livraison_flux6</bpmn:incoming><bpmn:outgoing>P9_livraison_flux8</bpmn:outgoing></bpmn:manualTask>
    <bpmn:userTask id="P9_livraison_t6" name="Marquer la commande retirée ou livrée"><bpmn:documentation>Dans l’application : Le bouton dit « Marquer retirée » ou « Marquer livrée » selon le mode ; elle quitte Fabrication</bpmn:documentation><bpmn:incoming>P9_livraison_flux7</bpmn:incoming><bpmn:incoming>P9_livraison_flux8</bpmn:incoming><bpmn:outgoing>P9_livraison_flux9</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P9_livraison_f" name="Commande remise : voir « Facturation »"><bpmn:incoming>P9_livraison_flux9</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P9_livraison_flux1" sourceRef="P9_livraison_d" targetRef="P9_livraison_g1" />
    <bpmn:sequenceFlow id="P9_livraison_flux2" name="Retrait" sourceRef="P9_livraison_g1" targetRef="P9_livraison_t1" />
    <bpmn:sequenceFlow id="P9_livraison_flux3" name="Livraison" sourceRef="P9_livraison_g1" targetRef="P9_livraison_t2" />
    <bpmn:sequenceFlow id="P9_livraison_flux4" sourceRef="P9_livraison_t2" targetRef="P9_livraison_t3" />
    <bpmn:sequenceFlow id="P9_livraison_flux5" sourceRef="P9_livraison_t3" targetRef="P9_livraison_t4" />
    <bpmn:sequenceFlow id="P9_livraison_flux6" sourceRef="P9_livraison_t4" targetRef="P9_livraison_t5" />
    <bpmn:sequenceFlow id="P9_livraison_flux7" sourceRef="P9_livraison_t1" targetRef="P9_livraison_t6" />
    <bpmn:sequenceFlow id="P9_livraison_flux8" sourceRef="P9_livraison_t5" targetRef="P9_livraison_t6" />
    <bpmn:sequenceFlow id="P9_livraison_flux9" sourceRef="P9_livraison_t6" targetRef="P9_livraison_f" />
    <bpmn:textAnnotation id="P9_livraison_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
