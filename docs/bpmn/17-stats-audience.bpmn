<?xml version="1.0" encoding="UTF-8"?>
<!-- Généré par scripts/bpmn/generer.mjs : modifier scripts/bpmn/processus.mjs, pas ce fichier. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P17_stats_audience_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P17_stats_audience_collab">
    <bpmn:participant id="P17_stats_audience_pool" name="Statistiques : audience du site et entonnoir" processRef="P17_stats_audience" />
  </bpmn:collaboration>
  <bpmn:process id="P17_stats_audience" name="Statistiques : audience du site et entonnoir" isExecutable="false">
    <bpmn:documentation>La direction voit si le site attire et si les visiteurs deviennent clients. Rien n’est mesuré aujourd’hui : la collecte doit commencer dès la mise en production.</bpmn:documentation>
    <bpmn:laneSet id="P17_stats_audience_voies">
      <bpmn:lane id="P17_stats_audience_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P17_stats_audience_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P17_stats_audience_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P17_stats_audience_t3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P17_stats_audience_voie_direction" name="Direction">
        <bpmn:flowNodeRef>P17_stats_audience_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P17_stats_audience_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P17_stats_audience_f</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P17_stats_audience_d" name="La direction veut savoir si le site attire et convertit"><bpmn:outgoing>P17_stats_audience_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="P17_stats_audience_t1" name="Compter les visites et les pages vues, sans cookie ni adresse IP conservée"><bpmn:documentation>Pas encore : Compteur anonyme agrégé par jour et par page, à valider côté RGPD / CNIL</bpmn:documentation><bpmn:incoming>P17_stats_audience_flux1</bpmn:incoming><bpmn:outgoing>P17_stats_audience_flux2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P17_stats_audience_t2" name="Enregistrer les abandons du configurateur et du panier, les devis refusés ou expirés et leur motif"><bpmn:documentation>Pas encore : Sert au taux de conversion</bpmn:documentation><bpmn:incoming>P17_stats_audience_flux2</bpmn:incoming><bpmn:outgoing>P17_stats_audience_flux3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P17_stats_audience_t3" name="Calculer l’entonnoir : visite, configurateur, devis, commande"><bpmn:documentation>Pas encore : Aussi les demandes de contact</bpmn:documentation><bpmn:incoming>P17_stats_audience_flux3</bpmn:incoming><bpmn:outgoing>P17_stats_audience_flux4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P17_stats_audience_t4" name="Lire l’audience et l’entonnoir"><bpmn:documentation>Pas encore : Accès réservé à la direction (permission stats.read) ; lisible sur téléphone</bpmn:documentation><bpmn:incoming>P17_stats_audience_flux4</bpmn:incoming><bpmn:outgoing>P17_stats_audience_flux5</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P17_stats_audience_f" name="Décision : améliorer le site, le configurateur ou les tarifs"><bpmn:incoming>P17_stats_audience_flux5</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="P17_stats_audience_flux1" sourceRef="P17_stats_audience_d" targetRef="P17_stats_audience_t1" />
    <bpmn:sequenceFlow id="P17_stats_audience_flux2" sourceRef="P17_stats_audience_t1" targetRef="P17_stats_audience_t2" />
    <bpmn:sequenceFlow id="P17_stats_audience_flux3" sourceRef="P17_stats_audience_t2" targetRef="P17_stats_audience_t3" />
    <bpmn:sequenceFlow id="P17_stats_audience_flux4" sourceRef="P17_stats_audience_t3" targetRef="P17_stats_audience_t4" />
    <bpmn:sequenceFlow id="P17_stats_audience_flux5" sourceRef="P17_stats_audience_t4" targetRef="P17_stats_audience_f" />
    <bpmn:textAnnotation id="P17_stats_audience_legende"><bpmn:text>Légende : vert = dans l’application · orange = en partie · rouge = pas encore · gris = hors application (geste manuel)</bpmn:text></bpmn:textAnnotation>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="P17_stats_audience_diagram">
    <bpmndi:BPMNPlane id="P17_stats_audience_plane" bpmnElement="P17_stats_audience_collab">
      <bpmndi:BPMNShape id="P17_stats_audience_pool_di" bpmnElement="P17_stats_audience_pool" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="1250" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P17_stats_audience_voie_systeme_di" bpmnElement="P17_stats_audience_voie_systeme" isHorizontal="true">
        <dc:Bounds x="70" y="40" width="1220" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P17_stats_audience_voie_direction_di" bpmnElement="P17_stats_audience_voie_direction" isHorizontal="true">
        <dc:Bounds x="70" y="160" width="1220" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P17_stats_audience_d_di" bpmnElement="P17_stats_audience_d">
        <dc:Bounds x="197" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P17_stats_audience_t1_di" bpmnElement="P17_stats_audience_t1" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="330" y="60" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P17_stats_audience_t2_di" bpmnElement="P17_stats_audience_t2" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="520" y="60" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P17_stats_audience_t3_di" bpmnElement="P17_stats_audience_t3" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="710" y="60" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P17_stats_audience_t4_di" bpmnElement="P17_stats_audience_t4" bioc:stroke="#c62828" bioc:fill="#f9d3cf">
        <dc:Bounds x="900" y="180" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="P17_stats_audience_f_di" bpmnElement="P17_stats_audience_f">
        <dc:Bounds x="1147" y="202" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="P17_stats_audience_flux1_di" bpmnElement="P17_stats_audience_flux1">
        <di:waypoint x="233" y="220" />
        <di:waypoint x="305" y="220" />
        <di:waypoint x="305" y="100" />
        <di:waypoint x="330" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P17_stats_audience_flux2_di" bpmnElement="P17_stats_audience_flux2">
        <di:waypoint x="480" y="100" />
        <di:waypoint x="520" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P17_stats_audience_flux3_di" bpmnElement="P17_stats_audience_flux3">
        <di:waypoint x="670" y="100" />
        <di:waypoint x="710" y="100" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P17_stats_audience_flux4_di" bpmnElement="P17_stats_audience_flux4">
        <di:waypoint x="860" y="100" />
        <di:waypoint x="875" y="100" />
        <di:waypoint x="875" y="220" />
        <di:waypoint x="900" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="P17_stats_audience_flux5_di" bpmnElement="P17_stats_audience_flux5">
        <di:waypoint x="1050" y="220" />
        <di:waypoint x="1147" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="P17_stats_audience_legende_di" bpmnElement="P17_stats_audience_legende">
        <dc:Bounds x="70" y="300" width="760" height="30" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
