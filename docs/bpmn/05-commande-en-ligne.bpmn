    <bpmn:sequenceFlow id="P5_commande_en_ligne_flux5" sourceRef="P5_commande_en_ligne_t4" targetRef="P5_commande_en_ligne_g1" />
    <bpmn:sequenceFlow id="P5_commande_en_ligne_flux6" name="Oui" sourceRef="P5_commande_en_ligne_g1" targetRef="P5_commande_en_ligne_t5" />
    <bpmn:sequenceFlow id="P5_commande_en_ligne_flux7" name="Non" sourceRef="P5_commande_en_ligne_g1" targetRef="P5_commande_en_ligne_t9" />
    <bpmn:sequenceFlow id="P5_commande_en_ligne_flux8" sourceRef="P5_commande_en_ligne_t5" targetRef="P5_commande_en_ligne_t6" />
    <bpmn:sequenceFlow id="P5_commande_en_ligne_flux9" sourceRef="P5_commande_en_ligne_t6" targetRef="P5_commande_en_ligne_t7" />
