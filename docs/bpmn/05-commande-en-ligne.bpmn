<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="P5_commande_en_ligne_defs" targetNamespace="http://abatelier.local/bpmn">
  <bpmn:collaboration id="P5_commande_en_ligne_collab">
    <bpmn:participant id="P5_commande_en_ligne_pool" name="Commande payée en ligne (sur mesure ou boutique)" processRef="P5_commande_en_ligne" />
  </bpmn:collaboration>
  <bpmn:process id="P5_commande_en_ligne" name="Commande payée en ligne (sur mesure ou boutique)" isExecutable="false">
    <bpmn:documentation>Le client paie par carte avant que la commande n’existe : elle naît validée, avec une date estimée, sans intervention de l’atelier.</bpmn:documentation>
    <bpmn:laneSet id="P5_commande_en_ligne_voies">
      <bpmn:lane id="P5_commande_en_ligne_voie_client" name="Visiteur / Client">
        <bpmn:flowNodeRef>P5_commande_en_ligne_d</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_commande_en_ligne_t1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_commande_en_ligne_t3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_commande_en_ligne_t10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_commande_en_ligne_f3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P5_commande_en_ligne_voie_systeme" name="Application (automatique)">
        <bpmn:flowNodeRef>P5_commande_en_ligne_t2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_commande_en_ligne_t5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_commande_en_ligne_t6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_commande_en_ligne_t7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_commande_en_ligne_t9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_commande_en_ligne_f2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P5_commande_en_ligne_voie_paiement" name="Prestataire de paiement">
        <bpmn:flowNodeRef>P5_commande_en_ligne_t4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_commande_en_ligne_g1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="P5_commande_en_ligne_voie_atelier" name="Atelier">
        <bpmn:flowNodeRef>P5_commande_en_ligne_t8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>P5_commande_en_ligne_f1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="P5_commande_en_ligne_d" name="Le client a choisi sa pièce ou son panier"><bpmn:outgoing>P5_commande_en_ligne_flux1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="P5_commande_en_ligne_t1" name="Se connecter et lancer le paiement"><bpmn:documentation>Dans l’application : Compte nécessaire ; prix recalculé par le serveur, jamais envoyé par le navigateur</bpmn:documentation><bpmn:incoming>P5_commande_en_ligne_flux1</bpmn:incoming><bpmn:outgoing>P5_commande_en_ligne_flux2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P5_commande_en_ligne_t2" name="Figer le panier et ouvrir la page de paiement hébergée"><bpmn:documentation>Dans l’application : Aucune donnée de carte ne passe par l’application</bpmn:documentation><bpmn:incoming>P5_commande_en_ligne_flux2</bpmn:incoming><bpmn:outgoing>P5_commande_en_ligne_flux3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P5_commande_en_ligne_t3" name="Payer par carte sur la page du prestataire"><bpmn:documentation>Dans l’application : Authentification de la banque si elle la demande</bpmn:documentation><bpmn:incoming>P5_commande_en_ligne_flux3</bpmn:incoming><bpmn:outgoing>P5_commande_en_ligne_flux4</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P5_commande_en_ligne_t4" name="Contrôler et débiter la carte"><bpmn:documentation>En partie : Essayé avec le mode test de Stripe ; le compte du client se branche à la mise en service</bpmn:documentation><bpmn:incoming>P5_commande_en_ligne_flux4</bpmn:incoming><bpmn:outgoing>P5_commande_en_ligne_flux5</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="P5_commande_en_ligne_g1" name="Paiement accepté ?"><bpmn:incoming>P5_commande_en_ligne_flux5</bpmn:incoming><bpmn:outgoing>P5_commande_en_ligne_flux6</bpmn:outgoing><bpmn:outgoing>P5_commande_en_ligne_flux7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="P5_commande_en_ligne_t5" name="Recevoir la confirmation signée du prestataire"><bpmn:documentation>Dans l’application : Seule preuve du paiement ; une notification falsifiée ou rejouée est ignorée</bpmn:documentation><bpmn:incoming>P5_commande_en_ligne_flux6</bpmn:incoming><bpmn:outgoing>P5_commande_en_ligne_flux8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P5_commande_en_ligne_t6" name="Créer la commande déjà validée avec sa date estimée"><bpmn:documentation>Dans l’application : Elle n’existe qu’après le paiement</bpmn:documentation><bpmn:incoming>P5_commande_en_ligne_flux8</bpmn:incoming><bpmn:outgoing>P5_commande_en_ligne_flux9</bpmn:outgoing><bpmn:outgoing>P5_commande_en_ligne_flux12</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="P5_commande_en_ligne_t7" name="Envoyer la confirmation au client et l’alerte à la direction"><bpmn:documentation>Dans l’application : E-mails mis en page, sans publicité</bpmn:documentation><bpmn:incoming>P5_commande_en_ligne_flux9</bpmn:incoming><bpmn:outgoing>P5_commande_en_ligne_flux10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P5_commande_en_ligne_t8" name="Fabriquer (voir « Fabrication »)"><bpmn:documentation>Dans l’application : Arrive dans « À lancer »</bpmn:documentation><bpmn:incoming>P5_commande_en_ligne_flux10</bpmn:incoming><bpmn:outgoing>P5_commande_en_ligne_flux11</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="P5_commande_en_ligne_t9" name="Ne rien créer, garder le panier"><bpmn:documentation>Dans l’application : Message au retour sur le site : paiement annulé, aucune somme débitée</bpmn:documentation><bpmn:incoming>P5_commande_en_ligne_flux7</bpmn:incoming><bpmn:outgoing>P5_commande_en_ligne_flux14</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="P5_commande_en_ligne_t10" name="Suivre sa commande dans son espace"><bpmn:documentation>Dans l’application : Étapes, date estimée, paiement</bpmn:documentation><bpmn:incoming>P5_commande_en_ligne_flux12</bpmn:incoming><bpmn:outgoing>P5_commande_en_ligne_flux13</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="P5_commande_en_ligne_f1" name="Commande en fabrication"><bpmn:incoming>P5_commande_en_ligne_flux11</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P5_commande_en_ligne_f2" name="Aucune commande créée"><bpmn:incoming>P5_commande_en_ligne_flux14</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="P5_commande_en_ligne_f3" name="Client informé de chaque étape"><bpmn:incoming>P5_commande_en_ligne_flux13</bpmn:incoming></bpmn:endEvent>
